---
import GalleryItem from "./GalleryItem.astro";
import GalleryModal from "./GalleryModal.astro";
import worksData from "../data/works.json";

const { categories, items } = worksData;

// Build category data with first item's thumbnail
const catNav = categories
  .map((cat) => {
    const catItems = items.filter((i) => i.category === cat.id);
    const firstThumb = catItems[0]?.thumbnail?.replace("img/", "") ?? "";
    return { ...cat, firstThumb, count: catItems.length };
  })
  .filter((c) => c.count > 0);
---

<section class="gallery">
  <div class="gallery__layout">
    <!-- Sidebar: category switches -->
    <nav class="gallery__sidebar" aria-label="カテゴリ切替">
      <ul class="gallery__cat-list">
        {
          catNav.map((cat, i) => (
            <li>
              <button
                class:list={["gallery__cat-btn", { "is-active": i === 0 }]}
                data-filter={cat.id}
                type="button"
              >
                <img
                  class="gallery__cat-thumb"
                  src={`/images/works/${cat.firstThumb}`}
                  alt=""
                  loading="lazy"
                />
                <span class="gallery__cat-label">
                  <strong>{cat.label}</strong>
                  <small>{cat.labelEn}</small>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Main content -->
    <div class="gallery__main">
      {
        categories.map((cat, i) => {
          const catItems = items.filter((item) => item.category === cat.id);
          if (catItems.length === 0) return null;
          return (
            <div
              class:list={["gallery__section", { "is-hidden": i !== 0 }]}
              data-category={cat.id}
            >
              <h3 class="gallery__heading">
                {cat.label}
                <span>{cat.labelEn}</span>
              </h3>
              {/* 要望: 施工事例を一律4列グリッドで整然と並べる（上4・下4…）。
                  各アイテムの layout="grid-3" は表示画像にサムネイルを選ぶ指定。 */}
              <div class="gallery__grid gallery__grid--grid-4">
                {catItems.map((item) => (
                  <GalleryItem
                    title={item.title}
                    src={item.src}
                    thumbnail={item.thumbnail}
                    captionLines={item.captionLines}
                    category={item.category}
                    layout="grid-3"
                  />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <GalleryModal />
</section>

<style>
  .gallery {
    max-width: var(--width-max);
    margin: 0 auto;
    padding: var(--space-4);
  }

  /* Two-column layout */
  .gallery__layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  /* Sidebar */
  .gallery__sidebar {
    position: sticky;
    top: var(--space-4);
  }

  .gallery__cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .gallery__cat-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--easing-default),
      border-color var(--duration-fast) var(--easing-default),
      box-shadow var(--duration-fast) var(--easing-default);
  }

  .gallery__cat-btn:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .gallery__cat-btn.is-active {
    background: var(--color-bg-tertiary);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .gallery__cat-thumb {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .gallery__cat-label {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  .gallery__cat-label strong {
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .gallery__cat-label small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Main */
  .gallery__section {
    margin-bottom: var(--space-10);
    animation: fade-in 0.6s ease;
  }

  .gallery__section.is-hidden {
    display: none;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gallery__heading {
    display: flex;
    align-items: center;
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--color-primary);
    color: var(--color-text);
  }

  .gallery__heading span {
    margin-left: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-text-muted);
  }

  /* Grid */
  .gallery__grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .gallery__grid:last-child {
    margin-bottom: 0;
  }

  .gallery__grid--grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Desktop-down: 4 → 3 列 */
  @media (max-width: 1024px) {
    .gallery__grid--grid-4 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tablet: sidebar on top, 2-col cat-list / 4 → 2 列 */
  @media (max-width: 767px) {
    .gallery__layout {
      grid-template-columns: 1fr;
    }

    .gallery__sidebar {
      position: static;
    }

    .gallery__cat-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      padding-bottom: var(--space-2);
    }

    .gallery__grid--grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script is:inline src="/scripts/gallery.js"></script>
