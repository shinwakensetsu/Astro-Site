---
interface Props {
  controls?: boolean;
}

const { controls = false } = Astro.props;
---

<div class="accordion-wrapper">
  {
    controls && (
      <div class="accordion-controls">
        <button type="button" data-action="open-all">
          全て開く
        </button>
        <button type="button" data-action="close-all">
          全て閉じる
        </button>
      </div>
    )
  }

  <ul class="accordion">
    <slot />
  </ul>
</div>

<script>
  // ページ内のすべてのアコーディオンラッパーに対して処理を行う
  document.querySelectorAll(".accordion-wrapper").forEach((wrapper) => {
    const openBtn = wrapper.querySelector('[data-action="open-all"]');
    const closeBtn = wrapper.querySelector('[data-action="close-all"]');

    if (openBtn && closeBtn) {
      const details = wrapper.querySelectorAll("details");

      openBtn.addEventListener("click", () => {
        details.forEach((detail) => {
          detail.open = true;
        });
      });

      closeBtn.addEventListener("click", () => {
        details.forEach((detail) => {
          detail.open = false;
        });
      });
    }
  });
</script>

<style>
  .accordion-controls {
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }

  .accordion-controls button {
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: background-color var(--duration-fast) var(--easing-default);
  }

  .accordion-controls button:hover {
    background: var(--color-bg-secondary);
  }

  .accordion {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
