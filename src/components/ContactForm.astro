---
interface Props {
  action?: string; // 送信先URL（Formspreeなどが決まったら指定）
}

const { action = "#" } = Astro.props;
---

<form class="contact-form" action={action} method="POST" novalidate>
  <div class="form-group">
    <label for="name"
      >お名前 <span class="required" aria-hidden="true">*</span></label
    >
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      placeholder="山田 太郎"
      required
      aria-required="true"
      aria-describedby="error-name"
    />
    <p class="error-message" id="error-name" role="alert" aria-live="polite">
    </p>
  </div>

  <div class="form-group">
    <label for="email"
      >メールアドレス <span class="required" aria-hidden="true">*</span></label
    >
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      placeholder="example@email.com"
      required
      aria-required="true"
      aria-describedby="error-email"
    />
    <p class="error-message" id="error-email" role="alert" aria-live="polite">
    </p>
  </div>

  <div class="form-group">
    <label for="subject">件名</label>
    <input
      type="text"
      id="subject"
      name="subject"
      autocomplete="off"
      placeholder="お問い合わせの件名"
      aria-describedby="error-subject"
    />
    <p class="error-message" id="error-subject" role="alert" aria-live="polite">
    </p>
  </div>

  <div class="form-group">
    <label for="message"
      >お問い合わせ内容 <span class="required" aria-hidden="true">*</span
      ></label
    >
    <textarea
      id="message"
      name="message"
      autocomplete="off"
      rows="5"
      placeholder="ここにお問い合わせ内容を入力してください"
      required
      aria-required="true"
      aria-describedby="error-message"></textarea>
    <p class="error-message" id="error-message" role="alert" aria-live="polite">
    </p>
  </div>

  <div class="form-actions">
    <button type="submit" class="submit-btn">送信する</button>
  </div>
</form>

<script>
  import { contactSchema } from "../lib/contactSchema";

  const form = document.querySelector(".contact-form") as HTMLFormElement;

  if (form) {
    form.addEventListener("submit", (e) => {
      // エラーメッセージをリセット
      document.querySelectorAll(".error-message").forEach((el) => {
        el.textContent = "";
      });
      document.querySelectorAll(".has-error").forEach((el) => {
        el.classList.remove("has-error");
        el.removeAttribute("aria-invalid");
      });

      // フォームデータを取得
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // Zodでバリデーション
      const result = contactSchema.safeParse(data);

      if (!result.success) {
        // バリデーションエラーがある場合、送信をキャンセル
        e.preventDefault();

        // Track the first error field for focus
        let firstErrorField: HTMLElement | null = null;

        // エラーメッセージを表示
        result.error.issues.forEach((issue) => {
          const fieldName = issue.path[0];
          const errorEl = document.getElementById(`error-${fieldName}`);
          const inputEl = document.getElementById(
            `${fieldName}`,
          ) as HTMLElement;

          if (errorEl) {
            errorEl.textContent = issue.message;
          }
          if (inputEl) {
            inputEl.classList.add("has-error");
            inputEl.setAttribute("aria-invalid", "true");

            // Track first error field
            if (!firstErrorField) {
              firstErrorField = inputEl;
            }
          }
        });

        // Focus on the first error field for accessibility
        if (firstErrorField && "focus" in firstErrorField) {
          (firstErrorField as HTMLElement).focus();
        }
      }
      // バリデーション成功時はそのまま送信（action属性のURLへ）
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--width-description);
    margin: 0 auto;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-weight: var(--weight-bold);
  }

  .required {
    color: var(--color-error);
    margin-left: var(--space-1);
  }

  input,
  textarea {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-family: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-primary);
    border-color: transparent;
  }

  .has-error {
    border-color: var(--color-error);
    background-color: var(--color-error-bg);
  }

  .has-error:focus {
    outline-color: var(--color-error);
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--color-error);
    background-color: var(--color-error-bg);
  }

  .error-message {
    color: var(--color-error);
    font-size: var(--text-sm);
    margin: 0;
    min-height: 1.25em;
  }

  .error-message:not(:empty) {
    padding: var(--space-1) 0;
  }

  .submit-btn {
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--easing-default);
  }

  .submit-btn:hover {
    background-color: var(--color-primary-dark);
  }

  .submit-btn:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
