---
interface Props {
  title: string;
  src: string;
  thumbnail: string;
  captionLines?: string[];
  category: string;
  layout?: "single" | "grid-2" | "grid-3";
}

const {
  title,
  src,
  thumbnail,
  captionLines = [],
  category,
  layout = "grid-3",
} = Astro.props;
const srcFile = src.replace("img/", "");
const thumbFile = thumbnail.replace("img/", "");

const thumbPath = `/images/works/${thumbFile}`;
const fullPath = `/images/works/${srcFile}`;

// single/grid-2 レイアウトではフルサイズ画像を表示
const displayPath = layout === "grid-3" ? thumbPath : fullPath;

// モーダルへは物件名と各行を渡す（gallery.js が \n 分割して DOM 生成）
const captionData = captionLines.join("\n");
---

<button
  class:list={["gallery-item", `gallery-item--${layout}`]}
  data-src={fullPath}
  data-title={title}
  data-caption={captionData}
  data-category={category}
  type="button"
>
  <img
    src={displayPath}
    alt={title}
    loading="lazy"
    width="180"
    data-fallback={fullPath}
  />
  <span class="gallery-item__text">
    <span class="gallery-item__text-name">{title}</span>
    {
      captionLines.map((line) => (
        <span class="gallery-item__text-line">{line}</span>
      ))
    }
  </span>
</button>

<style>
  .gallery-item {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 5px;
    padding: var(--space-2);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--easing-default),
      border-color var(--duration-fast) var(--easing-default),
      box-shadow var(--duration-fast) var(--easing-default);
    height: 100%;
  }

  .gallery-item:hover,
  .gallery-item:focus-visible {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .gallery-item__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: var(--text-sm);
    line-height: 1.4;
    text-align: left;
    align-items: flex-start;
    color: var(--color-text-secondary);
  }

  .gallery-item__text-name {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .gallery-item__text-line {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Single (1-column) layout */
  .gallery-item--single {
    flex-direction: column;
    align-items: flex-start;
  }

  .gallery-item--single img {
    width: 100%;
  }
</style>
