---
const baseSlides = [
  { src: "/images/index/temple.jpg", alt: "伽藍" },
  { src: "/images/index/church.jpg", alt: "教会" },
  { src: "/images/index/repository.jpg", alt: "収蔵庫" },
  { src: "/images/index/belltower.jpg", alt: "鐘楼" },
  { src: "/images/index/shrine.jpg", alt: "神社" },
  { src: "/images/index/towers.jpg", alt: "塔" },
  { src: "/images/index/gate.jpg", alt: "門" },
];
// ループの折り返しで隙間が出ないよう2周分用意
const slides = [...baseSlides, ...baseSlides];
---

<div class="works-carousel" aria-label="施工事例カルーセル">
  <div class="works-carousel__viewport" data-works-viewport>
    <div class="works-carousel__container">
      {
        slides.map((slide) => (
          <div class="works-carousel__slide">
            <img
              class="works-carousel__image"
              src={slide.src}
              alt={slide.alt}
              width="400"
              height="540"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>

  <ul class="works-carousel__dots" data-works-dots aria-label="スライド選択">
    {
      baseSlides.map((slide, i) => (
        <li class="works-carousel__dots-item">
          <button
            class:list={["works-carousel__dot", { "is-active": i === 0 }]}
            type="button"
            aria-label={`${slide.alt}を表示`}
            data-dot-index={i}
          />
        </li>
      ))
    }
  </ul>
</div>

<script>
  import EmblaCarousel from "embla-carousel";
  import AutoScroll from "embla-carousel-auto-scroll";

  const viewport = document.querySelector<HTMLElement>("[data-works-viewport]");
  const dotsContainer =
    document.querySelector<HTMLElement>("[data-works-dots]");

  if (viewport && dotsContainer) {
    const BASE_COUNT = 7;
    const dots =
      dotsContainer.querySelectorAll<HTMLButtonElement>("[data-dot-index]");

    const embla = EmblaCarousel(
      viewport,
      {
        loop: true,
        dragFree: true,
        containScroll: false,
        align: "start",
      },
      [
        AutoScroll({
          speed: 1,
          startDelay: 0,
          stopOnInteraction: false,
          stopOnMouseEnter: true,
        }),
      ],
    );

    function updateDots() {
      const selected = embla.selectedScrollSnap() % BASE_COUNT;
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === selected);
      });
    }

    embla.on("select", updateDots);
    embla.on("init", updateDots);

    const autoScroll = embla.plugins().autoScroll;

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.dotIndex);
        embla.scrollTo(index);
      });

      dot.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          const index = Number(dot.dataset.dotIndex);
          embla.scrollTo(index);
        }
      });

      dot.addEventListener("focus", () => {
        autoScroll?.stop();
      });

      dot.addEventListener("blur", () => {
        autoScroll?.play();
      });
    });
  }
</script>

<style>
  .works-carousel {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-6);
    background-color: #1f1f1f;
  }

  .works-carousel__viewport {
    overflow: hidden;
    cursor: grab;
  }

  .works-carousel__viewport:active {
    cursor: grabbing;
  }

  .works-carousel__container {
    display: flex;
  }

  .works-carousel__slide {
    flex: 0 0 auto;
    min-width: 0;
    width: clamp(260px, 28vw, 400px);
    padding-right: var(--space-4);
  }

  .works-carousel__image {
    display: block;
    width: 100%;
    height: clamp(360px, 38vw, 540px);
    object-fit: cover;
    border-radius: 24px 0 24px 24px;
  }

  @media (max-width: 768px) {
    .works-carousel__slide {
      width: clamp(200px, 55vw, 300px);
    }

    .works-carousel__image {
      height: clamp(280px, 65vw, 420px);
      border-radius: 18px 0 18px 18px;
    }
  }

  @media (max-width: 425px) {
    .works-carousel {
      padding-top: var(--space-4);
    }

    .works-carousel__image {
      border-radius: 14px 0 14px 14px;
    }
  }

  /* ---------- Pagination Dots ---------- */
  .works-carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding-block: var(--space-6);
    flex: 1;
  }

  .works-carousel__dots-item {
    line-height: 0;
  }

  .works-carousel__dot {
    width: 10px;
    height: 10px;
    margin: 2px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: #5c5c5c;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--easing-default);
  }

  .works-carousel__dot.is-active {
    background-color: #ffffff;
  }
</style>
