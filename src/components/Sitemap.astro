---
import { sitemapColumns } from "../data/sitemap";

interface Props {
  variant?: "drawer" | "footer";
  ariaLabel?: string;
}

const { variant = "drawer", ariaLabel = "サイトマップ" } = Astro.props;
const headingTag = variant === "footer" ? "h3" : "h2";
---

<nav class={`sitemap sitemap--${variant}`} aria-label={ariaLabel}>
  {
    sitemapColumns.map((column) => (
      <div class="sitemap__col">
        {column.sections.map((section) => {
          const HeadingTag = headingTag;

          return (
            <section class="sitemap__section">
              <HeadingTag class="sitemap__heading">
                <a href={section.heading.href}>{section.heading.label}</a>
              </HeadingTag>

              {section.links && section.links.length > 0 && (
                <ul class="sitemap__list">
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })}
      </div>
    ))
  }
</nav>

<style>
  /* --- 共通 --- */
  .sitemap {
    display: grid;
  }

  .sitemap__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    line-height: 2;
    min-width: 0;
  }

  .sitemap__section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .sitemap__heading {
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: var(--weight-bold);
  }

  .sitemap__heading a,
  .sitemap__list a {
    color: var(--color-gray-900);
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .sitemap__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .sitemap__list a {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: var(--weight-normal);
  }

  /* --- ドロワー --- */
  .sitemap--drawer {
    /*
     * auto-fill + minmax で BP なしにカラムを自律的に調整する。
     * min(100%, 220px) により極小コンテナでもはみ出さない。
     * 3カラムに必要な幅: 220px × 3 + gap × 2 ≈ 708px
     * → コンテナが 708px を下回ると自動で 2 カラムへ縮退
     * → 2カラムに必要な幅: 220px × 2 + gap ≈ 455px
     * → それ以下で 1 カラムへ縮退
     */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    max-width: none;
  }

  .sitemap--drawer .sitemap__heading a,
  .sitemap--drawer .sitemap__list a {
    overflow-wrap: break-word;
  }

  /* 安全網: 768px 以下では確実に 2 カラム上限 */
  @media (max-width: 768px) {
    .sitemap--drawer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 安全網: 320px 以下では 1 カラム */
  @media (max-width: 320px) {
    .sitemap--drawer {
      grid-template-columns: 1fr;
    }
  }

  /* --- フッター --- */
  .sitemap--footer {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 700px;
    gap: 10px;
  }

  .sitemap--footer .sitemap__heading a,
  .sitemap--footer .sitemap__list a {
    color: var(--color-text);
  }

  @media (min-width: 1441px) {
    .sitemap--footer {
      min-width: clamp(0px, 48vw, 700px);
    }
  }

  @media (max-width: 425px) {
    .sitemap--footer {
      grid-template-columns: 1fr;
    }

    .sitemap--footer .sitemap__list a {
      font-size: 1.125rem;
    }
  }
</style>
