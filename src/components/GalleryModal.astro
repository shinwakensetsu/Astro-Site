---
/* GalleryModal: a single <dialog> reused for all gallery items */
---

<dialog id="gallery-modal" class="gallery-modal">
  <div class="gallery-modal__inner">
    <button class="gallery-modal__close" type="button" aria-label="閉じる"
      >&times;</button
    >
    <figure class="gallery-modal__figure">
      <div class="gallery-modal__img-wrap">
        <img class="gallery-modal__img" src="" alt="" />
      </div>
      <figcaption class="gallery-modal__caption"></figcaption>
    </figure>
  </div>
</dialog>

<style>
  /* Dialog open/close animation */
  .gallery-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: min(90vw, 900px);
    max-height: 90vh;
    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity var(--duration-slow) ease,
      transform var(--duration-slow) ease,
      display var(--duration-slow) ease allow-discrete;
  }

  .gallery-modal[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .gallery-modal[open] {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  .gallery-modal::backdrop {
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    transition:
      background var(--duration-slow) ease,
      backdrop-filter var(--duration-slow) ease,
      display var(--duration-slow) ease allow-discrete;
  }

  .gallery-modal[open]::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  @starting-style {
    .gallery-modal[open]::backdrop {
      background: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
    }
  }

  .gallery-modal__inner {
    position: relative;
    background: var(--color-bg);
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }

  .gallery-modal__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: var(--color-white);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
    transition: background var(--duration-fast) var(--easing-default);
  }

  .gallery-modal__close:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .gallery-modal__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .gallery-modal__figure.is-loading {
    visibility: hidden;
    height: 0;
    overflow: hidden;
  }

  .gallery-modal__img-wrap {
    background: var(--color-bg-secondary);
    padding: 5px;
    margin: 0;
    line-height: 0;
  }

  .gallery-modal__img {
    display: block;
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    margin: 0 auto;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .gallery-modal__img.is-loaded {
    opacity: 1;
  }

  .gallery-modal__caption {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    text-align: center;
  }
</style>
