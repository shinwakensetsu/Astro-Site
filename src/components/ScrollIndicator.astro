---
/**
 * ScrollIndicator — ヒーロー下部のスクロール促進アイコン
 *
 * 使い方: grid親の中に置き、grid-area: 1/1 で重ねる。
 * 配置調整は --scroll-indicator-bottom で行う。
 */
---

<div class="scroll-indicator" aria-hidden="true">
  <svg
    class="scroll-indicator__svg"
    viewBox="0 0 33 65"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    {/* テキスト "SCROLL HERE"（静的） */}
    <path
      class="scroll-indicator__text"
      d="M15.74 58.9702L12.08 58.8102L12.08 58.0902C13.12 57.9702 13.66 57.8102 14.18 57.4902C15.04 56.9302 15.44 56.2302 15.44 55.2502C15.44 54.0302 14.8 53.2902 13.7 53.2902C12.72 53.2902 12.28 53.8102 11.2 56.1302C10.68 57.3102 10.36 57.8102 9.84 58.2902C9.34 58.7702 8.76 58.9902 8.04 58.9902C6.1 58.9902 4.86 57.5502 4.86 55.2902C4.86 54.9702 4.92 54.4502 5.02 53.8702C5.12 53.3102 5.14 53.2102 5.14 52.9902C5.14 52.7102 5.1 52.4902 4.94 52.0302L8.44 52.2102L8.44 52.9502C6.4 53.0902 5.32 53.9302 5.32 55.3702C5.32 56.4502 5.98 57.1502 6.98 57.1502C7.5 57.1502 7.86 56.9702 8.2 56.5302C8.54 56.0902 8.54 56.0902 9.36 54.2902C10.3 52.2502 11.08 51.5902 12.58 51.5902C14.66 51.5902 15.92 52.9302 15.92 55.1902C15.92 55.7702 15.88 56.0502 15.68 57.2302C15.64 57.4702 15.62 57.7102 15.62 57.9502C15.62 58.2502 15.62 58.3102 15.74 58.9702ZM12.78 40.6376L13.12 40.1176C14.98 41.0176 15.92 42.4976 15.92 44.4976C15.92 47.5776 13.74 49.6376 10.52 49.6376C8.8 49.6376 7.24 49.0576 6.2 48.0576C5.34 47.1776 4.86 45.9376 4.86 44.4976C4.86 42.2776 6.06 40.3776 7.48 40.3776C8.08 40.3776 8.46 40.9176 8.46 41.7376C8.46 42.1976 8.32 42.5776 8.1 42.7576C7.94 42.8776 7.94 42.8776 7.22 42.9176C6.02 42.9976 5.34 43.5776 5.34 44.5576C5.34 45.3776 5.84 46.0776 6.62 46.3976C7.5 46.7376 8.92 46.9576 10.16 46.9576C11.46 46.9576 12.64 46.7176 13.56 46.2576C14.58 45.7376 15.14 44.8976 15.14 43.8776C15.14 42.4976 14.26 41.3176 12.78 40.6376ZM5.16 39.0187L4.9 35.2587C5.66 35.2187 6.12 35.1987 6.52 35.1987C6.66 35.1987 6.86 35.1987 7.12 35.1987C5.64 34.3987 4.86 33.3787 4.86 32.2387C4.86 31.2587 5.52 30.5387 6.38 30.5387C7.1 30.5387 7.6 31.1387 7.6 31.9787C7.6 32.5187 7.42 32.7787 6.96 32.9187C6.4 33.0787 6.26 33.1787 6.26 33.4987C6.26 33.4987 6.26 33.5187 6.26 33.5387C6.28 33.9187 6.62 34.3187 7.2 34.6587C7.8 34.9787 8.48 35.1387 9.42 35.1387L13.12 35.1387C14.92 35.1387 15.06 35.0187 15.12 33.5387L15.6 33.5387L15.6 39.0987L15.12 39.0987C15.1 37.7187 14.9 37.5787 13.12 37.5787L7.58 37.5787C5.88 37.5787 5.64 37.7587 5.64 39.0187L5.16 39.0187ZM10.46 29.6771C8.82 29.6771 7.28 29.1171 6.28 28.1771C5.38 27.3171 4.86 25.9571 4.86 24.4371C4.86 21.2971 7.02 19.2571 10.34 19.2571C11.9 19.2571 13.38 19.7571 14.3 20.5771C15.32 21.4971 15.92 22.9571 15.92 24.5371C15.92 26.0371 15.34 27.4571 14.4 28.2971C13.42 29.1771 12 29.6771 10.46 29.6771ZM10.36 26.9771C13.82 26.9771 15.46 26.1771 15.46 24.4571C15.46 22.7171 13.9 21.9371 10.42 21.9371C6.92 21.9371 5.32 22.7371 5.32 24.4771C5.32 25.2971 5.74 25.9971 6.48 26.3371C7.34 26.7771 8.62 26.9771 10.36 26.9771ZM15.6 17.8282L15.12 17.8282C15.08 16.3682 14.94 16.2482 13.12 16.2482L3.04 16.2482C1.28 16.2482 1.1 16.3882 1.1 17.8082L0.639998 17.8082L0.419997 13.6882C1.9 13.7682 3.18 13.8082 4.52 13.8082L13.12 13.8082C14.94 13.8082 15.08 13.6882 15.12 12.2282L15.6 12.2282L15.6 17.8282ZM15.6 11.129L15.12 11.129C15.08 9.66898 14.94 9.54898 13.12 9.54898L3.04 9.54898C1.28 9.54898 1.1 9.68898 1.1 11.109L0.639998 11.109L0.419997 6.98898C1.9 7.06898 3.18 7.10898 4.52 7.10898L13.12 7.10898C14.94 7.10898 15.08 6.98898 15.12 5.52898L15.6 5.52898L15.6 11.129Z"
      fill="white"></path>
    {/* 矢印（アニメーション対象） */}
    <path
      class="scroll-indicator__arrow"
      d="M20.0001 6V59L31.0001 52.2939"
      stroke="white"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</div>

<script>
  const indicator = document.querySelector(".scroll-indicator");
  if (indicator) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          indicator.classList.add("is-hidden");
        } else {
          indicator.classList.remove("is-hidden");
        }
      },
      { threshold: 0 },
    );
    observer.observe(indicator);

    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY > 100) {
          indicator.classList.add("is-hidden");
        } else {
          indicator.classList.remove("is-hidden");
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .scroll-indicator {
    --scroll-indicator-bottom: 2rem; /* ← 下辺からの距離。ここで調整 */

    grid-area: 1 / 1;
    align-self: end;
    justify-self: center;
    margin-bottom: var(--scroll-indicator-bottom);
    z-index: 2;
    pointer-events: none;

    transition: opacity 0.6s ease;
  }

  .scroll-indicator.is-hidden {
    opacity: 0;
  }

  .scroll-indicator__svg {
    display: block;
    width: clamp(1.5rem, 2.5vw, 2.0625rem);
    height: auto;
  }

  .scroll-indicator__arrow {
    animation: arrow-bounce 2s ease-in-out infinite;
  }

  @keyframes arrow-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator__arrow {
      animation: none;
    }
  }

  /* 1024px以下: 非表示 */
  @media (max-width: 1024px) {
    .scroll-indicator {
      display: none;
    }
  }
</style>
