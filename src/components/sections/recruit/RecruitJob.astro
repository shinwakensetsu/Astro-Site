---
import BeltHeader from "../../BeltHeader.astro";

interface SliderCard {
  label: string;
}

interface Props {
  id: string;
  modifier: "supervisor" | "carpenter";
  decoLabel: string;
  titleHtml: string;
  profilePhotoLabel?: string;
  profileRole: string;
  profileName: string;
  videoLabel?: string;
  quoteHtml: string;
  messageHtml: string;
  sliderCards: SliderCard[];
  featurePhotoHtml: string;
}

const {
  id,
  modifier,
  decoLabel,
  titleHtml,
  profilePhotoLabel,
  profileRole,
  profileName,
  videoLabel,
  quoteHtml,
  messageHtml,
  sliderCards,
  featurePhotoHtml,
} = Astro.props;
---

<section
  id={id}
  class:list={["recruit-job", `recruit-job--${modifier}`, "u-bg-primary-light"]}
>
  <div class="recruit-job__deco-band" aria-hidden="true">
    <BeltHeader />
  </div>
  <div class="l-container recruit-job__inner">
    <div class="recruit-job__deco-label-wrap" aria-hidden="true">
      <span class="recruit-job__deco-label">{decoLabel}</span>
    </div>
    <h2 class="recruit-job__title" set:html={titleHtml} />

    <div class="recruit-job__profile">
      <div class="recruit-job__profile-photo" aria-hidden={!profilePhotoLabel}>
        {
          profilePhotoLabel && (
            <span class="recruit-job__profile-photo-label">
              {profilePhotoLabel}
            </span>
          )
        }
      </div>
      <div class="recruit-job__profile-info">
        <p class="recruit-job__profile-role">{profileRole}</p>
        <p class="recruit-job__profile-name">{profileName}</p>
      </div>
    </div>
    <div class="recruit-job__content">
      <div class="recruit-job__video">
        <div
          class="recruit-job__video-placeholder"
          aria-label="インタビュー動画"
        >
          {
            videoLabel && (
              <span class="recruit-job__video-label">{videoLabel}</span>
            )
          }
        </div>
      </div>

      <div class="recruit-job__quote">
        <p class="recruit-job__quote-text" set:html={quoteHtml} />
      </div>

      <div class="recruit-job__message" set:html={messageHtml} />
    </div>

    <div class="recruit-job__slider-wrap" tabindex="0">
      <div class="recruit-job__slider-list">
        {
          sliderCards.map((card) => (
            <div class="recruit-job__slider-card">
              <span class="recruit-job__slider-card-label">{card.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="recruit-job__feature-photo">
      <span
        class="recruit-job__feature-photo-label"
        set:html={featurePhotoHtml}
      />
    </div>
  </div>
</section>

<style>
  /* ===== 4. 職種紹介（recruit-job） ===== */
  /* Figma: node 58:23316, 1920×3200
     1カラムレイアウト（サイドバーは別フェーズ）。
     スライダー写真は後日実装。 */

  .recruit-job {
    position: relative;
    overflow: hidden;
  }

  /* --- 装飾帯（伝統工法パターン） --- */
  /* Figma: 1920×100, fill #5C5C5C op0.8 */
  .recruit-job__deco-band {
    background-color: var(--color-gray-500);
    opacity: 0.8;
  }

  .recruit-job__deco-band > :global(.belt-header) {
    background-color: #767676;
  }

  /* --- 縦書きラベル --- */
  /* Figma: 96px W6, white, vertical-rl, 147×431 */
  .recruit-job__deco-label-wrap {
    position: absolute;
    top: var(--space-10);
    right: var(--space-10);
  }

  .recruit-job__deco-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-serif);
    font-size: var(--fs-1000);
    font-weight: var(--weight-semibold);
    line-height: 1;
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .recruit-job__deco-label-wrap {
      display: none;
    }
  }

  /* --- コンテンツ内側 --- */
  .recruit-job__inner {
    position: relative;
    padding-block: var(--space-10) var(--space-16);
    padding-inline: var(--space-10);
  }

  /* --- タイトル --- */
  /* Figma: 36px W6, lh 45px, black, center */
  .recruit-job__title {
    font-family: var(--font-serif);
    font-size: var(--fs-700);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--color-black);
    text-align: center;
    margin: 0 0 var(--space-10);
  }

  /* --- プロフィール --- */
  .recruit-job__profile {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-20);
  }

  /* Figma: 350×500, bg #4B4B4B, border 1px white, r 30px */
  .recruit-job__profile-photo {
    width: min(100%, 21.875rem);
    aspect-ratio: 350 / 500;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-white);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
  }

  /* Figma: Inter/Noto Sans JP 24px 400, white, center */
  .recruit-job__profile-photo-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1;
  }

  /* Figma: Hiragino Mincho W3, 18px, black, center */
  .recruit-job__profile-info {
    text-align: center;
  }

  .recruit-job__profile-role,
  .recruit-job__profile-name {
    font-family: var(--font-serif);
    font-size: var(--fs-200);
    font-weight: var(--weight-normal);
    color: var(--color-black);
    line-height: 1.5;
    margin: 0;
  }

  /* --- コンテンツ揃え（video / quote / message 左端基準） --- */
  .recruit-job__content {
    max-width: 75rem;
    margin-inline: auto;
  }

  /* --- 動画エリア --- */
  /* Figma: 1200×600, bg white, border 1px black, r 30px */
  .recruit-job__video {
    margin-bottom: var(--space-10);
    display: grid;
    justify-content: center;
  }

  .recruit-job__video-placeholder {
    aspect-ratio: 1200 / 600;
    background-color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    place-self: center;
    width: clamp(62.5vw, calc(340px + 300 * ((100vw - 425px) / 599)), 80vw);
    max-width: 1200px;
  }

  /* Figma: Inter 20px 400, #fd0000 */
  .recruit-job__video-label {
    font-family: "Inter", sans-serif;
    font-size: var(--fs-350);
    font-weight: var(--weight-normal);
    color: #fd0000;
    line-height: 1.3;
  }

  /* --- 引用テキスト --- */
  /* Figma: 1000×110, 30px W6, lh 36px, black */
  .recruit-job__quote {
    max-width: 62.5rem;
    margin-bottom: var(--space-10);
  }

  .recruit-job__quote-text {
    font-family: var(--font-serif);
    font-size: var(--fs-500);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-black);
    margin: 0;
  }

  /* --- 本文テキスト --- */
  /* Figma: 914×243, 20px W6, black */
  .recruit-job__message {
    max-width: 57.125rem;
    font-family: var(--font-serif);
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    line-height: 1.75;
    color: var(--color-black);
    margin-left: 3.6vw; /* 動画と引用の左端からずらす（Figmaのガイドラインに基づく） */
    position: relative;
  }

  .recruit-job__message :global(p) {
    margin: 0 0 var(--space-6);
  }

  .recruit-job__message :global(p:last-child) {
    margin-bottom: 0;
  }

  /* --- スライダー（Rectangle 62, 65） --- */
  /* Figma: 600×500 cards, bg #4B4B4B, border 1px black, r 30px, gap 10px */
  .recruit-job__slider-wrap {
    --recruit-slider-card-width: clamp(15rem, calc(8.5rem + 32vw), 37.5rem);
    --recruit-slider-gap: 0.625rem;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    margin-top: var(--space-10);
  }

  .recruit-job__slider-wrap::-webkit-scrollbar {
    display: none;
  }

  .recruit-job__slider-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--recruit-slider-card-width);
    gap: var(--recruit-slider-gap);
    min-width: max-content;
    margin: 0;
    padding: 0;
  }

  .recruit-job__slider-card {
    aspect-ratio: 6 / 5;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .recruit-job__slider-card-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1;
    text-shadow: none;
  }

  /* --- 特集写真（Rectangle 90） --- */
  /* Figma: 1210×500, bg #4B4B4B, border 1px black, r 30px */
  .recruit-job__feature-photo {
    margin-top: var(--space-10);
    margin-inline: auto;
    width: 100%;
    max-width: 75.625rem;
    aspect-ratio: 1210 / 500;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
  }

  .recruit-job__feature-photo-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1.5;
  }
</style>
