---
import BeltHeader from "../../BeltHeader.astro";

interface SliderCard {
  imageSrc: string;
}

interface Props {
  id: string;
  modifier: "supervisor" | "carpenter";
  decoLabel: string;
  titleHtml: string;
  profilePhotoSrc: string;
  profileText: string;
  quoteHtml: string;
  messageHtml: string;
  sliderCards: SliderCard[];
  featurePhotoTitle: string;
  featurePhotoSrc: string;
  featurePhotoAlt: string;
  featurePhotoWidth: number;
  featurePhotoHeight: number;
}

const {
  id,
  modifier,
  decoLabel,
  titleHtml,
  profilePhotoSrc,
  profileText,
  quoteHtml,
  messageHtml,
  sliderCards,
  featurePhotoTitle,
  featurePhotoSrc,
  featurePhotoAlt,
  featurePhotoWidth,
  featurePhotoHeight,
} = Astro.props;
---

<section
  id={id}
  class:list={["recruit-job", `recruit-job--${modifier}`, "u-bg-primary-light"]}
>
  <div class="recruit-job__deco-band" aria-hidden="true">
    <BeltHeader />
  </div>
  <div class="l-container recruit-job__inner">
    <div class="recruit-job__deco-label-wrap" aria-hidden="true">
      <span class="recruit-job__deco-label">{decoLabel}</span>
    </div>
    <h2 class="recruit-job__title" set:html={titleHtml} />

    <div class="recruit-job__profile">
      <div
        class:list={[
          "recruit-job__profile-photo",
          "recruit-job__profile-photo--image",
        ]}
        style={`--recruit-job-profile-image: url("${profilePhotoSrc}")`}
        aria-hidden="true"
      >
      </div>
      <div class="recruit-job__profile-info">
        <p class="recruit-job__profile-text">{profileText}</p>
      </div>
    </div>
    <div class="recruit-job__content">
      <div class="recruit-job__quote">
        <p class="recruit-job__quote-text" set:html={quoteHtml} />
      </div>

      <div class="recruit-job__message" set:html={messageHtml} />
    </div>

    <div class="recruit-job__slider-wrap" tabindex="0">
      <div class="recruit-job__slider-list">
        {
          sliderCards.map((card) => (
            <div
              class="recruit-job__slider-card recruit-job__slider-card--image"
              style={`--recruit-job-slider-image: url("${card.imageSrc}")`}
              aria-hidden="true"
            />
          ))
        }
        {
          /* マーキー無限ループ用の複製セット（装飾のため aria-hidden）。
             prefers-reduced-motion 時は display:none で非表示にし手動スクロールへ戻す。 */
          sliderCards.map((card) => (
            <div
              class="recruit-job__slider-card recruit-job__slider-card--image recruit-job__slider-card--clone"
              style={`--recruit-job-slider-image: url("${card.imageSrc}")`}
              aria-hidden="true"
            />
          ))
        }
      </div>
    </div>

    <div class="recruit-job__feature-photo">
      <h3 class="recruit-job__feature-photo-title">{featurePhotoTitle}</h3>
      <button
        class="recruit-job__feature-photo-button js-schedule-zoom"
        type="button"
        data-zoom-target={`${id}-schedule-modal`}
        aria-label={`${featurePhotoTitle}を拡大表示する`}
      >
        <img
          class="recruit-job__feature-photo-image"
          src={featurePhotoSrc}
          alt={featurePhotoAlt}
          width={featurePhotoWidth}
          height={featurePhotoHeight}
          loading="lazy"
          decoding="async"
        />
        <span class="recruit-job__feature-photo-hint" aria-hidden="true">
          クリックで拡大
        </span>
      </button>
    </div>

    <dialog id={`${id}-schedule-modal`} class="recruit-job__modal">
      <div class="recruit-job__modal-inner">
        <button
          class="recruit-job__modal-close"
          type="button"
          aria-label="閉じる">&times;</button
        >
        <img
          class="recruit-job__modal-image"
          src={featurePhotoSrc}
          alt={featurePhotoAlt}
          width={featurePhotoWidth}
          height={featurePhotoHeight}
        />
      </div>
    </dialog>
  </div>
</section>

<style>
  /* ===== 4. 職種紹介（recruit-job） ===== */
  /* Figma: node 58:23316, 1920×3200
     1カラムレイアウト（サイドバーは別フェーズ）。
     スライダー写真は後日実装。 */

  .recruit-job {
    position: relative;
    overflow: hidden;
  }

  /* --- 装飾帯（伝統工法パターン） --- */
  /* Figma: 1920×100, fill #5C5C5C op0.8 */
  .recruit-job__deco-band {
    background-color: var(--color-gray-500);
    opacity: 0.8;
  }

  .recruit-job__deco-band > :global(.belt-header) {
    background-color: #767676;
  }

  /* --- 縦書きラベル --- */
  /* Figma: 96px W6, white, vertical-rl, 147×431 */
  .recruit-job__deco-label-wrap {
    position: absolute;
    top: var(--space-10);
    right: var(--space-10);
  }

  .recruit-job__deco-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-serif);
    font-size: var(--fs-1000);
    font-weight: var(--weight-semibold);
    line-height: 1;
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .recruit-job__deco-label-wrap {
      display: none;
    }
  }

  /* --- コンテンツ内側 --- */
  .recruit-job__inner {
    position: relative;
    padding-block: var(--space-10) var(--space-16);
    padding-inline: var(--space-10);
  }

  /* --- タイトル --- */
  /* Figma: 36px W6, lh 45px, black, center */
  .recruit-job__title {
    font-family: var(--font-serif);
    font-size: var(--fs-700);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--color-black);
    text-align: center;
    margin: 0 0 var(--space-10);
  }

  /* --- プロフィール --- */
  .recruit-job__profile {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    margin-bottom: 50px;
  }

  /* Figma: 350×500, bg #4B4B4B, border 1px white, r 30px */
  .recruit-job__profile-photo {
    width: min(100%, 21.875rem);
    aspect-ratio: 350 / 500;
    background-color: var(--color-gray-700);
    border: 4px solid var(--color-white);
    border-radius: var(--radius-2xl);
    box-sizing: border-box;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .recruit-job__profile-photo--image {
    background-image: var(--recruit-job-profile-image);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  /* Figma: Hiragino Mincho W3, 18px, black, center */
  .recruit-job__profile-info {
    text-align: center;
  }

  .recruit-job__profile-text {
    font-family: var(--font-serif);
    font-size: var(--fs-200);
    font-weight: var(--weight-normal);
    color: var(--color-black);
    line-height: 1.5;
    margin: 0;
  }

  /* --- コンテンツ揃え（quote / message 左端基準） --- */
  .recruit-job__content {
    max-width: 75rem;
    margin-inline: auto;
  }

  /* --- 引用テキスト --- */
  /* Figma: 1000×110, 30px W6, lh 36px, black */
  .recruit-job__quote {
    max-width: 62.5rem;
    margin-bottom: var(--space-10);
  }

  .recruit-job__quote-text {
    font-family: var(--font-serif);
    font-size: var(--fs-500);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-black);
    margin: 0;
  }

  /* --- 本文テキスト --- */
  /* Figma: 914×243, 20px W6, black */
  .recruit-job__message {
    max-width: 57.125rem;
    font-family: var(--font-serif);
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    line-height: 1.75;
    color: var(--color-black);
    margin-left: 3.6vw; /* 引用の左端からずらす（Figmaのガイドラインに基づく） */
    position: relative;
  }

  .recruit-job__message :global(p) {
    margin: 0 0 var(--space-6);
  }

  .recruit-job__message :global(p:last-child) {
    margin-bottom: 0;
  }

  .recruit-job__message :global(.recruit-job__message-accent) {
    color: var(--color-primary);
    font-size: 1.2em;
  }

  /* --- スライダー（Rectangle 62, 65） --- */
  /* Figma: 600×500 cards, bg #4B4B4B, border 1px black, r 30px, gap 10px */
  .recruit-job__slider-wrap {
    --recruit-slider-card-width: clamp(15rem, calc(8.5rem + 32vw), 37.5rem);
    --recruit-slider-gap: 0.625rem;
    /* マーキー一周の所要時間。「ゆっくり右→左」。要望に応じて微調整可 */
    --recruit-slider-duration: 40s;
    width: 100%;
    overflow: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-top: 65px;
  }

  .recruit-job__slider-wrap::-webkit-scrollbar {
    display: none;
  }

  .recruit-job__slider-list {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    /* 複製セットを並べ、半分（=1セット分）移動でシームレスに無限ループ */
    animation: recruit-job-slide-left var(--recruit-slider-duration) linear
      infinite;
  }

  /* ホバー / キーボードフォーカス中は流れを止めて見やすくする */
  .recruit-job__slider-wrap:hover .recruit-job__slider-list,
  .recruit-job__slider-wrap:focus-within .recruit-job__slider-list {
    animation-play-state: paused;
  }

  .recruit-job__slider-card {
    flex: 0 0 var(--recruit-slider-card-width);
    margin-inline-end: var(--recruit-slider-gap);
    aspect-ratio: 6 / 5;
    background-color: var(--color-gray-700);
    border: 4px solid var(--color-white);
    border-radius: var(--radius-2xl);
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-width: 0;
    overflow: hidden;
  }

  .recruit-job__slider-card--image {
    background-image: var(--recruit-job-slider-image);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  @keyframes recruit-job-slide-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* モーション抑制時は自動再生を止め、複製を隠して手動スクロールに戻す */
  @media (prefers-reduced-motion: reduce) {
    .recruit-job__slider-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }

    .recruit-job__slider-list {
      animation: none;
    }

    .recruit-job__slider-card--clone {
      display: none;
    }
  }

  /* --- 1日のスケジュール --- */
  .recruit-job__feature-photo {
    margin-top: var(--space-10);
    margin-inline: auto;
    width: 100%;
    display: grid;
    justify-items: start;
    row-gap: var(--space-6);
  }

  .recruit-job__feature-photo-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.875rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: left;
    line-height: 1.5;
  }

  /* 画像をクリック拡大できるボタン化。寸法はボタン側へ移し画像は内側で100% */
  .recruit-job__feature-photo-button {
    justify-self: center;
    width: min(90%, 75.625rem);
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    position: relative;
  }

  .recruit-job__feature-photo-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 拡大ヒント（装飾）。画像隅に浮かせるバッジのため position:absolute を使用 */
  .recruit-job__feature-photo-hint {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0.35em 0.85em;
    font-size: var(--fs-100);
    color: var(--color-white);
    background: rgba(0, 0, 0, 0.55);
    border-radius: var(--radius-full);
    pointer-events: none;
  }

  .recruit-job__feature-photo-button:hover .recruit-job__feature-photo-hint,
  .recruit-job__feature-photo-button:focus-visible
    .recruit-job__feature-photo-hint {
    background: rgba(0, 0, 0, 0.78);
  }

  /* --- スケジュール拡大モーダル（ネイティブ dialog） --- */
  .recruit-job__modal {
    width: min(95vw, 75rem);
    max-width: 95vw;
    max-height: 95vh;
    padding: 0;
    border: none;
    background: transparent;
  }

  .recruit-job__modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .recruit-job__modal-inner {
    position: relative;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .recruit-job__modal-image {
    display: block;
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
    margin: 0 auto;
  }

  /* モーダル隅に浮かせる閉じるボタンのため position:absolute を使用 */
  .recruit-job__modal-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.55);
    color: var(--color-white);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .recruit-job__modal-close:hover {
    background: rgba(0, 0, 0, 0.78);
  }
</style>

<script>
  // スケジュール画像のクリック拡大。RecruitJob が複数回使われても
  // Astro が <script> を 1 度だけバンドルするため document 全体で一括初期化する。
  function initScheduleZoom() {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>(".js-schedule-zoom");
    buttons.forEach((btn) => {
      const targetId = btn.dataset.zoomTarget;
      if (!targetId) return;
      const dialog = document.getElementById(targetId);
      if (!(dialog instanceof HTMLDialogElement)) return;

      btn.addEventListener("click", () => dialog.showModal());

      const closeBtn = dialog.querySelector(".recruit-job__modal-close");
      closeBtn?.addEventListener("click", () => dialog.close());

      // backdrop（dialog 自身）クリックで閉じる
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  initScheduleZoom();
</script>
