---
interface Props {
  rows: {
    label: string;
    valueLines: string[];
  }[];
}

const { rows } = Astro.props;
---

<section
  id="company"
  class="about-company u-full-bleed u-section-spacing u-section-spacing-top-ex u-bg-dark"
>
  <div class="l-container about-company__inner">
    <h2 class="about-company__title">会社概要</h2>
    <div class="about-company__table-scroll">
      <table class="about-company__table">
        <tbody>
          {
            rows.map((row) => (
              <tr class="about-company__row">
                <th class="about-company__label" scope="row">
                  {row.label}
                </th>
                <td class="about-company__value">
                  {row.valueLines.map((line) => (
                    <span class="about-company__value-line">{line}</span>
                  ))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .about-company {
    color: var(--color-white);
  }

  .about-company__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(2rem, 4vw, 3rem);
    padding-inline: clamp(var(--space-6), 5.56vw, 5rem);
  }

  .about-company__title {
    margin: 0;
    font-size: var(--about-company-title-size);
  }

  .about-company__table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .about-company__table {
    inline-size: 56.25rem;
    margin-inline: auto;
    table-layout: fixed;
    border-collapse: collapse;
    border-top: 1px solid #e0dfdf;
    border-right: none;
    border-bottom: 1px solid #e0dfdf;
    border-left: none;
    background-color: var(--color-dark);
    background-image: url("/images/about/about-table-bg.png");
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  .about-company__label,
  .about-company__value {
    inline-size: 50%;
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    padding-block: 1.875rem;
    text-align: left;
    vertical-align: middle;
    line-height: 1.9;
    border-bottom: 1px solid #e0dfdf;
  }

  .about-company__label {
    border-right: none;
    font-weight: var(--weight-bold);
  }

  .about-company__value-line {
    display: block;
  }

  .about-company__row:last-child .about-company__label,
  .about-company__row:last-child .about-company__value {
    border-bottom: none;
  }
</style>
