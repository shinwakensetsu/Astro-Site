---
interface VoiceCard {
  titleLines: string[];
  bodyLines: string[];
}

interface Props {
  titleLines: string[];
  paragraphs: string[][];
  voiceCards: VoiceCard[];
}

const { titleLines, paragraphs, voiceCards } = Astro.props;

const voiceImages = [
  {
    src: "/images/about/employee-1.webp",
    width: 850,
    height: 821,
  },
  {
    src: "/images/about/employee-2.webp",
    width: 850,
    height: 821,
  },
];
---

<section
  id="greeting"
  class="about-greeting u-full-bleed u-section-spacing u-bg-dark"
>
  <div class="l-container about-greeting__inner">
    <div class="about-greeting__hero">
      <div class="about-greeting__hero-image">
        <img
          class="about-greeting__hero-photo"
          src="/images/about/president.webp"
          alt="代表取締役社長 小西 隆夫"
          width="1600"
          height="2395"
          loading="lazy"
        />
      </div>
      <div class="about-greeting__hero-copy">
        <div class="about-greeting__hero-text">
          <h2 class="about-greeting__title">
            {
              titleLines.map((line) => (
                <span class="about-greeting__title-line">{line}</span>
              ))
            }
          </h2>

          <div class="about-greeting__message">
            {
              paragraphs.map((paragraph) => (
                <p class="about-greeting__paragraph">
                  {paragraph.map((line) => (
                    <span class="about-greeting__paragraph-line">{line}</span>
                  ))}
                </p>
              ))
            }
          </div>

          <div class="about-greeting__signature">
            <p class="about-greeting__role">代表取締役社長</p>
            <img
              class="about-greeting__signature-image"
              src="/images/about/konishi-takao.png"
              alt="小西 隆夫"
              width="338"
              height="66"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="about-greeting__voices">
      {
        voiceCards.map((card, index) => (
          <div class="about-greeting__voice">
            <div class="about-greeting__voice-image">
              {voiceImages[index] && (
                <img
                  class="about-greeting__voice-photo"
                  src={voiceImages[index].src}
                  alt=""
                  width={voiceImages[index].width}
                  height={voiceImages[index].height}
                  loading="lazy"
                />
              )}
            </div>
            <div class="about-greeting__voice-body">
              <p
                class="about-greeting__voice-title"
                data-source-line-count={card.titleLines.length}
              >
                {card.titleLines.map((line) => (
                  <span class="about-greeting__voice-title-line">{line}</span>
                ))}
              </p>
              <p class="about-greeting__voice-text">
                {card.bodyLines.map((line) => (
                  <span class="about-greeting__voice-text-line">{line}</span>
                ))}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="about-greeting__actions">
      <a
        class="about-greeting__action about-greeting__action--work"
        href="/services">仕事内容へ</a
      >
      <a
        class="about-greeting__action about-greeting__action--recruit"
        href="/recruit">RECRUITサイトへ</a
      >
    </div>
  </div>
</section>

<script>
  const singleSourceVoiceTitles = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.about-greeting__voice-title[data-source-line-count="1"]',
    ),
  );

  if (singleSourceVoiceTitles.length > 0) {
    let rafId = 0;

    const updateVoiceTitleAlignment = () => {
      rafId = 0;

      singleSourceVoiceTitles.forEach((title) => {
        const line = title.querySelector<HTMLElement>(
          ".about-greeting__voice-title-line",
        );

        if (!line) return;

        const lineHeight = Number.parseFloat(
          getComputedStyle(title).lineHeight,
        );
        const renderedHeight = line.getBoundingClientRect().height;
        const isRenderedSingleLine = renderedHeight <= lineHeight * 1.25;

        title.classList.toggle(
          "about-greeting__voice-title--rendered-single",
          isRenderedSingleLine,
        );
      });
    };

    const requestVoiceTitleUpdate = () => {
      if (rafId !== 0) return;
      rafId = window.requestAnimationFrame(updateVoiceTitleAlignment);
    };

    requestVoiceTitleUpdate();
    window.addEventListener("resize", requestVoiceTitleUpdate, {
      passive: true,
    });

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(requestVoiceTitleUpdate);
      singleSourceVoiceTitles.forEach((title) => resizeObserver.observe(title));
    }

    if (document.fonts?.ready) {
      document.fonts.ready.then(requestVoiceTitleUpdate).catch(() => {});
    }
  }
</script>

<style>
  .about-greeting {
    position: relative;
    overflow: hidden;
    color: var(--color-white);
    isolation: isolate;
  }

  .about-greeting__inner {
    --about-greeting-voices-gap: clamp(2rem, 12.5vw, 10rem);
    --about-greeting-aligned-content-width: min(
      100%,
      calc((518px * 2) + var(--about-greeting-voices-gap))
    );
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--about-greeting-section-gap);
    max-width: calc(
      var(--width-layout) + (var(--about-greeting-section-inline-padding) * 2)
    );
    padding-inline: var(--about-greeting-section-inline-padding);
  }

  .about-greeting__hero {
    --about-greeting-hero-image-min-width: 15rem;
    --about-greeting-hero-copy-max-width: 41.875rem;
    --about-greeting-title-message-gap: 5.625rem;
    display: grid;
    grid-template-columns:
      minmax(var(--about-greeting-hero-image-min-width), 1fr)
      minmax(0, var(--about-greeting-hero-copy-max-width));
    column-gap: 3.125rem;
    row-gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
    width: var(--about-greeting-aligned-content-width);
    margin-inline: auto;
  }

  .about-greeting__hero-image {
    justify-self: start;
    position: relative;
    inline-size: min(100%, 32.375rem);
    aspect-ratio: 518 / 776;
    border: none;
    border-radius: clamp(1.5rem, 4vw, 3rem);
    background-color: rgba(255, 255, 255, 0.04);
    background-image:
      linear-gradient(160deg, rgba(255, 255, 255, 0.16), transparent 50%),
      radial-gradient(
        circle at top right,
        rgba(209, 201, 43, 0.26),
        transparent 42%
      ),
      radial-gradient(
        circle at 14% 82%,
        rgba(68, 138, 172, 0.26),
        transparent 36%
      ),
      url("/images/util/noise-tile-300.svg");
    background-position: center;
    background-repeat: no-repeat, no-repeat, no-repeat, repeat;
    background-size:
      auto,
      auto,
      auto,
      300px 300px;
    box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.24);
    overflow: hidden;
  }

  .about-greeting__hero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-greeting__hero-copy {
    display: grid;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-content: start;
    width: 100%;
    max-width: var(--about-greeting-hero-copy-max-width);
    font-size: var(--about-greeting-title-size);
    min-width: 0;
  }

  .about-greeting__hero-text {
    display: grid;
    gap: 0;
    min-width: 0;
  }

  .about-greeting__title {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--about-greeting-title-size);
    line-height: 1.55;
  }

  .about-greeting__title-line {
    display: block;
  }

  .about-greeting__title-line:first-child {
    font-size: var(--about-greeting-title-accent-size);
    line-height: inherit;
    letter-spacing: 0.08em;
  }

  .about-greeting__signature {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
    width: 100%;
    margin-top: 18px;
    text-align: right;
  }

  .about-greeting__role {
    margin: 0;
    font-size: var(--fs-400);
    line-height: 1;
    letter-spacing: 0.12em;
  }

  .about-greeting__signature-image {
    width: auto;
    max-width: 100%;
    max-height: var(--about-greeting-role-size);
    height: auto;
  }

  .about-greeting__message {
    display: grid;
    gap: 1.5em;
    width: 100%;
    margin: var(--about-greeting-title-message-gap) 0 0;
    font-size: var(--about-greeting-body-size);
    text-align: left;
  }

  .about-greeting__paragraph {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    font-size: inherit;
    line-height: 1.5em;
  }

  .about-greeting__paragraph-line {
    display: block;
  }

  .about-greeting__voices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--about-greeting-voices-gap);
    align-items: stretch;
    width: var(--about-greeting-aligned-content-width);
    margin-inline: auto;
  }

  .about-greeting__voice {
    --about-greeting-voice-accent: rgba(68, 138, 172, 0.22);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-5);
    width: 100%;
    max-width: 518px;
    height: 100%;
    min-width: 0;
    margin-inline: auto;
  }

  .about-greeting__voice:nth-child(2) {
    --about-greeting-voice-accent: rgba(209, 201, 43, 0.22);
  }

  .about-greeting__voice-image {
    inline-size: 100%;
    aspect-ratio: 518 / 500;
    border-radius: clamp(1rem, 3vw, 2rem);
    background-color: rgba(255, 255, 255, 0.04);
    background-image:
      linear-gradient(165deg, rgba(255, 255, 255, 0.14), transparent 55%),
      radial-gradient(
        circle at top right,
        var(--about-greeting-voice-accent),
        transparent 44%
      ),
      linear-gradient(135deg, rgba(255, 255, 255, 0), rgba(0, 0, 0, 0.32)),
      url("/images/util/noise-tile-300.svg");
    background-position: center;
    background-repeat: no-repeat, no-repeat, no-repeat, repeat;
    background-size:
      auto,
      auto,
      auto,
      300px 300px;
    overflow: hidden;
  }

  .about-greeting__voice-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-greeting__voice-body {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-4);
    align-content: start;
    height: 100%;
    min-width: 0;
  }

  .about-greeting__voice-title {
    display: grid;
    grid-auto-rows: minmax(1.65em, auto);
    gap: 0.2rem;
    margin: 0;
    min-block-size: calc(1.65em * 2);
    font-size: var(--about-greeting-card-title-size);
    line-height: 1.65;
    align-content: start;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .about-greeting__voice-title--rendered-single {
    align-content: center;
  }

  .about-greeting__voice-title-line,
  .about-greeting__voice-text-line {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .about-greeting__voice-text {
    display: grid;
    margin: 0;
    font-size: var(--about-greeting-body-size);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .about-greeting__actions {
    --about-greeting-actions-gap: clamp(2rem, 12.5vw, 10rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 12.5625rem));
    column-gap: var(--about-greeting-actions-gap);
    row-gap: var(--space-4);
    width: 100%;
    margin-top: calc(
      var(--about-greeting-actions-spacing) - var(--about-greeting-section-gap)
    );
    margin-inline: auto;
    justify-content: center;
  }

  .about-greeting__action {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    width: 100%;
    max-width: 12.5625rem;
    min-width: 0;
    padding-block: 0.8125rem;
    border: 1px solid transparent;
    border-radius: 15px;
    font-size: var(--about-greeting-action-size);
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--easing-default),
      filter var(--duration-fast) var(--easing-default);
  }

  .about-greeting__action--work {
    background-color: #e0dfdf;
    border-color: var(--color-gray-500);
    color: #5c5c5c;
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
  }

  .about-greeting__action--recruit {
    background-color: #448aac;
    color: #e0dfdf;
  }

  .about-greeting__action:hover {
    text-decoration: none;
    transform: translateY(-2px);
    filter: brightness(0.96);
  }

  @media (max-width: 960px) {
    .about-greeting__voices,
    .about-greeting__actions {
      grid-template-columns: 1fr;
    }
    .about-greeting__voice:nth-child(2) {
      margin-top: clamp(1.5rem, 4vw, 3rem);
    }

    .about-greeting__voice-image {
      inline-size: 50%;
      justify-self: center;
    }
  }

  @media (max-width: 768px) {
    .about-greeting__hero {
      --about-greeting-title-message-gap: clamp(2.5rem, 7vw, 4.5rem);
      grid-template-columns: 1fr;
    }

    .about-greeting__hero-image {
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .about-greeting__hero {
      --about-greeting-title-message-gap: clamp(2rem, 8vw, 3.5rem);
    }

    .about-greeting__title {
      line-height: 1.45;
    }

    .about-greeting__signature {
      align-items: flex-start;
      gap: var(--space-3);
    }
  }

  @media (max-width: 425px) {
    .about-greeting__voice-image {
      inline-size: 60%;
      justify-self: center;
    }
  }
</style>
