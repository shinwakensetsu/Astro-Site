---
interface Props {
  items: {
    label: string;
    desc: string;
    labelWidth: string;
  }[];
}

const { items } = Astro.props;
---

<section
  class="services-about u-full-bleed u-section-spacing u-bg-dark u-bg-noise-dark"
>
  <div class="l-container services-about__inner">
    <h2 class="sr-only">事業紹介</h2>
    <dl class="services-about__list">
      {
        items.map((item) => (
          <div class="services-about__item">
            <dt
              class="services-about__label"
              style={`--services-about-label-width: ${item.labelWidth};`}
            >
              {item.label}
            </dt>
            <dd class="services-about__desc">{item.desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .services-about__inner {
    padding-inline: var(--services-section-inline-padding);
  }

  .services-about__list {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .services-about__item {
    min-width: 0;
  }

  .services-about__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, var(--services-about-label-width, 22.8125rem));
    min-height: 3.6875rem;
    background: var(--color-gray-500);
    border: 1px solid var(--color-primary-light);
    border-radius: 0.9375rem;
    padding: 0.375rem 1rem;
    font-family: var(--font-serif);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    font-size: var(--fs-600);
    line-height: 1.1;
    text-align: center;
  }

  .services-about__desc {
    margin-top: 1.5rem;
    max-width: 74.5rem;
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    color: var(--color-white);
    font-size: var(--fs-body);
    line-height: 1.4444444444;
  }
</style>
