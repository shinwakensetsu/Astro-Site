---
interface Props {
  items: {
    title: string;
    accent: string;
    sub: string;
    text: string;
    imageSrc: string;
    cardSide: "right" | "left";
  }[];
}

const { items } = Astro.props;
---

<section class="services-kodawari u-full-bleed u-bg-primary-light">
  <h2 class="services-section-display-title services-kodawari__display-title">
    <span class="services-display-title__line">こだ</span>
    <span class="services-display-title__line">わり</span>
  </h2>
  <div class="l-container services-kodawari__inner">
    <ul class="services-kodawari__items">
      {
        items.map((item) => (
          <li class="services-kodawari__item">
            <h3 class="services-kodawari__item-title">
              <span class="services-kodawari__item-title-main">
                <>
                  <span>{item.title}</span>
                  <span>{item.accent}</span>
                </>
              </span>
            </h3>
            <div
              class={`services-kodawari__card services-kodawari__card--${item.cardSide} u-bg-noise-dark`}
            >
              <div
                class="services-kodawari__card-media"
                style={`--services-kodawari-card-media-image: url(${item.imageSrc});`}
              >
                <p class="services-kodawari__card-sub">{item.sub}</p>
                <p class="services-kodawari__card-text">{item.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ===========================================
     Shared: display title
     =========================================== */
  .services-section-display-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    position: var(--services-section-display-title-position, absolute);
    top: var(
      --services-section-display-title-top,
      var(--services-kodawari-display-top)
    );
    left: var(
      --services-section-display-title-left,
      var(--services-kodawari-display-left)
    );
    z-index: var(--services-section-display-title-z-index, 1);
    width: var(
      --services-section-display-title-width,
      var(--services-kodawari-display-width)
    );
    min-height: var(
      --services-section-display-title-min-height,
      var(--services-kodawari-display-height)
    );
    max-width: none;
    margin: var(--services-section-display-title-margin, 0);
    font-size: var(--services-section-display-title-size, 6rem);
    line-height: 1.0416667;
    letter-spacing: 0;
    color: var(--color-white);
    pointer-events: var(--services-section-display-title-events, none);
  }

  .services-display-title__line {
    display: block;
    width: 100%;
    white-space: nowrap;
  }

  /* ===========================================
     3. こだわり
     =========================================== */
  .services-kodawari {
    position: relative;
    overflow: clip;
    padding-top: var(--services-kodawari-display-top);
    padding-bottom: 10rem;
  }

  .services-kodawari {
    --services-section-display-title-position: absolute;
    --services-section-display-title-top: var(--services-kodawari-display-top);
    --services-section-display-title-left: var(
      --services-kodawari-display-left
    );
    --services-section-display-title-z-index: 1;
    --services-section-display-title-width: var(
      --services-kodawari-display-width
    );
    --services-section-display-title-min-height: var(
      --services-kodawari-display-height
    );
    --services-section-display-title-size: 6rem;
    --services-section-display-title-margin: 0;
    --services-section-display-title-events: none;
  }

  .services-kodawari__inner {
    max-width: var(--width-layout);
    padding-inline: var(--services-section-inline-padding);
    padding-top: 3rem;
  }

  .services-kodawari__items {
    --services-kodawari-item-max-width: calc(
      var(--services-kodawari-title-column-width) +
        var(--services-kodawari-title-card-gap) +
        var(--services-kodawari-card-width)
    );
    display: grid;
    gap: 4.375rem;
    width: min(var(--services-kodawari-item-max-width), 100%);
    min-width: 0;
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }

  .services-kodawari__item {
    --services-kodawari-title-height: 20.1875rem;
    --services-kodawari-title-offset: 4.1875rem;
    --services-kodawari-card-sub-left: 2.25rem;
    --services-kodawari-card-sub-top: 1.875rem;
    --services-kodawari-card-sub-width: 22rem;
    --services-kodawari-card-text-right: 0.3125rem;
    --services-kodawari-card-text-bottom: 1.6875rem;
    --services-kodawari-card-text-width: 22rem;
    --services-kodawari-card-media-text-padding: 0.75rem 1rem;
    display: grid;
    grid-template-columns:
      var(--services-kodawari-title-column-width)
      minmax(0, 1fr);
    column-gap: var(--services-kodawari-title-card-gap);
    align-items: start;
    min-width: 0;
  }

  .services-kodawari__item:nth-child(2) {
    --services-kodawari-title-height: 27.6875rem;
    --services-kodawari-title-offset: 3.125rem;
    --services-kodawari-card-sub-top: 1.9375rem;
    --services-kodawari-card-text-bottom: 1.3125rem;
  }

  .services-kodawari__item:nth-child(3) {
    --services-kodawari-title-height: 15.625rem;
    --services-kodawari-title-offset: 4.1875rem;
    --services-kodawari-card-sub-left: 1.3125rem;
    --services-kodawari-card-sub-top: 1.4375rem;
    --services-kodawari-card-text-right: 1.75rem;
    --services-kodawari-card-text-bottom: 1.4375rem;
    --services-kodawari-card-text-width: 20.5625rem;
    margin-top: 1.6875rem;
  }

  .services-kodawari__item-title {
    display: block;
    writing-mode: vertical-rl;
    text-orientation: upright;
    width: var(--services-kodawari-title-column-width);
    height: var(--services-kodawari-title-height);
    position: relative;
    font-size: var(--fs-650);
    line-height: 1.2;
    color: var(--color-text);
    letter-spacing: 0.06em;
    margin-top: 0;
    text-align: center;
    white-space: nowrap;
  }

  .services-kodawari__item-title-main {
    font-size: 0;
    line-height: inherit;
  }

  .services-kodawari__item-title-main > span {
    font-size: 2.5rem;
    line-height: inherit;
  }

  .services-kodawari__item-title-main > span:last-child {
    color: var(--color-primary);
  }

  .services-kodawari__card {
    position: relative;
    box-sizing: border-box;
    width: min(var(--services-kodawari-card-width), 100%);
    height: var(--services-kodawari-card-height);
    padding: 0;
    top: 4rem;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--services-kodawari-card-radius) 0 0
      var(--services-kodawari-card-radius);
  }

  .services-kodawari__card-sub {
    grid-area: stack;
    align-self: start;
    justify-self: start;
    width: min(var(--services-kodawari-card-sub-width), 100%);
    max-width: 100%;
    margin: 0;
    font-size: var(--fs-body);
    color: var(--color-white);
    line-height: var(--leading-normal);
    background-color: rgb(92 92 92 / 0.8);
    padding: var(--services-kodawari-card-media-text-padding);
    box-sizing: border-box;
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .services-kodawari__card-media {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-areas: "stack";
    place-items: center;
    padding-block: var(--services-kodawari-card-sub-top)
      var(--services-kodawari-card-text-bottom);
    padding-inline: var(--services-kodawari-card-sub-left)
      var(--services-kodawari-card-text-right);
    background-image: var(--services-kodawari-card-media-image, none);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    min-width: 0;
    pointer-events: none;
  }

  .services-kodawari__card-text {
    grid-area: stack;
    align-self: end;
    justify-self: end;
    width: min(var(--services-kodawari-card-text-width), 100%);
    max-width: 100%;
    margin: 0;
    font-size: var(--fs-body);
    color: var(--color-white);
    line-height: var(--leading-normal);
    text-align: left;
    background-color: rgb(92 92 92 / 0.8);
    padding: var(--services-kodawari-card-media-text-padding);
    box-sizing: border-box;
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  /* ===========================================
     Responsive — max-width: 1440px
     =========================================== */
  @media (max-width: 1440px) {
    .services-kodawari {
      --services-section-display-title-position: static;
      --services-section-display-title-width: fit-content;
      --services-section-display-title-min-height: auto;
      --services-section-display-title-size: clamp(3rem, 9vw, 5rem);
      --services-section-display-title-events: auto;
      --services-section-display-title-margin: var(
        --services-section-display-title-margin-stacked
      );
    }
  }

  /* ===========================================
     Responsive — max-width: 768px
     =========================================== */
  @media (max-width: 768px) {
    .services-kodawari {
      --services-section-display-title-size: clamp(2.5rem, 12vw, 4rem);
    }

    .services-kodawari__item,
    .services-kodawari__item:nth-child(3) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-4);
      margin-top: 0;
    }

    .services-kodawari__item-title {
      width: 100%;
      height: auto;
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      text-align: left;
      white-space: normal;
    }

    /* 縦積み時はカードの 4rem オフセットを解除し、写真をタイトル直下へ寄せる。
       項目間は .services-kodawari__items の gap(4.375rem) で広く保たれ、
       タイトルと写真のまとまり（くくり）が明確になる。 */
    .services-kodawari__card {
      top: 0;
    }

    .services-kodawari__item:nth-child(2) .services-kodawari__card-sub {
      align-self: center;
    }

    /* 2枚目(歴史と文化への敬意)の写真は顔が右上寄り。中央クロップだと
       右下のテキスト帯が顔に被るため、上寄せクロップで顔を帯から逃がす
       （要望: 2枚目の写真の顔が文字に被らない） */
    .services-kodawari__item:nth-child(2) .services-kodawari__card-media {
      background-position: center top;
    }
  }

  /* ===========================================
     Responsive — max-width: 425px
     =========================================== */
  @media (max-width: 425px) {
    .services-kodawari__item-title-main > span {
      font-size: 1.7rem;
    }
  }
</style>
