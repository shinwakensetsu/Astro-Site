---
import { formatDate, getCategoryClass } from "../utils/formatters";

interface Props {
  publishedDate: string;
  category: string;
}

const { publishedDate, category } = Astro.props;
---

<div class="news-meta">
  <time class="news-date" datetime={publishedDate}>
    {formatDate(publishedDate)}
  </time>
  <span class={`news-category news-category--${getCategoryClass(category)}`}>
    {category}
  </span>
</div>

<style>
  .news-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .news-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
  }

  .news-category {
    display: inline-block;
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-white);
    font-weight: var(--weight-semibold);
  }

  .news-category--notice {
    background-color: var(--color-cat-notice);
  }
  .news-category--press {
    background-color: var(--color-cat-press);
  }
  .news-category--event {
    background-color: var(--color-cat-event);
  }
  .news-category--other {
    background-color: var(--color-cat-other);
  }
</style>
