---
import type { News } from "../lib/microcms";
import NewsMeta from "./NewsMeta.astro";

interface Props {
  newsList: News[];
}

const { newsList } = Astro.props;
---

{
  newsList.length > 0 && (
    <section class="news-section">
      <div class="news-section-inner">
        <h2 class="section-title">お知らせ</h2>

        <div class="news-list">
          {newsList.map((news) => (
            <article class="news-item">
              <a href={`/news/${news.slug}`} class="news-link">
                <NewsMeta
                  publishedDate={news.publishedDate}
                  category={news.category}
                />
                <h3 class="news-title">{news.title}</h3>
                {news.excerpt && <p class="news-excerpt">{news.excerpt}</p>}
              </a>
            </article>
          ))}
        </div>

        <div class="news-more">
          <a href="/news/" class="news-more-link">
            お知らせ一覧へ
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .news-section {
    padding: var(--space-16) var(--space-6);
    max-width: var(--width-news);
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-10);
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .news-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    transition:
      box-shadow var(--duration-normal) var(--easing-default),
      transform var(--duration-normal) var(--easing-default);
  }

  .news-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .news-link {
    display: block;
    padding: var(--space-5) var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .news-link:hover {
    text-decoration: none;
  }

  .news-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .news-excerpt {
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    font-size: var(--text-sm);
    margin: var(--space-1) 0 0;
  }

  .news-more {
    text-align: center;
    margin-top: var(--space-8);
  }

  .news-more-link {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    transition:
      background-color var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default);
  }

  .news-more-link:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .news-section {
      padding: var(--space-12) var(--space-4);
    }

    .section-title {
      font-size: var(--text-2xl);
    }

    .news-link {
      padding: var(--space-4) var(--space-5);
    }

    .news-title {
      font-size: var(--text-base);
    }
  }
</style>
