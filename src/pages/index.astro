---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import { getTopPage } from '../lib/microcms';

// microCMSからトップページのデータを取得
// ガイド: 複数のAPIを呼び出す場合は、Promise.allを使用すると並列で取得でき、パフォーマンスが向上します。
// 例:
// const [topPageData, newsData] = await Promise.all([
//   getTopPage(),
//   getNews({ limit: 3 })
// ]);

const topPage = await getTopPage();
---

<Layout>
	{
		topPage.heroImage && (
			<div class="hero-image-container">
				<img
					src={topPage.heroImage.url}
					alt={topPage.heroTitle || "Top Image"}
					width={topPage.heroImage.width}
					height={topPage.heroImage.height}
					class="hero-image"
				/>
				{topPage.heroTitle && <h1 class="hero-title">{topPage.heroTitle}</h1>}
			</div>
		)
	}
	<Welcome />
	<section style="padding: 2rem; max-width: 800px; margin: 0 auto;">
		<h2>よくある質問</h2>
		<FaqSection />
	</section>

	<section style="padding: 2rem; max-width: 800px; margin: 0 auto; text-align: center;">
		<h2>お問い合わせ</h2>
		<p>ご不明な点がございましたら、お気軽にお問い合わせください。</p>
		<a href="/contact" class="contact-link">お問い合わせフォームへ</a>
	</section>
</Layout>

<style>
	.contact-link {
		display: inline-block;
		background-color: #228be6;
		color: white;
		padding: 0.75rem 1.5rem;
		text-decoration: none;
		border-radius: 4px;
		font-weight: bold;
		margin-top: 1rem;
	}
	.contact-link:hover {
		background-color: #1c7ed6;
	}

	.hero-image-container {
		position: relative;
		width: 100%;
		max-height: 400px;
		overflow: hidden;
		margin-bottom: 2rem;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-title {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		color: white;
		font-size: 3rem;
		text-shadow: 0 2px 4px rgba(0,0,0,0.5);
		margin: 0;
		width: 100%;
		text-align: center;
	}
</style>
