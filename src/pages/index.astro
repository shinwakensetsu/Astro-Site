---
import Layout from "../layouts/Layout.astro";
import FaqSection from "../components/FaqSection.astro";
import NewsSection from "../components/NewsSection.astro";
import { getTopPage, getNews, type News } from "../lib/microcms";
import { optimizeImageUrl, imagePresets } from "../utils/imageOptimizer";

// microCMSからトップページのデータとニュースを並列取得
const [topPage, newsResponse] = await Promise.all([
  getTopPage(),
  getNews({ orders: "-publishedDate", limit: 5 }).catch(() => ({
    contents: [] as News[],
  })),
]);
const newsList = newsResponse.contents;
---

<Layout>
  {
    topPage && (
      <div class="hero-container">
        {topPage.heroImage && (
          <div class="hero-image-wrapper">
            <img
              src={optimizeImageUrl(topPage.heroImage.url, imagePresets.hero)}
              alt={topPage.heroTitle || "Top Image"}
              width={topPage.heroImage.width}
              height={topPage.heroImage.height}
              class="hero-image"
              loading="eager"
            />
          </div>
        )}
        <div class="hero-content">
          {topPage.heroTitle && <h1 class="hero-title">{topPage.heroTitle}</h1>}
          {topPage.heroDescription && (
            <p class="hero-description">{topPage.heroDescription}</p>
          )}
        </div>
      </div>
    )
  }
  <NewsSection newsList={newsList} />

  <section class="section-block">
    <h2>よくある質問</h2>
    <FaqSection />
  </section>

  <section class="section-block section-block--center">
    <h2>施工事例</h2>
    <p>これまでの施工事例をご覧いただけます。</p>
    <a href="/works" class="contact-link">施工事例を見る</a>
  </section>

  <section class="section-block section-block--center">
    <h2>お問い合わせ</h2>
    <p>ご不明な点がございましたら、お気軽にお問い合わせください。</p>
    <a href="/contact" class="contact-link">お問い合わせフォームへ</a>
  </section>
</Layout>

<style>
  .contact-link {
    display: inline-block;
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-weight: var(--weight-bold);
    margin-top: var(--space-4);
    transition: background-color var(--duration-fast) var(--easing-default);
  }
  .contact-link:hover {
    background-color: var(--color-dark);
    text-decoration: none;
  }

  .hero-container {
    margin-bottom: var(--space-8);
  }

  .hero-image-wrapper {
    width: 100%;
    max-width: 100vw;
    max-height: 100vh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    width: auto;
    height: auto;
    display: block;
  }

  .hero-content {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-6);
    text-align: center;
  }

  .hero-title {
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-4);
    color: var(--color-text);
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .section-block {
    padding: var(--space-8);
    max-width: var(--width-content);
    margin: 0 auto;
  }

  .section-block--center {
    text-align: center;
  }
</style>
