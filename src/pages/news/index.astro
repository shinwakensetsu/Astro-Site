---
import Layout from "../../layouts/Layout.astro";
import {
  getNews,
  getNewsPage,
  type News,
  type NewsPage,
} from "../../lib/microcms";
import { formatDate, categoryColors } from "../../utils/formatters";

// ページ情報の取得
let page: NewsPage;
try {
  page = await getNewsPage();
} catch {
  // エラー時やエンドポイントがない場合のフォールバック
  page = {
    createdAt: "",
    updatedAt: "",
    publishedAt: "",
    revisedAt: "",
    pageTitle: "お知らせ",
    pageDescription: "最新の情報をお届けします。",
    subtitle: "News",
  };
}

// ニュース一覧の取得
let newsList: News[] = [];
try {
  const response = await getNews({
    orders: "-publishedDate",
    limit: 100,
  });
  newsList = response.contents;
} catch (e) {
  console.error("Failed to fetch news:", e);
}
---

<Layout title={page.pageTitle} description={page.pageDescription}>
  <!-- ページヘッダー -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">{page.pageTitle}</h1>
      <p class="page-description">{page.pageDescription}</p>
    </div>
  </section>

  <!-- お知らせ一覧 -->
  <section class="news">
    <div class="container">
      <p class="subtitle">{page.subtitle}</p>

      <div class="news-list">
        {
          newsList.map((news) => (
            <article class="news-item">
              <a href={`/news/${news.slug}`}>
                <div class="news-meta">
                  <time class="news-date" datetime={news.publishedDate}>
                    {formatDate(news.publishedDate)}
                  </time>
                  <span
                    class="news-category"
                    style={`background-color: ${categoryColors[news.category]};`}
                  >
                    {news.category}
                  </span>
                </div>
                <h2 class="news-title">{news.title}</h2>
                {news.excerpt && <p class="news-excerpt">{news.excerpt}</p>}
              </a>
            </article>
          ))
        }
      </div>

      {
        newsList.length === 0 && (
          <p class="no-news">現在、お知らせはありません。</p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* ページヘッダー */
  .page-header {
    background: linear-gradient(135deg, #0066cc, #0051a3);
    color: #fff;
    padding: 80px 0;
    text-align: center;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .page-description {
    font-size: 1.125rem;
    opacity: 0.95;
    max-width: 600px;
    margin: 0 auto;
  }

  /* お知らせ一覧 */
  .news {
    padding: 80px 0;
  }

  .subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: #666;
    margin-bottom: 60px;
    line-height: 1.8;
  }

  .news-list {
    max-width: 900px;
    margin: 0 auto;
  }

  .news-item {
    background: #fff;
    border-radius: 8px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s;
  }

  .news-item:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .news-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 12px;
  }

  .news-date {
    font-size: 0.875rem;
    color: #999;
    font-weight: 500;
  }

  .news-category {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #fff;
    font-weight: 600;
  }

  .news-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .news-excerpt {
    color: #666;
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .no-news {
    text-align: center;
    color: #999;
    padding: 60px 0;
    font-size: 1.125rem;
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .news {
      padding: 60px 0;
    }

    .news-item {
      padding: 24px;
    }

    .news-title {
      font-size: 1.125rem;
    }
  }
</style>
