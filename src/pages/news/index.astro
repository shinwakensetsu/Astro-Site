---
import Layout from "../../layouts/Layout.astro";
import {
  getNews,
  getNewsPage,
  type News,
  type NewsPage,
} from "../../lib/microcms";
import NewsMeta from "../../components/NewsMeta.astro";
import { optimizeImageUrl } from "../../utils/imageOptimizer";

// ページ情報の取得
let page: NewsPage;
try {
  page = await getNewsPage();
} catch {
  // エラー時やエンドポイントがない場合のフォールバック
  page = {
    createdAt: "",
    updatedAt: "",
    publishedAt: "",
    revisedAt: "",
    pageTitle: "お知らせ",
    pageDescription: "最新の情報をお届けします。",
    subtitle: "News",
  };
}

// ニュース一覧の取得
let newsList: News[] = [];
try {
  const response = await getNews({
    orders: "-publishedDate",
    limit: 100,
  });
  newsList = response.contents;
} catch (e) {
  console.error("Failed to fetch news:", e);
}
---

<Layout title={page.pageTitle} description={page.pageDescription}>
  <main>
    <!-- ===== ページヘッダー (base-container) ===== -->
    <section class="news-header u-full-bleed">
      <div class="l-container news-header__container">
        <h1 class="news-header__title">{page.pageTitle}</h1>
        <p class="news-header__description">{page.pageDescription}</p>
      </div>
    </section>

    <!-- ===== お知らせ一覧 (base-container) ===== -->
    <section class="news-content u-section-spacing">
      <div class="l-container news-content__container">
        <h2 class="news-content__heading">お知らせ一覧</h2>

        <div class="news-list">
          {
            newsList.map((news) => (
              <article class="news-item">
                <a class="news-item__link" href={`/news/${news.slug}`}>
                  <div class="news-item__thumb">
                    {news.thumbnail ? (
                      <img
                        class="news-item__img"
                        src={optimizeImageUrl(news.thumbnail.url, {
                          width: 180,
                          height: 180,
                          fit: "crop",
                          format: "auto",
                          quality: 80,
                        })}
                        alt=""
                        width="180"
                        height="180"
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class="news-item__thumb news-item__thumb--placeholder"
                        aria-hidden="true"
                      />
                    )}
                  </div>
                  <div class="news-item__body">
                    <NewsMeta
                      publishedDate={news.publishedDate}
                      category={news.category}
                    />
                    <h2 class="news-title">{news.title}</h2>
                    {news.excerpt && <p class="news-excerpt">{news.excerpt}</p>}
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {
          newsList.length === 0 && (
            <p class="no-news">現在、お知らせはありません。</p>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ===== ヘッダー外枠 ===== */
  .news-header {
    background: var(--gradient-page-header);
    color: var(--color-white);
    padding-block: var(--space-20);
    text-align: center;
  }

  .news-header__title {
    font-size: var(--fs-700);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .news-header__description {
    font-size: var(--fs-300);
    opacity: 0.95;
    max-width: var(--width-description);
    margin: 0 auto;
  }

  /* ===== 一覧セクション ===== */
  .news-content__heading {
    font-size: var(--fs-750);
    margin-inline: auto;
    text-align: center;
  }

  .news-list {
    max-width: var(--width-news);
    margin-inline: auto;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .news-item {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-5);
    margin-inline: 1rem;
    box-shadow: var(--shadow-md);
    transition:
      box-shadow var(--duration-normal) var(--easing-default),
      transform var(--duration-normal) var(--easing-default);
  }

  .news-item:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  /* --- news-item 内部 --- */
  .news-item__link {
    display: flex;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .news-item__thumb {
    --news-item-thumb-size: clamp(5rem, 12vw, 10rem);
    flex-shrink: 0;
    width: var(--news-item-thumb-size);
    height: var(--news-item-thumb-size);
    border-radius: var(--radius-lg) 0 0 0;
    overflow: hidden;
    filter: drop-shadow(8px 8px 0 var(--color-gray-700));
  }

  .news-item__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-item__thumb--placeholder {
    background-color: var(--color-gray-200);
  }

  .news-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
  }

  .news-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: var(--leading-normal);
  }

  .news-excerpt {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
  }

  .no-news {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
    font-size: var(--text-lg);
  }

  @media (max-width: 768px) {
    .news-item {
      padding: var(--space-6);
    }

    .news-title {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 425px) {
    .news-item__link {
      flex-direction: column;
    }

    .news-item__thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
  }
</style>
