---
import Layout from "../../layouts/Layout.astro";
import {
  getNews,
  getNewsPage,
  type News,
  type NewsPage,
} from "../../lib/microcms";
import NewsMeta from "../../components/NewsMeta.astro";

// ページ情報の取得
let page: NewsPage;
try {
  page = await getNewsPage();
} catch {
  // エラー時やエンドポイントがない場合のフォールバック
  page = {
    createdAt: "",
    updatedAt: "",
    publishedAt: "",
    revisedAt: "",
    pageTitle: "お知らせ",
    pageDescription: "最新の情報をお届けします。",
    subtitle: "News",
  };
}

// ニュース一覧の取得
let newsList: News[] = [];
try {
  const response = await getNews({
    orders: "-publishedDate",
    limit: 100,
  });
  newsList = response.contents;
} catch (e) {
  console.error("Failed to fetch news:", e);
}
---

<Layout title={page.pageTitle} description={page.pageDescription}>
  <!-- ページヘッダー -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">{page.pageTitle}</h1>
      <p class="page-description">{page.pageDescription}</p>
    </div>
  </section>

  <!-- お知らせ一覧 -->
  <section class="news">
    <div class="container">
      <p class="subtitle">{page.subtitle}</p>

      <div class="news-list">
        {
          newsList.map((news) => (
            <article class="news-item">
              <a href={`/news/${news.slug}`}>
                <NewsMeta
                  publishedDate={news.publishedDate}
                  category={news.category}
                />
                <h2 class="news-title">{news.title}</h2>
                {news.excerpt && <p class="news-excerpt">{news.excerpt}</p>}
              </a>
            </article>
          ))
        }
      </div>

      {
        newsList.length === 0 && (
          <p class="no-news">現在、お知らせはありません。</p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-primary-dark)
    );
    color: var(--color-white);
    padding: var(--space-20) 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .page-description {
    font-size: var(--text-lg);
    opacity: 0.95;
    max-width: var(--width-description);
    margin: 0 auto;
  }

  .news {
    padding: var(--space-20) 0;
  }

  .subtitle {
    text-align: center;
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-16);
    line-height: var(--leading-relaxed);
  }

  .news-list {
    max-width: var(--width-news);
    margin: 0 auto;
  }

  .news-item {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-5);
    box-shadow: var(--shadow-md);
    transition:
      box-shadow var(--duration-normal) var(--easing-default),
      transform var(--duration-normal) var(--easing-default);
  }

  .news-item:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .news-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: var(--leading-normal);
  }

  .news-excerpt {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
  }

  .no-news {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
    font-size: var(--text-lg);
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: var(--text-4xl);
    }

    .news {
      padding: var(--space-16) 0;
    }

    .news-item {
      padding: var(--space-6);
    }

    .news-title {
      font-size: var(--text-lg);
    }
  }
</style>
