---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getNews } from "../../lib/microcms";
import { sanitizeHtml } from "../../utils/htmlSanitizer";
import NewsMeta from "../../components/NewsMeta.astro";
import { optimizeImageUrl, imagePresets } from "../../utils/imageOptimizer";

const { slug } = Astro.params;
const response = await getNews({ filters: `slug[equals]${slug}` });
const news = response.contents[0];

if (!news) {
  return Astro.redirect("/news");
}
---

<Layout title={news.title} description={news.excerpt}>
  <!-- ページヘッダー -->
  <section class="page-header">
    <div class="container">
      <NewsMeta publishedDate={news.publishedDate} category={news.category} />
      <h1 class="page-title">{news.title}</h1>
    </div>
  </section>

  <!-- サムネイル -->
  {
    news.thumbnail && (
      <section class="thumbnail">
        <div class="container">
          <img
            src={optimizeImageUrl(news.thumbnail.url, imagePresets.thumbnail)}
            alt={news.title}
            loading="lazy"
          />
        </div>
      </section>
    )
  }

  <!-- 本文 -->
  <section class="news-content">
    <div class="container">
      <div class="content" set:html={sanitizeHtml(news.content)} />
    </div>
  </section>

  <!-- ナビゲーション -->
  <section class="navigation">
    <div class="container">
      <a href="/news" class="back-link">← お知らせ一覧へ戻る</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--color-bg-secondary);
    padding: var(--space-16) 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1.4;
    max-width: var(--width-news);
  }

  .thumbnail {
    padding: var(--space-10) 0;
  }

  .thumbnail img {
    width: 100%;
    max-width: var(--width-news);
    margin: 0 auto;
    display: block;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .news-content {
    padding: var(--space-16) 0 var(--space-20);
  }

  .content {
    max-width: var(--width-content);
    margin: 0 auto;
  }

  .content :global(h2) {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    margin: var(--space-16) 0 var(--space-5);
    color: var(--color-text);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-border-light);
  }

  .content :global(h3) {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    margin: var(--space-10) 0 var(--space-4);
    color: var(--color-text-secondary);
  }

  .content :global(h4) {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    margin: var(--space-8) 0 var(--space-3);
    color: var(--color-text-secondary);
  }

  .content :global(p) {
    line-height: var(--leading-loose);
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: var(--space-6) 0;
    padding-left: var(--space-8);
  }

  .content :global(li) {
    line-height: var(--leading-loose);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-5);
    margin: var(--space-8) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-10) 0;
    box-shadow: var(--shadow-md);
  }

  .content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .content :global(a:hover) {
    text-decoration: none;
  }

  .content :global(code) {
    background: var(--color-bg-tertiary);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .content :global(pre) {
    background: var(--color-gray-900);
    color: var(--color-white);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-8) 0;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .navigation {
    padding: var(--space-10) 0 var(--space-20);
    border-top: 1px solid var(--color-border-light);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    transition: transform var(--duration-normal) var(--easing-default);
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: var(--text-3xl);
    }

    .news-content {
      padding: var(--space-10) 0 var(--space-16);
    }

    .content :global(h2) {
      font-size: var(--text-2xl);
    }

    .content :global(h3) {
      font-size: var(--text-xl);
    }
  }
</style>
