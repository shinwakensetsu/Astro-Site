---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getNews } from "../../lib/microcms";
import { sanitizeHtml } from "../../utils/htmlSanitizer";
import NewsMeta from "../../components/NewsMeta.astro";

const { slug } = Astro.params;
const response = await getNews({ filters: `slug[equals]${slug}` });
const news = response.contents[0];

if (!news) {
  return Astro.redirect("/news");
}
---

<Layout title={news.title} description={news.excerpt}>
  <main>
    <article class="news-detail">
      <div class="news-detail__container">
        <div class="news-detail__intro">
          <div class="news-detail__meta">
            <NewsMeta
              publishedDate={news.publishedDate}
              category={news.category}
            />
          </div>
          <h1 class="news-detail__title">{news.title}</h1>
        </div>

        <!-- CONTENT-BLOCK -->
        <div class="news-detail__content">
          <div class="news-detail__body">
            <p set:html={sanitizeHtml(news.content)} />
          </div>
        </div>

        <!-- ACTIONS-BLOCK -->
        <nav class="news-detail__actions" aria-label="お知らせナビゲーション">
          <a href="/news" class="news-detail__back-link">← お知らせ一覧へ戻る</a
          >
        </nav>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* ===== 記事外枠 ===== */
  .news-detail {
    padding-inline: var(--space-3);
  }

  .news-detail__container {
    max-width: 1024px;
    margin-inline: auto;
    margin-top: var(--space-6);
    padding-inline: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    padding-block: var(--space-8);
  }

  /* ===== イントロ（タイトル・メタ） ===== */
  .news-detail__intro {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .news-detail__meta {
    margin-bottom: var(--space-4);
  }

  .news-detail__title {
    font-size: var(--fs-700);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: var(--leading-tight);
  }

  /* ===== コンテンツ ===== */

  .news-detail__body {
  }

  .news-detail__body :global(h2) {
    font-size: var(--fs-600);
    font-weight: var(--weight-bold);
    margin: var(--space-16) 0 var(--space-5);
    color: var(--color-text);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-border-light);
  }

  .news-detail__body :global(h3) {
    font-size: var(--fs-400);
    font-weight: var(--weight-semibold);
    margin: var(--space-10) 0 var(--space-4);
    color: var(--color-text-secondary);
  }

  .news-detail__body :global(h4) {
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    margin: var(--space-8) 0 var(--space-3);
    color: var(--color-text-secondary);
  }

  .news-detail__body :global(p) {
    line-height: var(--leading-loose);
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
  }

  .news-detail__body :global(ul),
  .news-detail__body :global(ol) {
    margin: var(--space-6) 0;
    padding-left: var(--space-8);
  }

  .news-detail__body :global(li) {
    line-height: var(--leading-loose);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .news-detail__body :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-5);
    margin: var(--space-8) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .news-detail__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-10) 0;
    box-shadow: var(--shadow-md);
  }

  .news-detail__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .news-detail__body :global(a:hover) {
    text-decoration: none;
  }

  .news-detail__body :global(code) {
    background: var(--color-bg-tertiary);
    padding: 0.125em 0.375em;
    border-radius: 0.1875em;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .news-detail__body :global(pre) {
    background: var(--color-gray-900);
    color: var(--color-white);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-8) 0;
  }

  .news-detail__body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
  .news-detail__content {
    padding-block: var(--space-8);
    width: 90%;
    margin: auto;
  }

  /* ===== ナビゲーション ===== */
  .news-detail__actions {
    margin-top: var(--space-10);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border-light);
  }

  .news-detail__back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-gray-700);
    font-weight: var(--weight-semibold);
    transition: transform var(--duration-normal) var(--easing-default);
  }

  .news-detail__back-link:hover {
    transform: translateX(-0.3125rem);
  }
</style>
