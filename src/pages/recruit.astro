---
// src/pages/recruit.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="採用情報" description="採用情報ページです。">
  <!-- ===== 1. ページヘッダー ===== -->
  <section class="recruit-header">
    <div class="container--layout recruit-header__inner"></div>
  </section>

  <!-- ===== 2. 求人情報 ===== -->
  <section class="recruit-jobs">
    <div class="container--layout recruit-jobs__inner"></div>
  </section>

  <!-- ===== 3. 応募方法 ===== -->
  <section class="recruit-entry">
    <div class="container--layout recruit-entry__inner"></div>
  </section>
</Layout>

<style>
  .recruit-header__inner,
  .recruit-jobs__inner,
  .recruit-entry__inner {
    padding-block: var(--space-16);
  }
</style>
