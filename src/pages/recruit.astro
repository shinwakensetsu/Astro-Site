---
import Layout from "../layouts/Layout.astro";
import Accordion from "../components/Accordion.astro";
import AccordionItem from "../components/AccordionItem.astro";
import BeltHeader from "../components/BeltHeader.astro";

interface PersonaCard {
  number: string;
  title: string;
  paragraphs: string[];
  mediaLabel?: string;
  mediaPosition?: "start" | "end";
}

const personaCards: PersonaCard[] = [
  {
    number: "01",
    title: "文化や歴史を大切にできる人",
    paragraphs: [
      "社寺建築は、ただ木を組み、建物をつくる仕事ではありません。その土地に生きてきた人々の祈り、風習、時代背景といった「文化の積み重ね」を形にする仕事です。\n社寺には、長い年月をかけて地域の人々が大切に守り続けてきた「想い」が宿っています。その想いを理解し、建物だけでなく、その背後にある精神性や価値観を丁寧に受け取ろうとする姿勢が、私たちの仕事には欠かせません。",
      "歴史を尊び、文化を敬う心を持てる人。\nそして、建築という行為を通して「文化の継承者」としての役割を果たしたいと自然に思える人。\nそんな方と、一緒に未来の社寺をつくっていきたいと考えています。",
    ],
  },
  {
    number: "02",
    title: "誠実で、丁寧な仕事ができる人",
    paragraphs: [
      "社寺建築は、一般的な建築とは異なり、細部に宿る美しさや正確さがそのまま建物の価値になります。1本の木材の選び方、1mmの仕口の調整、柱の立ち心地。それらの積み重ねが、百年後、二百年後まで残り続ける建築物をつくります。だからこそ、この仕事には「ごまかし」や「妥協」がありません。一度手を入れた部分はやり直しが効かないことも多く、一つひとつの判断に高い責任が伴います。",
      "そのため、技術力以上に求められるのは「誠実さ」と「丁寧に向き合う姿勢」です。",
    ],
    mediaLabel: "作業風景2",
    mediaPosition: "start",
  },
  {
    number: "03",
    title: "歴史を未来に届ける責任を楽しめる人",
    paragraphs: [
      "社寺建築に携わるということは、「自分の手でつくったものが、100年後の景色にまだ存在している」という、他の仕事ではなかなか味わえない特別な体験につながります。今この瞬間の仕事が、未来の人々にとっての大切な拠り所となり続けるそれは大きな責任であると同時に、仕事の価値を深く実感できる喜びでもあります。",
      "責任の重さに怯えるのではなく、「未来に届ける文化を自分が担っている」という誇りを持てること。\n目の前の作業の先に、何十年先、何百年先の人々の暮らしや祈りがあることを想像しながら働けること。\nそれが、私たちが求める人物像のひとつです。",
    ],
    mediaLabel: "作業風景2",
    mediaPosition: "end",
  },
];

interface DataItem {
  label: string;
  values: string[];
  layout?: "row";
}

const dataItems: DataItem[] = [
  { label: "平均年齢", values: ["38歳"] },
  {
    label: "スタッフ人数",
    values: ["大工：00人", "監督：00人"],
    layout: "row",
  },
  { label: "資格支援制度", values: ["あり"] },
  { label: "教育制度", values: ["歴史的建築を学ぶ研修が充実"] },
  { label: "社宅制度", values: ["あり"] },
  { label: "技術手当", values: ["あり"] },
];

const requirementRows = [
  { label: "職種", value: "現場監督 及び 大工" },
  { label: "募集人員", value: "若干名" },
  {
    label: "必要書類",
    value: "履歴書\n卒業（見込）証明書\n成績証明書\n健康診断書",
  },
  { label: "採用条件", value: "初任給当社規定により優遇いたします。" },
  {
    label: "制度",
    value:
      "諸手当通勤費負担\n出張手当\n技術手当\n超過勤務手当\n他昇給年1回賞与年2回勤務地京都\n長期地方勤務有り",
  },
  { label: "採用条件", value: "初任給当社規定により優遇いたします。" },
  {
    label: "勤務時間現場",
    value: "監督　8:30〜17:30\n大工　8:00〜17:00",
  },
  {
    label: "休日",
    value:
      "休暇隔週週休2日制\n有給休暇（最高20日）\n年末年始\n夏期休暇\n他福利厚生各種社会保険\n社宅制度",
  },
];

const faqItems = [
  {
    question: "Q1. 建築や大工の経験がまったくなくても応募できますか？",
    answer:
      "はい、問題ありません。\n現在活躍している社員の中にも、未経験からスタートした人が多数います。\n基礎から丁寧に教える環境があり、道具の名前や使い方、現場での動き方まで一つずつ身につけていけます。\n「やってみたい」という気持ちがあれば、十分なスタートラインです。",
  },
  {
    question: "Q2. 文系出身でも施工監督になれますか？",
    answer:
      "なれます。\n施工監督に必要なのは、専門知識だけでなく「人と現場をまとめる力」です。入社後に建築の基礎知識を学び、現場で経験を積みながら成長できます。文系出身で活躍している監督も在籍しています。",
  },
  {
    question: "Q3. 伝統技術はどのように学びますか？",
    answer:
      "現場でのOJTが基本です。\n先輩職人や監督の仕事を間近で見ながら、少しずつ実践を通して習得していきます。社寺建築は一朝一夕では身につかない技術だからこそ、時間をかけて育てる文化があります。",
  },
  {
    question: "Q4. 女性も働けますか？",
    answer:
      "もちろんです。\n施工監督・設計・事務など、さまざまな職種で女性社員が活躍しています。\n社寺建築という分野だからこそ、丁寧さや気配りが大きな強みになる場面も多くあります。",
  },
  {
    question: "Q5. どんな人がこの会社に向いていますか？",
    answer:
      "・ものづくりが好きな人\n・日本の建築や文化に興味がある人\n・コツコツ続けることが得意な人\n・「仕事に誇りを持ちたい」と思っている人\n特別な才能は必要ありません。続ける意志と、学ぶ姿勢があれば十分です。",
  },
];
---

<Layout
  title="採用情報"
  description="伸和建設の採用情報ページです。社寺建築の現場監督・大工を募集しています。"
>
  <main class="recruit">
    <h1 class="sr-only">採用情報</h1>

    <div class="recruit-layout">
      <nav class="recruit-sidebar" aria-label="採用ページナビゲーション">
        <div class="recruit-sidebar__inner">
          <a class="recruit-sidebar__back" href="/">
            <svg
              class="recruit-sidebar__back-icon"
              viewBox="0 0 18.6 5.83"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M8.1 0L9.757 1.183L5.568 4.167H18.6V5.833H5.568H0L1.1 5L8.1 0Z"
                fill="currentColor"></path>
            </svg>
            本サイトへ
          </a>

          <div class="recruit-sidebar__photo" aria-hidden="true">
            <img src="/images/top-hero.jpeg" alt="" />
          </div>

          <div class="recruit-sidebar__stripes" aria-hidden="true"></div>

          <ul class="recruit-sidebar__menu">
            <li data-target="persona"><a href="#persona">求める人物像</a></li>
            <li data-target="supervisor">
              <a href="#supervisor">監督の仕事紹介</a>
            </li>
            <li data-target="carpenter">
              <a href="#carpenter">大工の仕事紹介</a>
            </li>
            <li data-target="requirements">
              <a href="#requirements">募集要項</a>
            </li>
            <li data-target="faq"><a href="#faq">よくある質問</a></li>
            <li data-target="entry"><a href="#entry">エントリー</a></li>
          </ul>
        </div>
      </nav>

      <div class="recruit-main">
        <!-- ===== 1. RECRUIT ヘッダー ===== -->
        <section class="recruit-header u-bg-primary-light">
          <h2 class="sr-only">RECRUIT</h2>
          <div class="recruit-header__container">
            <div class="recruit-header__left">
              <img
                class="recruit-header__logo"
                src="/images/util/SHINWA CONSTRUCTION CO.,LTD.svg"
                alt="伸和建設株式会社"
                width="302"
                height="58"
              />
              <img
                class="recruit-header__recruit-svg"
                src="/images/recruit/recruit.svg"
                alt=""
                aria-hidden="true"
                width="295"
                height="59"
              />
              <p class="recruit-header__lead">伸和建設の採用情報</p>
              <a class="recruit-header__cta" href="/contact">
                <span class="recruit-header__cta-text">
                  <span>エントリーは</span>
                  <span>こちら</span>
                </span>
                <svg
                  class="recruit-header__cta-arrow"
                  viewBox="0 0 14 23"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M3.406.584a2 2 0 0 0-2.822 0 2 2 0 0 0-.001 2.82l6.343 6.357a2 2 0 0 1 0 2.825L.583 18.943a2 2 0 0 0-.001 2.82 2 2 0 0 0 2.822 0l9.177-9.175a2 2 0 0 0 0-2.829L3.406.584Z"
                    fill="currentColor"></path>
                </svg>
              </a>
            </div>
            <div class="recruit-header__hero">
              <span class="recruit-header__hero-label">作業風景１</span>
            </div>
          </div>
        </section>

        <!-- ===== 2. 求める人物像 ===== -->
        <section id="persona" class="recruit-persona">
          <div class="l-container recruit-persona__container">
            <div class="recruit-persona__content">
              <div class="recruit-persona__intro">
                <div class="recruit-persona__photo">
                  <div class="recruit-persona__photo-visual">
                    <span class="recruit-persona__photo-label"
                      >代表者の写真</span
                    >
                  </div>
                  <div class="recruit-persona__photo-meta">
                    <p class="recruit-persona__author">
                      <span class="recruit-persona__author-role"
                        >代表取締役社長</span
                      >
                      <span class="recruit-persona__author-name">小西 隆夫</span
                      >
                    </p>
                  </div>
                </div>

                <div class="recruit-persona__body">
                  <div class="recruit-persona__heading-group">
                    <h2 class="recruit-persona__title">
                      <span class="recruit-persona__title-line"
                        >技術だけでなく</span
                      >
                      <span
                        class="recruit-persona__title-line recruit-persona__title-line--accent"
                        >人もまたつないでいく</span
                      >
                      <span class="recruit-persona__title-line"
                        >企業でありたい</span
                      >
                    </h2>
                  </div>
                </div>
              </div>

              <div class="recruit-persona__cards">
                <ul class="recruit-persona__list">
                  {
                    personaCards.map((card) => (
                      <li class="recruit-persona__item">
                        <article
                          class:list={[
                            "recruit-persona-card",
                            {
                              "recruit-persona-card--with-media": Boolean(
                                card.mediaLabel,
                              ),
                            },
                            {
                              "recruit-persona-card--media-start":
                                card.mediaPosition === "start",
                            },
                            {
                              "recruit-persona-card--media-end":
                                card.mediaPosition === "end",
                            },
                          ]}
                        >
                          {card.mediaLabel ? (
                            <>
                              <div class="recruit-persona-card__content">
                                <header class="recruit-persona-card__header">
                                  <span class="recruit-persona-card__number">
                                    {card.number}
                                  </span>
                                  <h3 class="recruit-persona-card__title">
                                    {card.title}
                                  </h3>
                                </header>

                                <div class="recruit-persona-card__body">
                                  {card.paragraphs.map((paragraph) => (
                                    <p>
                                      {paragraph
                                        .split("\n")
                                        .map((line, index, lines) => (
                                          <>
                                            {line}
                                            {index < lines.length - 1 && <br />}
                                          </>
                                        ))}
                                    </p>
                                  ))}
                                </div>
                              </div>

                              <footer class="recruit-persona-card__footer">
                                <div class="recruit-persona-card__media">
                                  <span class="recruit-persona-card__media-label">
                                    {card.mediaLabel}
                                  </span>
                                </div>
                              </footer>
                            </>
                          ) : (
                            <>
                              <header class="recruit-persona-card__header">
                                <span class="recruit-persona-card__number">
                                  {card.number}
                                </span>
                                <h3 class="recruit-persona-card__title">
                                  {card.title}
                                </h3>
                              </header>

                              <div class="recruit-persona-card__body">
                                {card.paragraphs.map((paragraph) => (
                                  <p>
                                    {paragraph
                                      .split("\n")
                                      .map((line, index, lines) => (
                                        <>
                                          {line}
                                          {index < lines.length - 1 && <br />}
                                        </>
                                      ))}
                                  </p>
                                ))}
                              </div>
                            </>
                          )}
                        </article>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- ===== 3. 見える化 ===== -->
        <section class="recruit-data">
          <div class="recruit-data__container">
            <h2 class="recruit-data__title">伸和建設の見える化</h2>

            <div class="recruit-data__card">
              <div class="recruit-data__grid">
                {
                  dataItems.map((item) => (
                    <div class="recruit-data__cell">
                      <p class="recruit-data__cell-label">{item.label}</p>
                      <div
                        class:list={[
                          "recruit-data__cell-value",
                          {
                            "recruit-data__cell-value--row":
                              item.layout === "row",
                          },
                        ]}
                      >
                        {item.values.map((v) => (
                          <p class="recruit-data__cell-text">{v}</p>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <p class="recruit-data__note">※2026年3月時点</p>
          </div>
        </section>

        <!-- ===== 4a. 現場監督 ===== -->
        <section
          id="supervisor"
          class="recruit-job recruit-job--supervisor u-bg-primary-light"
        >
          <div class="recruit-job__deco-band" aria-hidden="true">
            <BeltHeader />
          </div>
          <div class="l-container recruit-job__inner">
            <div class="recruit-job__deco-label-wrap" aria-hidden="true">
              <span class="recruit-job__deco-label">現場監督</span>
            </div>
            <h2 class="recruit-job__title">
              千年先も残る建物を<br />いまの自分たちがつくっている
            </h2>

            <div class="recruit-job__profile">
              <div class="recruit-job__profile-photo">
                <span class="recruit-job__profile-photo-label">監督</span>
              </div>
              <div class="recruit-job__profile-info">
                <p class="recruit-job__profile-role">〇〇さん（〇〇歳）</p>
                <p class="recruit-job__profile-name">現場監督（〇〇年入社）</p>
              </div>
            </div>
            <div class="recruit-job__content">
              <div class="recruit-job__video">
                <div
                  class="recruit-job__video-placeholder"
                  aria-label="インタビュー動画"
                >
                  <span class="recruit-job__video-label">Movie</span>
                </div>
              </div>

              <div class="recruit-job__quote">
                <p class="recruit-job__quote-text">
                  社寺建築は一棟一棟が地域の象徴で、歴史そのもの。<br />
                  伸和建設は150年続く技術と実績があり<br />
                  「ここなら本物の仕事ができる」と感じて入社しました。
                </p>
              </div>

              <div class="recruit-job__message">
                <p>
                  図面通りに造るだけではなく、大工や職人さんの技術を最大限に引き出しながら、一つの建物を完成させることにやりがいを感じています。社寺建築は前例のない納まりも多く、現場で考え、相談し、形にしていく。<br
                  />
                  完成したときに職人さんと一緒に見上げる本堂や門は、何度経験しても鳥肌が立ちます。
                </p>
                <p>
                  この仕事は派手ではありませんが、確実に日本の文化を支える仕事だと自負してます。<br
                  />
                  完成した建物を子どもや孫に見せられる。<br />
                  そんな誇りを持てる仕事を、一緒にやりませんか。
                </p>
              </div>
            </div>

            <div class="recruit-job__slider-wrap" tabindex="0">
              <div class="recruit-job__slider-list">
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿1</span>
                </div>
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿2</span>
                </div>
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿3</span>
                </div>
              </div>
            </div>

            <div class="recruit-job__feature-photo">
              <span class="recruit-job__feature-photo-label"
                >監督の仕事<br />（取材後予定）</span
              >
            </div>
          </div>
        </section>

        <!-- ===== 4b. 大工 ===== -->
        <section
          id="carpenter"
          class="recruit-job recruit-job--carpenter u-bg-primary-light"
        >
          <div class="recruit-job__deco-band" aria-hidden="true">
            <BeltHeader />
          </div>
          <div class="l-container recruit-job__inner">
            <div class="recruit-job__deco-label-wrap" aria-hidden="true">
              <span class="recruit-job__deco-label">大工</span>
            </div>
            <h2 class="recruit-job__title">
              自分の手が、過去と現在と<br />未来の景色をつくる仕事
            </h2>

            <div class="recruit-job__profile">
              <div class="recruit-job__profile-photo" aria-hidden="true">
                <!-- プロフィール写真プレースホルダー -->
              </div>
              <div class="recruit-job__profile-info">
                <p class="recruit-job__profile-role">〇〇さん（〇〇歳）</p>
                <p class="recruit-job__profile-name">大工（〇〇年入社）</p>
              </div>
            </div>

            <div class="recruit-job__content">
              <div class="recruit-job__video">
                <div
                  class="recruit-job__video-placeholder"
                  aria-label="インタビュー動画"
                >
                  <!-- iframe プレースホルダー -->
                </div>
              </div>

              <div class="recruit-job__quote">
                <p class="recruit-job__quote-text">
                  これほど誇れる仕事もありません。<br />
                  一緒に自分の手で日本の文化を残しませんか。
                </p>
              </div>

              <div class="recruit-job__message">
                <p>
                  子どもの頃、地元のお寺の修復工事を見たのがきっかけです。
                  木だけで組み上がっていく姿に衝撃を受け、「これを仕事にしたい」と思いました。
                  伸和建設は社寺建築一筋で、本物の技術が学べる環境だと思い入社しました。
                </p>
                <p>
                  すべてが一点ものです。
                  木のクセを読み、手刻みで調整し、ピタッとはまった瞬間の快感は
                  何年やっても変わりません。自分の名前は残らなくても、仕事は何百年も残る。
                  それがこの仕事の最大の魅力です。
                </p>
              </div>
            </div>

            <div class="recruit-job__slider-wrap" tabindex="0">
              <div class="recruit-job__slider-list">
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿1</span>
                </div>
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿2</span>
                </div>
                <div class="recruit-job__slider-card">
                  <span class="recruit-job__slider-card-label">作業姿3</span>
                </div>
              </div>
            </div>

            <div class="recruit-job__feature-photo">
              <span class="recruit-job__feature-photo-label"
                >大工の仕事<br />（取材後予定）</span
              >
            </div>
          </div>
        </section>

        <!-- ===== 5. 募集要項 ===== -->
        <section
          id="requirements"
          class="recruit-requirements u-bg-primary-light"
        >
          <div class="recruit-requirements__container">
            <h2 class="recruit-requirements__title">募集要項</h2>
            <table class="recruit-requirements__table">
              <tbody>
                {
                  requirementRows.map((row) => (
                    <tr class="recruit-requirements__row">
                      <th class="recruit-requirements__label" scope="row">
                        {row.label}
                      </th>
                      <td class="recruit-requirements__value">
                        {row.value.split("\n").map((line, i, arr) => (
                          <>
                            {line}
                            {i < arr.length - 1 && <br />}
                          </>
                        ))}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <!-- ===== 6. よくある質問 ===== -->
