---
import Layout from "../layouts/Layout.astro";
import ShinwaLogo from "../components/ShinwaLogo.astro";
import Accordion from "../components/Accordion.astro";
import AccordionItem from "../components/AccordionItem.astro";

interface PersonaCard {
  number: string;
  title: string;
  paragraphs: string[];
  mediaLabel?: string;
  mediaPosition?: "start" | "end";
}

const personaCards: PersonaCard[] = [
  {
    number: "01",
    title: "文化や歴史を大切にできる人",
    paragraphs: [
      "社寺建築は、ただ木を組み、建物をつくる仕事ではありません。その土地に生きてきた人々の祈り、風習、時代背景といった「文化の積み重ね」を形にする仕事です。\n社寺には、長い年月をかけて地域の人々が大切に守り続けてきた「想い」が宿っています。その想いを理解し、建物だけでなく、その背後にある精神性や価値観を丁寧に受け取ろうとする姿勢が、私たちの仕事には欠かせません。",
      "歴史を尊び、文化を敬う心を持てる人。\nそして、建築という行為を通して「文化の継承者」としての役割を果たしたいと自然に思える人。\nそんな方と、一緒に未来の社寺をつくっていきたいと考えています。",
    ],
  },
  {
    number: "02",
    title: "誠実で、丁寧な仕事ができる人",
    paragraphs: [
      "社寺建築は、一般的な建築とは異なり、細部に宿る美しさや正確さがそのまま建物の価値になります。1本の木材の選び方、1mmの仕口の調整、柱の立ち心地。それらの積み重ねが、百年後、二百年後まで残り続ける建築物をつくります。だからこそ、この仕事には「ごまかし」や「妥協」がありません。一度手を入れた部分はやり直しが効かないことも多く、一つひとつの判断に高い責任が伴います。",
      "そのため、技術力以上に求められるのは「誠実さ」と「丁寧に向き合う姿勢」です。",
    ],
    mediaLabel: "作業風景2",
    mediaPosition: "start",
  },
  {
    number: "03",
    title: "歴史を未来に届ける責任を楽しめる人",
    paragraphs: [
      "社寺建築に携わるということは、「自分の手でつくったものが、100年後の景色にまだ存在している」という、他の仕事ではなかなか味わえない特別な体験につながります。今この瞬間の仕事が、未来の人々にとっての大切な拠り所となり続けるそれは大きな責任であると同時に、仕事の価値を深く実感できる喜びでもあります。",
      "責任の重さに怯えるのではなく、「未来に届ける文化を自分が担っている」という誇りを持てること。\n目の前の作業の先に、何十年先、何百年先の人々の暮らしや祈りがあることを想像しながら働けること。\nそれが、私たちが求める人物像のひとつです。",
    ],
    mediaLabel: "作業風景2",
    mediaPosition: "end",
  },
];

interface DataItem {
  label: string;
  values: string[];
  layout?: "row";
}

const dataItems: DataItem[] = [
  { label: "平均年齢", values: ["38歳"] },
  {
    label: "スタッフ人数",
    values: ["大工：00人", "監督：00人"],
    layout: "row",
  },
  { label: "資格支援制度", values: ["あり"] },
  { label: "教育制度", values: ["歴史的建築を学ぶ研修が充実"] },
  { label: "社宅制度", values: ["あり"] },
  { label: "技術手当", values: ["あり"] },
];

const requirementRows = [
  { label: "職種", value: "現場監督 / 大工" },
  { label: "雇用形態", value: "正社員" },
  {
    label: "勤務地",
    value: "京都府京都市右京区西院上花田町21（本社）\n現場により異なる",
  },
  { label: "勤務時間", value: "8:00〜17:00（休憩1時間）" },
  {
    label: "休日・休暇",
    value: "日曜・祝日、GW、夏季休暇、年末年始\n年次有給休暇",
  },
  { label: "給与", value: "経験・能力を考慮の上、当社規定により決定" },
  {
    label: "待遇・福利厚生",
    value: "社会保険完備、交通費支給、資格取得支援制度、社宅制度、技術手当",
  },
  {
    label: "応募資格",
    value: "普通自動車免許（AT限定可）\n学歴不問・未経験歓迎",
  },
];

const faqItems = [
  {
    question: "未経験でも応募できますか？",
    answer:
      "はい、未経験の方も歓迎しています。入社後は先輩社員がマンツーマンで指導しますので、安心して技術を身につけていただけます。",
  },
  {
    question: "社寺建築の経験がなくても大丈夫ですか？",
    answer:
      "大丈夫です。一般建築の経験がある方はもちろん、建築業界が初めての方でも基礎から丁寧に教えます。大切なのは学ぶ意欲です。",
  },
  {
    question: "資格取得のサポートはありますか？",
    answer:
      "資格取得支援制度があり、受験費用の補助や勉強時間の確保など、会社としてバックアップしています。一級建築士や施工管理技士などの資格取得を目指せます。",
  },
  {
    question: "勤務地はどこですか？",
    answer:
      "本社は京都市右京区にあります。現場は京都府内を中心に、近畿圏内が主な活動エリアです。遠方の現場の場合は宿泊費を会社が負担します。",
  },
  {
    question: "見学や体験はできますか？",
    answer:
      "はい、現場見学や職場体験を随時受け付けています。実際の仕事の雰囲気を感じていただいてから応募を検討していただけます。お気軽にお問い合わせください。",
  },
];
---

<Layout
  title="採用情報"
  description="伸和建設の採用情報ページです。社寺建築の現場監督・大工を募集しています。"
>
  <main class="recruit">
    <h1 class="sr-only">採用情報</h1>

    <div class="recruit-layout">
      <nav class="recruit-sidebar" aria-label="採用ページナビゲーション"></nav>

      <div class="recruit-main">
        <!-- ===== 1. RECRUIT ヘッダー ===== -->
        <section class="recruit-header u-bg-primary-light u-bg-noise-light">
          <div class="l-container recruit-header__inner">
            <div class="recruit-header__brand">
              <ShinwaLogo width="53" height="52" aria-hidden="true" />
              <div class="recruit-header__brand-text">
                <p class="recruit-header__company-name">伸和建設株式会社</p>
                <span class="recruit-header__separator" aria-hidden="true"
                ></span>
                <p class="recruit-header__company-name-en">
                  SHINWA CONSTRUCTION CO.,LTD
                </p>
              </div>
            </div>
            <p class="recruit-header__eyebrow">RECRUIT</p>
            <p class="recruit-header__lead">伸和建設の採用情報</p>
          </div>
        </section>

        <!-- ===== 2. 求める人物像 ===== -->
        <section class="recruit-persona">
          <div class="recruit-persona__decorative" aria-hidden="true"></div>

          <div class="l-container recruit-persona__container">
            <div class="recruit-persona__content">
              <div class="recruit-persona__intro">
                <div class="recruit-persona__photo">
                  <div class="recruit-persona__photo-visual">
                    <span class="recruit-persona__photo-label"
                      >代表者の写真</span
                    >
                  </div>
                  <div class="recruit-persona__photo-meta">
                    <p class="recruit-persona__author">
                      <span class="recruit-persona__author-role"
                        >代表取締役社長</span
                      >
                      <span class="recruit-persona__author-name">小西 隆夫</span
                      >
                    </p>
                  </div>
                </div>

                <div class="recruit-persona__body">
                  <div class="recruit-persona__heading-group">
                    <h2 class="recruit-persona__title">
                      <span class="recruit-persona__title-line"
                        >技術だけでなく</span
                      >
                      <span
                        class="recruit-persona__title-line recruit-persona__title-line--accent"
                        >人もまたつないでいく</span
                      >
                      <span class="recruit-persona__title-line"
                        >企業でありたい</span
                      >
                    </h2>
                  </div>
                </div>
              </div>

              <div class="recruit-persona__cards">
                <ul class="recruit-persona__list">
                  {
                    personaCards.map((card) => (
                      <li class="recruit-persona__item">
                        <article
                          class:list={[
                            "recruit-persona-card",
                            {
                              "recruit-persona-card--with-media": Boolean(
                                card.mediaLabel,
                              ),
                            },
                            {
                              "recruit-persona-card--media-start":
                                card.mediaPosition === "start",
                            },
                            {
                              "recruit-persona-card--media-end":
                                card.mediaPosition === "end",
                            },
                          ]}
                        >
                          {card.mediaLabel ? (
                            <>
                              <div class="recruit-persona-card__content">
                                <header class="recruit-persona-card__header">
                                  <span class="recruit-persona-card__number">
                                    {card.number}
                                  </span>
                                  <h3 class="recruit-persona-card__title">
                                    {card.title}
                                  </h3>
                                </header>

                                <div class="recruit-persona-card__body">
                                  {card.paragraphs.map((paragraph) => (
                                    <p>
                                      {paragraph
                                        .split("\n")
                                        .map((line, index, lines) => (
                                          <>
                                            {line}
                                            {index < lines.length - 1 && <br />}
                                          </>
                                        ))}
                                    </p>
                                  ))}
                                </div>
                              </div>

                              <footer class="recruit-persona-card__footer">
                                <div class="recruit-persona-card__media">
                                  <span class="recruit-persona-card__media-label">
                                    {card.mediaLabel}
                                  </span>
                                </div>
                              </footer>
                            </>
                          ) : (
                            <>
                              <header class="recruit-persona-card__header">
                                <span class="recruit-persona-card__number">
                                  {card.number}
                                </span>
                                <h3 class="recruit-persona-card__title">
                                  {card.title}
                                </h3>
                              </header>

                              <div class="recruit-persona-card__body">
                                {card.paragraphs.map((paragraph) => (
                                  <p>
                                    {paragraph
                                      .split("\n")
                                      .map((line, index, lines) => (
                                        <>
                                          {line}
                                          {index < lines.length - 1 && <br />}
                                        </>
                                      ))}
                                  </p>
                                ))}
                              </div>
                            </>
                          )}
                        </article>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- ===== 3. 見える化 ===== -->
        <section class="recruit-data">
          <div class="recruit-data__decorative" aria-hidden="true"></div>

          <div class="recruit-data__container">
            <h2 class="recruit-data__title">伸和建設の見える化</h2>

            <div class="recruit-data__card">
              <div class="recruit-data__grid">
                {
                  dataItems.map((item) => (
                    <div class="recruit-data__cell">
                      <p class="recruit-data__cell-label">{item.label}</p>
                      <div
                        class:list={[
                          "recruit-data__cell-value",
                          {
                            "recruit-data__cell-value--row":
                              item.layout === "row",
                          },
                        ]}
                      >
                        {item.values.map((v) => (
                          <p class="recruit-data__cell-text">{v}</p>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <p class="recruit-data__note">※2026年3月時点</p>
          </div>
        </section>

        <!-- ===== 4a. 現場監督 ===== -->
        <section
          class="recruit-job recruit-job--supervisor u-bg-primary-light u-bg-noise-light"
        >
          <div class="recruit-job__deco-band" aria-hidden="true">
            <!-- 伝統工法パターン SVG プレースホルダー -->
          </div>
          <div class="l-container recruit-job__inner">
            <div class="recruit-job__deco-label-wrap" aria-hidden="true">
              <span class="recruit-job__deco-label">現場監督</span>
            </div>
            <h2 class="recruit-job__title">
              千年先も残る建物を<br />いまの自分たちがつくっている
            </h2>

            <div class="recruit-job__profile">
              <div class="recruit-job__profile-photo">
                <span class="recruit-job__profile-photo-label">監督</span>
              </div>
              <div class="recruit-job__profile-info">
                <p class="recruit-job__profile-role">〇〇さん（〇〇歳）</p>
                <p class="recruit-job__profile-name">現場監督（〇〇年入社）</p>
              </div>
            </div>
            <div class="recruit-job__content">
              <div class="recruit-job__video">
                <div
                  class="recruit-job__video-placeholder"
                  aria-label="インタビュー動画"
                >
                  <span class="recruit-job__video-label">Movie</span>
                </div>
              </div>

              <div class="recruit-job__quote">
                <p class="recruit-job__quote-text">
                  社寺建築は一棟一棟が地域の象徴で、歴史そのもの。<br />
                  伸和建設は150年続く技術と実績があり<br />
                  「ここなら本物の仕事ができる」と感じて入社しました。
                </p>
              </div>

              <div class="recruit-job__message">
                <p>
                  図面通りに造るだけではなく、大工や職人さんの技術を最大限に引き出しながら、一つの建物を完成させることにやりがいを感じています。社寺建築は前例のない納まりも多く、現場で考え、相談し、形にしていく。<br
                  />
                  完成したときに職人さんと一緒に見上げる本堂や門は、何度経験しても鳥肌が立ちます。
                </p>
                <p>
                  この仕事は派手ではありませんが、確実に日本の文化を支える仕事だと自負してます。<br
                  />
                  完成した建物を子どもや孫に見せられる。<br />
                  そんな誇りを持てる仕事を、一緒にやりませんか。
                </p>
              </div>
            </div>

            <div class="recruit-job__feature-photo">
              <span class="recruit-job__feature-photo-label"
                >監督の仕事<br />（取材後予定）</span
              >
            </div>
          </div>
        </section>

        <!-- ===== 4b. 大工 ===== -->
        <section
          class="recruit-job recruit-job--carpenter u-bg-primary-light u-bg-noise-light"
        >
          <div class="recruit-job__deco-band" aria-hidden="true">
            <!-- 伝統工法パターン SVG プレースホルダー -->
          </div>
          <div class="l-container recruit-job__inner">
            <div class="recruit-job__deco-label-wrap" aria-hidden="true">
              <span class="recruit-job__deco-label">大工</span>
            </div>
            <h2 class="recruit-job__title">大工の仕事</h2>

            <div class="recruit-job__profile">
              <div class="recruit-job__profile-photo" aria-hidden="true">
                <!-- プロフィール写真プレースホルダー -->
              </div>
              <div class="recruit-job__profile-info">
                <p class="recruit-job__profile-role">大工</p>
                <p class="recruit-job__profile-name">スタッフ名</p>
              </div>
            </div>

            <div class="recruit-job__video">
              <div
                class="recruit-job__video-placeholder"
                aria-label="インタビュー動画"
              >
                <!-- iframe プレースホルダー -->
              </div>
            </div>

            <div class="recruit-job__quote">
              <p class="recruit-job__quote-subtitle">
                木と向き合い、伝統をつなぐ
              </p>
              <p class="recruit-job__quote-text">
                木材を選び、墨付けをし、手刻みで仕口・継手を加工する。社寺建築の大工は、木のクセを読み、先人の知恵を活かしながら一本一本の材に命を吹き込みます。機械では再現できない手仕事の精度と美しさ。何百年も残る建物を、自分の手で作れる誇りがあります。
              </p>
            </div>

            <div class="recruit-job__photos">
              <div class="recruit-job__photo" aria-hidden="true"></div>
              <div class="recruit-job__photo" aria-hidden="true"></div>
              <div class="recruit-job__photo" aria-hidden="true"></div>
              <div
                class="recruit-job__photo recruit-job__photo--wide"
                aria-hidden="true"
              >
              </div>
            </div>
          </div>
        </section>

        <!-- ===== 5. 募集要項 ===== -->
        <section
          class="recruit-requirements u-bg-primary-light u-bg-noise-light"
        >
          <div class="l-container recruit-requirements__inner">
            <h2 class="recruit-requirements__title">募集要項</h2>
            <dl class="recruit-requirements__list">
              {
                requirementRows.map((row) => (
                  <div class="recruit-requirements__row">
                    <dt class="recruit-requirements__label">{row.label}</dt>
                    <dd class="recruit-requirements__value">
                      {row.value.split("\n").map((line, i, arr) => (
                        <>
                          {line}
                          {i < arr.length - 1 && <br />}
                        </>
                      ))}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <!-- ===== 6. よくある質問 ===== -->
        <section class="recruit-faq u-bg-primary-light u-bg-noise-light">
          <div class="l-container recruit-faq__inner">
            <div class="recruit-faq__header">
              <span class="recruit-faq__deco-label" aria-hidden="true">FAQ</span
              >
              <h2 class="recruit-faq__title">よくあるご質問</h2>
            </div>
            <div class="recruit-faq__body">
              <Accordion>
                {
                  faqItems.map((item) => (
                    <AccordionItem title={item.question}>
                      <p class="recruit-faq__answer">{item.answer}</p>
                    </AccordionItem>
                  ))
                }
              </Accordion>
            </div>
          </div>
        </section>

        <!-- ===== 7. エントリー CTA ===== -->
        <section class="recruit-cta u-bg-primary-light u-bg-noise-light">
          <div class="l-container recruit-cta__inner">
            <h2 class="sr-only">エントリー</h2>
            <a class="recruit-cta__button" href="/contact">エントリーする</a>
            <p class="recruit-cta__sub">お待ちしております。</p>
          </div>
        </section>
      </div><!-- /.recruit-main -->
    </div><!-- /.recruit-layout -->
  </main>
</Layout>

<style>
  /* ===== レイアウト: サイドバー + メインコンテンツ ===== */
  .recruit-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    max-width: 120rem;
    margin-inline: auto;
  }

  .recruit-sidebar {
    background-color: var(--color-dark);
    min-height: 0;
  }

  .recruit-main {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .recruit-layout {
      grid-template-columns: 1fr;
    }
  }

  .recruit-persona {
    background-color: var(--color-primary-light);
    display: grid;
  }

  /* l-containerと併記するセクション固有classを追加していく */
  .recruit-persona__decorative,
  .recruit-persona__container {
    grid-area: 1 / 1;
    padding-inline: var(--space-10);
    padding-left: clamp(
      0px,
      calc(6.5625rem * ((100vw - 1024px) / 416)),
      6.5625rem
    );
    box-sizing: content-box;
  }

  @media (max-width: 1024px) {
    .recruit-persona__decorative,
    .recruit-persona__container {
      padding-left: var(--space-10);
      box-sizing: border-box;
    }
  }

  .recruit-persona__decorative {
    background-image: radial-gradient(
      circle at 100% 100%,
      rgba(92, 92, 92, 0.14) 0 1.375rem,
      transparent 1.4375rem
    );
    background-position:
      left top,
      0 0;
    background-repeat: no-repeat, repeat;
    background-size:
      auto,
      var(--space-10) var(--space-10);
  }

  .recruit-persona__container {
    container-type: inline-size;
    container-name: recruit-persona;
    padding-block-start: 4.75rem;
  }

  .recruit-persona__content {
    display: grid;
  }

  .recruit-persona__intro {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 7.1875rem;
    margin: auto;
  }

  .recruit-persona__intro > * {
    min-width: 0;
  }

  .recruit-persona__photo {
    width: 40.625rem;
    aspect-ratio: 650 / 500;
    padding: var(--space-6);
    border: 1px solid var(--color-white);
    border-radius: var(--radius-2xl);
    background-color: var(--color-gray-700);
    display: flex;
    flex-direction: column;
  }

  .recruit-persona__photo-visual {
    flex: 1 1 auto;
    display: grid;
    place-items: center;
  }

  .recruit-persona__photo-label {
    color: var(--color-white);
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    line-height: 1;
    text-align: center;
    text-shadow: none;
  }

  .recruit-persona__photo-meta {
    margin-top: auto;
  }

  .recruit-persona__author {
    color: var(--color-white);
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--text-base);
    font-weight: var(--weight-normal);
    line-height: 1.25;
    display: grid;
    gap: 0.125rem;
    text-shadow: none;
  }

  .recruit-persona__author-role,
  .recruit-persona__author-name {
    display: block;
  }

  .recruit-persona__body {
    display: flex;
    align-items: center;
  }

  .recruit-persona__heading-group {
    display: block;
  }

  .recruit-persona__title {
    color: var(--color-text);
    font-size: var(--fs-750);
    font-weight: var(--weight-semibold);
    line-height: 3.25rem;
    display: flex;
    direction: rtl;
    align-items: flex-start;
    gap: var(--space-3);
    min-block-size: 38.375rem;
    margin: 0;
    text-shadow: none;
  }

  .recruit-persona__title-line {
    display: block;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    text-shadow: none;
  }

  .recruit-persona__title-line--accent {
    color: var(--color-primary);
  }

  .recruit-persona__title-line:nth-child(1) {
    align-self: flex-start;
  }

  .recruit-persona__title-line:nth-child(2) {
    align-self: center;
  }

  .recruit-persona__title-line:nth-child(3) {
    align-self: flex-end;
  }

  .recruit-persona__cards {
    margin-top: 6.25rem;
    margin-inline: auto;
    width: 100%;
  }

  .recruit-persona__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6.25rem;
    width: 100%;
  }

  .recruit-persona__item {
    width: 100%;
    min-width: 0;
  }

  .recruit-persona-card {
    display: grid;
    row-gap: var(--space-5);
    width: 100%;
    min-width: 0;
  }

  .recruit-persona-card__content {
    display: grid;
    align-content: start;
    row-gap: var(--space-5);
    min-width: 0;
  }

  .recruit-persona-card--with-media {
    column-gap: 2.25rem;
    align-items: start;
    row-gap: 0;
    width: 100%;
  }

  .recruit-persona-card--with-media > * {
    min-width: 0;
  }

  .recruit-persona-card--media-start {
    grid-template-columns: 32.375rem 38.75rem;
    grid-template-areas: "footer content";
  }

  .recruit-persona-card--media-end {
    grid-template-columns: 38.75rem 32.375rem;
    grid-template-areas: "content footer";
  }

  .recruit-persona-card__header {
    font-size: var(--fs-600);
    inline-size: min(100%, 20.25em);
    min-height: var(--space-20);
    padding-block: var(--space-3);
    padding-inline: 0.6875rem var(--space-6);
    border: 1px solid var(--color-primary-light);
    border-radius: 0 0 var(--radius-xl) 0;
    background-color: var(--color-gray-500);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .recruit-persona-card--with-media .recruit-persona-card__content {
    grid-area: content;
    width: 100%;
    max-width: 38.75rem;
    min-width: 0;
    align-self: start;
  }

  .recruit-persona__item:nth-child(2) .recruit-persona-card__content {
    margin-block: auto;
  }

  .recruit-persona-card__number {
    flex: 0 0 auto;
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    text-shadow: none;
    margin: 0 0 auto;
    line-height: 1;
  }

  .recruit-persona-card__title {
    flex: 1 1 auto;
    min-width: 0;
    margin: auto 0 0;
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: var(--fs-600);
    font-weight: var(--weight-semibold);
    line-height: 1.1875;
    text-shadow: none;
  }

  .recruit-persona-card__body {
    width: 100%;
    min-width: 0;
    display: grid;
    gap: var(--space-6);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--fs-200);
    line-height: 1.3333333333;
    overflow-wrap: break-word;
  }

  .recruit-persona-card--with-media .recruit-persona-card__body {
    max-width: 35.5625rem;
  }

  .recruit-persona-card__body p {
    margin: 0;
  }

  .recruit-persona-card--with-media .recruit-persona-card__footer {
    grid-area: footer;
  }

  .recruit-persona-card__media {
    width: 100%;
    max-width: 32.375rem;
    min-width: 0;
    aspect-ratio: 518 / 500;
    border: 1px solid var(--color-white);
    border-radius: var(--radius-2xl);
    background-color: var(--color-gray-700);
    display: grid;
    place-items: center;
  }

  .recruit-persona-card__media-label {
    color: var(--color-white);
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    line-height: 1;
    text-align: center;
    text-shadow: none;
  }

  @media (max-width: 425px) {
    .recruit-persona__decorative,
    .recruit-persona__container {
      padding-inline: var(--space-5);
    }
  }

  @media (max-width: 320px) {
    .recruit-persona__decorative,
    .recruit-persona__container {
      padding-inline: var(--space-3);
    }
  }

  @media (max-width: 1440px) {
    .recruit-persona__intro {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      width: 100%;
      gap: var(--space-10);
    }

    .recruit-persona__photo {
      width: min(100%, 40.625rem);
    }

    .recruit-persona__body {
      width: 100%;
      justify-content: flex-start;
    }

    .recruit-persona__heading-group {
      width: 100%;
    }

    .recruit-persona__title {
      display: grid;
      width: 100%;

      max-width: max-content;
      margin-inline: 0;
      direction: ltr;
      line-height: 1.0833333333;
      row-gap: 0.25em;
      min-block-size: 0;
    }

    .recruit-persona__title-line {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
    }

    .recruit-persona__title-line:nth-child(1) {
      align-self: auto;
      justify-self: start;
    }

    .recruit-persona__title-line:nth-child(2) {
      align-self: auto;
      justify-self: center;
    }

    .recruit-persona__title-line:nth-child(3) {
      align-self: auto;
      justify-self: end;
    }
  }

  @container recruit-persona (max-width: 1359px) {
    .recruit-persona-card--with-media {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }

    .recruit-persona-card--media-start {
      grid-template-areas:
        "footer"
        "content";
    }

    .recruit-persona-card--media-end {
      grid-template-areas:
        "content"
        "footer";
    }

    .recruit-persona-card--with-media .recruit-persona-card__content {
      width: 100%;
      max-width: none;
    }

    .recruit-persona-card__body {
      max-width: 35.5625rem;
    }

    .recruit-persona-card__header {
      inline-size: min(100%, 38.75rem);
    }

    .recruit-persona-card__media {
      max-width: 20rem;
    }
  }
  @media (max-width: 425px) {
    .recruit-persona__title {
      font-size: clamp(1.5rem, calc(7.619047619vw - 0.023809524rem), 2rem);
      margin: auto;
    }
  }

  /* ===== 4. 職種紹介（recruit-job） ===== */
  /* Figma: node 58:23316, 1920×3200
     1カラムレイアウト（サイドバーは別フェーズ）。
     スライダー写真は後日実装。 */

  .recruit-job {
    position: relative;
    overflow: hidden;
  }

  /* --- 装飾帯（伝統工法パターン） --- */
  /* Figma: 1920×100, fill #5C5C5C op0.8 */
  .recruit-job__deco-band {
    height: 6.25rem;
    background-color: var(--color-gray-500);
    opacity: 0.8;
  }

  /* --- 縦書きラベル --- */
  /* Figma: 96px W6, white, vertical-rl, 147×431 */
  .recruit-job__deco-label-wrap {
    position: absolute;
    top: var(--space-10);
    right: var(--space-10);
  }

  .recruit-job__deco-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-serif);
    font-size: var(--fs-1000);
    font-weight: var(--weight-semibold);
    line-height: 1;
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .recruit-job__deco-label-wrap {
      display: none;
    }
  }

  /* --- コンテンツ内側 --- */
  .recruit-job__inner {
    position: relative;
    padding-block: var(--space-10) var(--space-16);
    padding-inline: var(--space-10);
  }

  /* --- タイトル --- */
  /* Figma: 36px W6, lh 45px, black, center */
  .recruit-job__title {
    font-family: var(--font-serif);
    font-size: var(--fs-700);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--color-black);
    text-align: center;
    margin: 0 0 var(--space-10);
  }

  /* --- プロフィール --- */
  .recruit-job__profile {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-20);
  }

  /* Figma: 350×500, bg #4B4B4B, border 1px white, r 30px */
  .recruit-job__profile-photo {
    width: min(100%, 21.875rem);
    aspect-ratio: 350 / 500;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-white);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
  }

  /* Figma: Inter/Noto Sans JP 24px 400, white, center */
  .recruit-job__profile-photo-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1;
  }

  /* Figma: Hiragino Mincho W3, 18px, black, center */
  .recruit-job__profile-info {
    text-align: center;
  }

  .recruit-job__profile-role,
  .recruit-job__profile-name {
    font-family: var(--font-serif);
    font-size: var(--fs-200);
    font-weight: var(--weight-normal);
    color: var(--color-black);
    line-height: 1.5;
    margin: 0;
  }

  /* --- コンテンツ揃え（video / quote / message 左端基準） --- */
  .recruit-job__content {
    max-width: 75rem;
    margin-inline: auto;
  }

  /* --- 動画エリア --- */
  /* Figma: 1200×600, bg white, border 1px black, r 30px */
  .recruit-job__video {
    margin-bottom: var(--space-10);
    display: grid;
    justify-content: center;
  }

  .recruit-job__video-placeholder {
    aspect-ratio: 1200 / 600;
    background-color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    place-self: center;
    width: clamp(62.5vw, calc(340px + 300 * ((100vw - 425px) / 599)), 80vw);
    max-width: 1200px;
  }

  /* Figma: Inter 20px 400, #fd0000 */
  .recruit-job__video-label {
    font-family: "Inter", sans-serif;
    font-size: var(--fs-350);
    font-weight: var(--weight-normal);
    color: #fd0000;
    line-height: 1.3;
  }

  /* --- 引用テキスト --- */
  /* Figma: 1000×110, 30px W6, lh 36px, black */
  .recruit-job__quote {
    max-width: 62.5rem;
    margin-bottom: var(--space-10);
  }

  .recruit-job__quote-text {
    font-family: var(--font-serif);
    font-size: var(--fs-500);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-black);
    margin: 0;
  }

  /* --- 本文テキスト --- */
  /* Figma: 914×243, 20px W6, black */
  .recruit-job__message {
    max-width: 57.125rem;
    font-family: var(--font-serif);
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    line-height: 1.75;
    color: var(--color-black);
    margin-left: 3.6vw; /* 動画と引用の左端からずらす（Figmaのガイドラインに基づく） */
    position: relative;
  }

  .recruit-job__message p {
    margin: 0 0 var(--space-6);
  }

  .recruit-job__message p:last-child {
    margin-bottom: 0;
  }

  /* --- 特集写真（Rectangle 90） --- */
  /* Figma: 1210×500, bg #4B4B4B, border 1px black, r 30px */
  .recruit-job__feature-photo {
    margin-top: var(--space-10);
    margin-inline: auto;
    width: 100%;
    max-width: 75.625rem;
    aspect-ratio: 1210 / 500;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
  }

  .recruit-job__feature-photo-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1.5;
  }

  /* ===== 3. 見える化 ===== */
  /* Figma: 1920×630, node 58:23291
     サイズ固定 + MQ管理。200%テキストズーム耐性。
     height固定なし。font-sizeはrem。 */

  .recruit-data {
    background-color: var(--color-primary-light);
    display: grid;
  }

  .recruit-data__decorative,
  .recruit-data__container {
    grid-area: 1 / 1;
  }

  /* Figma sideBox: 350px at 1920px (18.23%) */
  .recruit-data__decorative {
    background-color: var(--color-dark);
    width: 350px;
    justify-self: start;
  }

  .recruit-data__container {
    padding-block: 2.8125rem 1.75rem;
    padding-inline: var(--space-10);
  }

  /* Figma: 40px, Hiragino Mincho Pro W6, black, center */
  .recruit-data__title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: center;
    margin: 0 0 var(--space-6);
    line-height: normal;
  }

  /* Figma: 1136px at 1920px。固定幅 + 中央寄せ。
     bg rgba(68,138,172,0.4), border 1px solid black, rounded 30px */
  .recruit-data__card {
    max-width: 1136px;
    margin-inline: auto;
    background: rgba(68, 138, 172, 0.4);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
  }

  /* 4列グリッド: Figma罫線位置から算出
     columns: 251 / 336 / 273 / 276 (px at 1136px) */
  .recruit-data__grid {
    display: grid;
    grid-template-columns: 251fr 336fr 273fr 276fr;
    /* 横仕切り線: 白3px、左右2%余白 */
    background-image: linear-gradient(
      to right,
      transparent 2%,
      var(--color-white) 2%,
      var(--color-white) 98%,
      transparent 98%
    );
    background-size: 100% 3px;
    background-repeat: no-repeat;
    background-position: center;
  }

  .recruit-data__grid > * {
    min-width: 0;
  }

  .recruit-data__cell {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    justify-items: center;
    padding: var(--space-6) var(--space-4);
  }

  /* --- セル配置 + 縦仕切り線 ---
     縦線: 白3px、セル高さの一部のみ描画
     上段: 24%〜86%  下段: 17%〜85% */

  /* 1: 平均年齢 — 上段 col1 */
  .recruit-data__cell:nth-child(1) {
    grid-column: 1;
    grid-row: 1;
    background-image: linear-gradient(
      to bottom,
      transparent 24%,
      var(--color-white) 24%,
      var(--color-white) 86%,
      transparent 86%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 2: スタッフ人数 — 上段 col2-3 span */
  .recruit-data__cell:nth-child(2) {
    grid-column: 2 / 4;
    grid-row: 1;
    background-image: linear-gradient(
      to bottom,
      transparent 24%,
      var(--color-white) 24%,
      var(--color-white) 86%,
      transparent 86%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 3: 資格支援制度 — 上段 col4 */
  .recruit-data__cell:nth-child(3) {
    grid-column: 4;
    grid-row: 1;
  }

  /* 4: 教育制度 — 下段 col1-2 span */
  .recruit-data__cell:nth-child(4) {
    grid-column: 1 / 3;
    grid-row: 2;
    background-image: linear-gradient(
      to bottom,
      transparent 17%,
      var(--color-white) 17%,
      var(--color-white) 85%,
      transparent 85%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 5: 社宅制度 — 下段 col3 */
  .recruit-data__cell:nth-child(5) {
    grid-column: 3;
    grid-row: 2;
    background-image: linear-gradient(
      to bottom,
      transparent 17%,
      var(--color-white) 17%,
      var(--color-white) 85%,
      transparent 85%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 6: 技術手当 — 下段 col4 */
  .recruit-data__cell:nth-child(6) {
    grid-column: 4;
    grid-row: 2;
  }

  /* --- テキストスタイル --- */

  /* ラベル: Figma 36px, black */
  .recruit-data__cell-label {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: center;
    line-height: normal;
  }

  .recruit-data__cell-value {
    display: grid;
    gap: 0.25em;
    justify-items: center;
  }

  /* スタッフ人数: 大工/監督を横並び */
  .recruit-data__cell-value--row {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
  }

  .recruit-data__cell-value--row > * {
    min-width: 0;
  }

  /* 値: Figma 36px, white */
  .recruit-data__cell-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: var(--weight-semibold);
    color: var(--color-white);
    text-align: center;
    line-height: normal;
  }

  /* 注釈: Figma 18px, black, right-align */
  .recruit-data__note {
    max-width: 1136px;
    margin: var(--space-4) auto 0;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: end;
    line-height: 1.333;
  }

  /* --- MQ: ≤1440px --- */
  @media (max-width: 1440px) {
    .recruit-data__decorative {
      width: 280px;
    }

    .recruit-data__card {
      max-width: 900px;
    }

    .recruit-data__note {
      max-width: 900px;
    }
  }

  /* --- MQ: ≤1024px --- */
  @media (max-width: 1024px) {
    .recruit-data__decorative {
      display: none;
    }

    .recruit-data__card {
      max-width: 100%;
    }

    .recruit-data__note {
      max-width: 100%;
    }

    .recruit-data__cell-label {
      font-size: 1.75rem;
    }

    .recruit-data__cell-text {
      font-size: 1.75rem;
    }

    .recruit-data__title {
      font-size: 2rem;
    }
  }

  /* --- MQ: ≤768px --- */
  @media (max-width: 768px) {
    .recruit-data__grid {
      grid-template-columns: 1fr 1fr;
      background-image: none;
    }

    .recruit-data__cell:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    .recruit-data__cell:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }
    .recruit-data__cell:nth-child(3) {
      grid-column: 1;
      grid-row: 2;
    }
    .recruit-data__cell:nth-child(4) {
      grid-column: 2;
      grid-row: 2;
    }
    .recruit-data__cell:nth-child(5) {
      grid-column: 1;
      grid-row: 3;
    }
    .recruit-data__cell:nth-child(6) {
      grid-column: 2;
      grid-row: 3;
    }

    /* 仕切り線リセット → 2列用ボーダー */
    .recruit-data__cell:nth-child(1),
    .recruit-data__cell:nth-child(2),
    .recruit-data__cell:nth-child(3),
    .recruit-data__cell:nth-child(4),
    .recruit-data__cell:nth-child(5),
    .recruit-data__cell:nth-child(6) {
      background-image: none;
    }

    .recruit-data__cell:nth-child(odd) {
      border-right: 3px solid var(--color-white);
    }

    .recruit-data__cell:nth-child(1),
    .recruit-data__cell:nth-child(2),
    .recruit-data__cell:nth-child(3),
    .recruit-data__cell:nth-child(4) {
      border-bottom: 3px solid var(--color-white);
    }

    /* スタッフ人数: 横並び解除 */
