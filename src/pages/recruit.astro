---
import Layout from "../layouts/Layout.astro";
import RecruitHeader from "../components/sections/recruit/RecruitHeader.astro";
import RecruitPersona from "../components/sections/recruit/RecruitPersona.astro";
import RecruitJob from "../components/sections/recruit/RecruitJob.astro";
import RecruitRequirements from "../components/sections/recruit/RecruitRequirements.astro";
import RecruitFaq from "../components/sections/recruit/RecruitFaq.astro";
import RecruitCta from "../components/sections/recruit/RecruitCta.astro";

const personaCards = [
  {
    number: "01",
    title: "文化や歴史を大切にできる人",
    paragraphs: [
      "社寺建築は、ただ木を組み、建物をつくる仕事ではありません。その土地に生きてきた人々の祈り、風習、時代背景といった「文化の積み重ね」を形にする仕事です。\n社寺には、長い年月をかけて地域の人々が大切に守り続けてきた「想い」が宿っています。その想いを理解し、建物だけでなく、その背後にある精神性や価値観を丁寧に受け取ろうとする姿勢が、私たちの仕事には欠かせません。",
      "歴史を尊び、文化を敬う心を持てる人。\nそして、建築という行為を通して「文化の継承者」としての役割を果たしたいと自然に思える人。\nそんな方と、一緒に未来の社寺をつくっていきたいと考えています。",
    ],
  },
  {
    number: "02",
    title: "誠実で、丁寧な仕事ができる人",
    paragraphs: [
      "社寺建築は、一般的な建築とは異なり、細部に宿る美しさや正確さがそのまま建物の価値になります。1本の木材の選び方、1mmの仕口の調整、柱の立ち心地。それらの積み重ねが、百年後、二百年後まで残り続ける建築物をつくります。だからこそ、この仕事には「ごまかし」や「妥協」がありません。一度手を入れた部分はやり直しが効かないことも多く、一つひとつの判断に高い責任が伴います。",
      "そのため、技術力以上に求められるのは「誠実さ」と「丁寧に向き合う姿勢」です。",
    ],
    mediaSrc: "/images/recruit/persona-carpenter-craft.webp",
    mediaPosition: "start" as const,
  },
  {
    number: "03",
    title: "歴史を未来に届ける責任を楽しめる人",
    paragraphs: [
      "社寺建築に携わるということは、「自分の手でつくったものが、100年後の景色にまだ存在している」という、他の仕事ではなかなか味わえない特別な体験につながります。今この瞬間の仕事が、未来の人々にとっての大切な拠り所となり続けるそれは大きな責任であると同時に、仕事の価値を深く実感できる喜びでもあります。",
      "責任の重さに怯えるのではなく、「未来に届ける文化を自分が担っている」という誇りを持てること。\n目の前の作業の先に、何十年先、何百年先の人々の暮らしや祈りがあることを想像しながら働けること。\nそれが、私たちが求める人物像のひとつです。",
    ],
    mediaSrc: "/images/recruit/persona-site-meeting.webp",
    mediaPosition: "end" as const,
  },
];

const requirementRows = [
  { label: "職種", value: "現場監督 及び 大工" },
  { label: "募集人員", value: "若干名" },
  {
    label: "必要書類",
    value: "履歴書\n卒業（見込）証明書\n成績証明書\n健康診断書",
  },
  { label: "採用条件", value: "初任給当社規定により優遇いたします。" },
  {
    label: "制度",
    value:
      "諸手当通勤費負担\n出張手当\n技術手当\n超過勤務手当\n他昇給年1回賞与年2回勤務地京都\n長期地方勤務有り\n社宅あり（3万円のうち2万円は会社負担）",
  },
  {
    label: "勤務時間現場",
    value: "監督　8:30〜17:30\n大工　8:00〜17:00",
  },
  {
    label: "休日",
    value:
      "休暇隔週週休2日制\n有給休暇（最高20日）\n年末年始\n夏期休暇\n他福利厚生各種社会保険\n社宅制度",
  },
];

const faqItems = [
  {
    question: "Q1. 建築や大工の経験がまったくなくても応募できますか？",
    answer:
      "はい、問題ありません。\n現在活躍している社員の中にも、未経験からスタートした人が多数います。\n基礎から丁寧に教える環境があり、道具の名前や使い方、現場での動き方まで一つずつ身につけていけます。\n「やってみたい」という気持ちがあれば、十分なスタートラインです。",
  },
  {
    question: "Q2. 文系出身でも施工監督になれますか？",
    answer:
      "文系出身で活躍している監督も在籍しています。\n施工監督に必要なのは、専門知識だけでなく「人と現場をまとめる力」です。入社後に建築の基礎知識を学び、現場で経験を積みながら成長できます。",
  },
  {
    question: "Q3. 伝統技術はどのように学びますか？",
    answer:
      "現場でのOJTが基本です。\n先輩職人や監督の仕事を間近で見ながら、少しずつ実践を通して習得していきます。社寺建築は一朝一夕では身につかない技術だからこそ、時間をかけて育てる文化があります。",
  },
  {
    question: "Q4. 女性も働けますか？",
    answer:
      "もちろんです。\n施工監督・設計・事務など、さまざまな職種で女性社員が活躍しています。\n社寺建築という分野だからこそ、丁寧さや気配りが大きな強みになる場面も多くあります。",
  },
  {
    question: "Q5. どんな人がこの会社に向いていますか？",
    answer:
      "・ものづくりが好きな人\n・日本の建築や文化に興味がある人\n・コツコツ続けることが得意な人\n・「仕事に誇りを持ちたい」と思っている人\n特別な才能は必要ありません。続ける意志と、学ぶ姿勢があれば十分です。",
  },
];
---

<Layout
  title="採用情報"
  description="伸和建設の採用情報ページです。社寺建築の現場監督・大工を募集しています。"
>
  <main class="recruit">
    <h1 class="sr-only">採用情報</h1>

    <div class="recruit-layout">
      <nav class="recruit-sidebar" aria-label="採用ページナビゲーション">
        <div class="recruit-sidebar__inner">
          <a class="recruit-sidebar__back" href="/">
            <svg
              class="recruit-sidebar__back-icon"
              viewBox="0 0 18.6 5.83"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M8.1 0L9.757 1.183L5.568 4.167H18.6V5.833H5.568H0L1.1 5L8.1 0Z"
                fill="currentColor"></path>
            </svg>
            本サイトへ
          </a>

          <div class="recruit-sidebar__photo" aria-hidden="true">
            <img src="/images/top-hero.jpeg" alt="" />
          </div>

          <div class="recruit-sidebar__stripes" aria-hidden="true"></div>

          <ul class="recruit-sidebar__menu">
            <li data-target="persona"><a href="#persona">求める人物像</a></li>
            <li data-target="supervisor">
              <a href="#supervisor">監督の仕事紹介</a>
            </li>
            <li data-target="carpenter">
              <a href="#carpenter">大工の仕事紹介</a>
            </li>
            <li data-target="requirements">
              <a href="#requirements">募集要項</a>
            </li>
            <li data-target="faq"><a href="#faq">よくある質問</a></li>
            <li data-target="entry"><a href="#entry">エントリー</a></li>
          </ul>
        </div>
      </nav>

      <div class="recruit-main">
        <!-- ===== 1. RECRUIT ヘッダー ===== -->
        <RecruitHeader />

        <!-- ===== 2. 求める人物像 ===== -->
        <RecruitPersona cards={personaCards} />

        <!-- ===== 4a. 現場監督 ===== -->
        <RecruitJob
          id="supervisor"
          modifier="supervisor"
          decoLabel="現場監督"
          titleHtml="全部を知る、<br>一番現場に近い存在。"
          profilePhotoSrc="/images/recruit/supervisor-profile.webp"
          profileText="現場監督：冨岡さん"
          quoteHtml="何年も残るものを、<br>保存修理は何千年も残ってきているものに自分が入る。"
          messageHtml="<p>監督は、<span class='recruit-job__message-accent'>現場のすべてに関わる仕事</span>です。<br>工程、職人さんとのやり取り、周囲への配慮まで幅広く見ていきます。最初は分からないことばかりですが、その分だけ学びがあります。大切なのは、素直に聞くことと、人との関係を大事にすること。私は、挨拶や一言の気遣いが、現場の空気を明るくすると学びました。少しずつでも理解を深めていける人であれば、必ず成長できる仕事です。</p><p>監督は全工程に関われて毎日が発見でとても充実しています。<br>社寺仏閣に興味があり、これが好きという軸がある人ぜひ一緒に働きませんか。</p>"
          sliderCards={[
            { imageSrc: "/images/recruit/supervisor-work-slide-01.webp" },
            { imageSrc: "/images/recruit/supervisor-work-slide-02.webp" },
            { imageSrc: "/images/recruit/supervisor-work-slide-03.webp" },
          ]}
          featurePhotoTitle="冨岡さんのある日の1日のスケジュール"
          featurePhotoSrc="/images/recruit/supervisor-daily-schedule.png"
          featurePhotoAlt="冨岡さんのある日の1日のスケジュール"
          featurePhotoWidth={4760}
          featurePhotoHeight={3152}
        />

        <!-- ===== 4b. 大工 ===== -->
        <RecruitJob
          id="carpenter"
          modifier="carpenter"
          decoLabel="大工"
          titleHtml="一つひとつの積み重ねが<br>技になる。"
          profilePhotoSrc="/images/recruit/carpenter-profile.webp"
          profileText="大工：川島さん"
          quoteHtml="こだわりを出さないと誰も残したいと思わない。<br>一緒に自分の手で日本の文化を残しませんか。"
          messageHtml="<p>大工の仕事は、<span class='recruit-job__message-accent'>日々の積み重ねによって技術を磨いていく仕事</span>です。</p><p>材料の扱い方や道具の使い方を基礎から学び、少しずつできることを増やしていきます。<br>社寺建築は毎回条件が異なるため、自ら考えながら取り組む姿勢が求められます。難しいことですが腕の見せどころで達成感があります。一朝一夕ではできないからこそやりがいがありますね。</p><p>時間をかけて確かな技術を身につけたい方、私たちと日本の文化を残す仕事をしませんか。</p>"
          sliderCards={[
            { imageSrc: "/images/recruit/carpenter-work-slide-01.webp" },
            { imageSrc: "/images/recruit/carpenter-work-slide-02.webp" },
            { imageSrc: "/images/recruit/carpenter-work-slide-03.webp" },
          ]}
          featurePhotoTitle="川島さんのある日の1日のスケジュール"
          featurePhotoSrc="/images/recruit/carpenter-daily-schedule.png"
          featurePhotoAlt="川島さんのある日の1日のスケジュール"
          featurePhotoWidth={4760}
          featurePhotoHeight={3164}
        />

        <!-- ===== 5. 募集要項 ===== -->
        <RecruitRequirements rows={requirementRows} />

        <!-- ===== 6. よくある質問 ===== -->
        <RecruitFaq items={faqItems} />

        <!-- ===== 7. エントリー CTA ===== -->
        <RecruitCta />
      </div><!-- /.recruit-main -->
    </div><!-- /.recruit-layout -->
  </main>
</Layout>

<style>
  /* ===== 共通ヘッダー・フッター非表示（サイドバーが代替） ===== */
  :global(.site-header),
  :global(.site-drawer),
  :global(.site-footer) {
    display: none;
  }

  /* ===== レイアウト: サイドバー + メインコンテンツ ===== */
  .recruit-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    max-width: 120rem;
    margin-inline: auto;
    container-type: inline-size;
  }

  .recruit-sidebar {
    background-color: var(--color-dark);
    min-height: 0;
    /* gridの子はstretchで親と同じ高さになるため、黒背景はページ全長に伸びる */
  }

  .recruit-sidebar__inner {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    /* 縦に短い画面でメニュー下部が見切れないよう、あふれた分は
       サイドバー内スクロールで到達可能にする（横は装飾はみ出し防止で hidden） */
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* 戻りリンク */
  .recruit-sidebar__back {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-6);
    font-size: var(--text-xl);
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    color: var(--color-white);
    text-decoration: underline;
  }

  .recruit-sidebar__back-icon {
    width: 1.1625rem;
    height: 0.364rem;
    flex-shrink: 0;
  }

  /* 背景画像 — 要望によりW350×H492で固定（2026-06-24）。
     サイドバー幅(320px)を超える分・VP高によっては下部メニューが
     見切れるが、要望どおりサイズを優先する。 */
  .recruit-sidebar__photo {
    width: 21.875rem; /* 350px */
    height: 170px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .recruit-sidebar__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 装飾縦縞 — Figma: 100px, 画像直下 */
  .recruit-sidebar__stripes {
    height: 6.25rem;
    flex-shrink: 0;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.8) 0,
      rgba(255, 255, 255, 0.8) 8px,
      transparent 8px,
      transparent 16px
    );
  }

  /* ナビメニュー */
  .recruit-sidebar__menu {
    list-style: none;
    padding: var(--space-8) var(--space-6);
    margin: 0;
    margin-inline: auto;
    margin-top: clamp(3.125rem, calc(15cqw - 10.375rem), 7.625rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .recruit-sidebar__menu li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .recruit-sidebar__menu li::before {
    content: "";
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background-color: var(--color-gray-500);
    flex-shrink: 0;
  }

  .recruit-sidebar__menu :global(li.is-active)::before {
    background-color: var(--color-white);
  }

  .recruit-sidebar__menu a {
    font-size: var(--text-xl);
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    color: var(--color-white);
    text-decoration: none;
  }

  .recruit-main {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .recruit-layout {
      grid-template-columns: 1fr;
    }

    .recruit-sidebar {
      display: none;
    }
  }

  @media (min-width: 120rem) {
    .recruit-sidebar__inner {
      left: calc((100vw - 120rem) / 2);
    }
  }

  /* 縦に短い画面（低解像度ノート等）向け: 装飾まわりの余白を圧縮して
     下部メニューの見切れを抑える。これでも足りない極端な高さは
     .recruit-sidebar__inner の内部スクロールで到達を担保する。 */
  @media (max-height: 800px) {
    .recruit-sidebar__back {
      padding-block: var(--space-5);
    }

    .recruit-sidebar__stripes {
      height: 3.75rem;
    }

    .recruit-sidebar__menu {
      margin-top: var(--space-4);
      gap: var(--space-4);
    }
  }
</style>

<script>
  const sectionIds = [
    "persona",
    "supervisor",
    "carpenter",
    "requirements",
    "faq",
    "entry",
  ];

  // 各セクションのビューポート内表示ピクセル数を保持
  const visibleHeights = new Map<string, number>();

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        visibleHeights.set(
          entry.target.id,
          entry.isIntersecting ? entry.intersectionRect.height : 0,
        );
      }

      let maxId = "";
      let maxHeight = 0;
      for (const [id, height] of visibleHeights) {
        if (height > maxHeight) {
          maxHeight = height;
          maxId = id;
        }
      }

      document.querySelectorAll(".recruit-sidebar__menu li").forEach((li) => {
        li.classList.toggle(
          "is-active",
          li.getAttribute("data-target") === maxId,
        );
      });
    },
    {
      threshold: Array.from({ length: 21 }, (_, i) => i / 20),
    },
  );

  for (const id of sectionIds) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>
