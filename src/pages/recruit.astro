  .recruit-job__profile-role,
  .recruit-job__profile-name {
    font-family: var(--font-serif);
    font-size: var(--fs-200);
    font-weight: var(--weight-normal);
    color: var(--color-black);
    line-height: 1.5;
    margin: 0;
  }

  /* --- コンテンツ揃え（video / quote / message 左端基準） --- */
  .recruit-job__content {
    max-width: 75rem;
    margin-inline: auto;
  }

  /* --- 動画エリア --- */
  /* Figma: 1200×600, bg white, border 1px black, r 30px */
  .recruit-job__video {
    margin-bottom: var(--space-10);
    display: grid;
    justify-content: center;
  }

  .recruit-job__video-placeholder {
    aspect-ratio: 1200 / 600;
    background-color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    place-self: center;
    width: clamp(62.5vw, calc(340px + 300 * ((100vw - 425px) / 599)), 80vw);
    max-width: 1200px;
  }

  /* Figma: Inter 20px 400, #fd0000 */
  .recruit-job__video-label {
    font-family: "Inter", sans-serif;
    font-size: var(--fs-350);
    font-weight: var(--weight-normal);
    color: #fd0000;
    line-height: 1.3;
  }

  /* --- 引用テキスト --- */
  /* Figma: 1000×110, 30px W6, lh 36px, black */
  .recruit-job__quote {
    max-width: 62.5rem;
    margin-bottom: var(--space-10);
  }

  .recruit-job__quote-text {
    font-family: var(--font-serif);
    font-size: var(--fs-500);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-black);
    margin: 0;
  }

  /* --- 本文テキスト --- */
  /* Figma: 914×243, 20px W6, black */
  .recruit-job__message {
    max-width: 57.125rem;
    font-family: var(--font-serif);
    font-size: var(--fs-350);
    font-weight: var(--weight-semibold);
    line-height: 1.75;
    color: var(--color-black);
    margin-left: 3.6vw; /* 動画と引用の左端からずらす（Figmaのガイドラインに基づく） */
    position: relative;
  }

  .recruit-job__message p {
    margin: 0 0 var(--space-6);
  }

  .recruit-job__message p:last-child {
    margin-bottom: 0;
  }

  /* --- スライダー（Rectangle 62, 65） --- */
  /* Figma: 600×500 cards, bg #4B4B4B, border 1px black, r 30px, gap 10px */
  .recruit-job__slider-wrap {
    --recruit-slider-card-width: clamp(15rem, calc(8.5rem + 32vw), 37.5rem);
    --recruit-slider-gap: 0.625rem;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    margin-top: var(--space-10);
  }

  .recruit-job__slider-wrap::-webkit-scrollbar {
    display: none;
  }

  .recruit-job__slider-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--recruit-slider-card-width);
    gap: var(--recruit-slider-gap);
    min-width: max-content;
    margin: 0;
    padding: 0;
  }

  .recruit-job__slider-card {
    aspect-ratio: 6 / 5;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .recruit-job__slider-card-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1;
    text-shadow: none;
  }

  /* --- 特集写真（Rectangle 90） --- */
  /* Figma: 1210×500, bg #4B4B4B, border 1px black, r 30px */
  .recruit-job__feature-photo {
    margin-top: var(--space-10);
    margin-inline: auto;
    width: 100%;
    max-width: 75.625rem;
    aspect-ratio: 1210 / 500;
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
    display: grid;
    place-items: center;
  }

  .recruit-job__feature-photo-label {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    font-size: var(--fs-400);
    font-weight: var(--weight-normal);
    color: var(--color-white);
    text-align: center;
    line-height: 1.5;
  }

  /* ===== 3. 見える化 ===== */
  /* Figma: 1920×630, node 58:23291
     サイズ固定 + MQ管理。200%テキストズーム耐性。
     height固定なし。font-sizeはrem。 */

  .recruit-data {
    background-color: var(--color-primary-light);
    display: grid;
  }

  .recruit-data__decorative,
  .recruit-data__container {
    grid-area: 1 / 1;
  }

  /* Figma sideBox: 350px at 1920px (18.23%) */
  .recruit-data__decorative {
    background-color: var(--color-dark);
    width: 350px;
    justify-self: start;
  }

  .recruit-data__container {
    padding-block: 2.8125rem 1.75rem;
    padding-inline: var(--space-10);
  }

  /* Figma: 40px, Hiragino Mincho Pro W6, black, center */
  .recruit-data__title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: center;
    margin: 0 0 var(--space-6);
    line-height: normal;
  }

  /* Figma: 1136px at 1920px。固定幅 + 中央寄せ。
     bg rgba(68,138,172,0.4), border 1px solid black, rounded 30px */
  .recruit-data__card {
    max-width: 1136px;
    margin-inline: auto;
    background: rgba(68, 138, 172, 0.4);
    border: 1px solid var(--color-black);
    border-radius: var(--radius-2xl);
  }

  /* 4列グリッド: Figma罫線位置から算出
     columns: 251 / 336 / 273 / 276 (px at 1136px) */
  .recruit-data__grid {
    display: grid;
    grid-template-columns: 251fr 336fr 273fr 276fr;
    /* 横仕切り線: 白3px、左右2%余白 */
    background-image: linear-gradient(
      to right,
      transparent 2%,
      var(--color-white) 2%,
      var(--color-white) 98%,
      transparent 98%
    );
    background-size: 100% 3px;
    background-repeat: no-repeat;
    background-position: center;
  }

  .recruit-data__grid > * {
    min-width: 0;
  }

  .recruit-data__cell {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    justify-items: center;
    padding: var(--space-6) var(--space-4);
  }

  /* --- セル配置 + 縦仕切り線 ---
     縦線: 白3px、セル高さの一部のみ描画
     上段: 24%〜86%  下段: 17%〜85% */

  /* 1: 平均年齢 — 上段 col1 */
  .recruit-data__cell:nth-child(1) {
    grid-column: 1;
    grid-row: 1;
    background-image: linear-gradient(
      to bottom,
      transparent 24%,
      var(--color-white) 24%,
      var(--color-white) 86%,
      transparent 86%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 2: スタッフ人数 — 上段 col2-3 span */
  .recruit-data__cell:nth-child(2) {
    grid-column: 2 / 4;
    grid-row: 1;
    background-image: linear-gradient(
      to bottom,
      transparent 24%,
      var(--color-white) 24%,
      var(--color-white) 86%,
      transparent 86%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 3: 資格支援制度 — 上段 col4 */
  .recruit-data__cell:nth-child(3) {
    grid-column: 4;
    grid-row: 1;
  }

  /* 4: 教育制度 — 下段 col1-2 span */
  .recruit-data__cell:nth-child(4) {
    grid-column: 1 / 3;
    grid-row: 2;
    background-image: linear-gradient(
      to bottom,
      transparent 17%,
      var(--color-white) 17%,
      var(--color-white) 85%,
      transparent 85%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 5: 社宅制度 — 下段 col3 */
  .recruit-data__cell:nth-child(5) {
    grid-column: 3;
    grid-row: 2;
    background-image: linear-gradient(
      to bottom,
      transparent 17%,
      var(--color-white) 17%,
      var(--color-white) 85%,
      transparent 85%
    );
    background-size: 3px 100%;
    background-repeat: no-repeat;
    background-position: right center;
  }

  /* 6: 技術手当 — 下段 col4 */
  .recruit-data__cell:nth-child(6) {
    grid-column: 4;
    grid-row: 2;
  }

  /* --- テキストスタイル --- */

  /* ラベル: Figma 36px, black */
  .recruit-data__cell-label {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: center;
    line-height: normal;
  }

  .recruit-data__cell-value {
    display: grid;
    gap: 0.25em;
    justify-items: center;
  }

  /* スタッフ人数: 大工/監督を横並び */
  .recruit-data__cell-value--row {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
  }

  .recruit-data__cell-value--row > * {
    min-width: 0;
  }

  /* 値: Figma 36px, white */
  .recruit-data__cell-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: var(--weight-semibold);
    color: var(--color-white);
    text-align: center;
    line-height: normal;
  }

  /* 注釈: Figma 18px, black, right-align */
  .recruit-data__note {
    max-width: 1136px;
    margin: var(--space-4) auto 0;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    text-align: end;
    line-height: 1.333;
  }

  /* --- MQ: ≤1440px --- */
  @media (max-width: 1440px) {
    .recruit-data__decorative {
      width: 280px;
    }

    .recruit-data__card {
      max-width: 900px;
    }

    .recruit-data__note {
      max-width: 900px;
    }
  }

  /* --- MQ: ≤1024px --- */
  @media (max-width: 1024px) {
    .recruit-data__decorative {
      display: none;
    }

    .recruit-data__card {
      max-width: 100%;
    }

    .recruit-data__note {
      max-width: 100%;
    }

    .recruit-data__cell-label {
      font-size: 1.75rem;
    }

    .recruit-data__cell-text {
      font-size: 1.75rem;
    }

    .recruit-data__title {
      font-size: 2rem;
    }
  }

  /* --- MQ: ≤768px --- */
  @media (max-width: 768px) {
    .recruit-data__grid {
      grid-template-columns: 1fr 1fr;
      background-image: none;
    }

    .recruit-data__cell:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    .recruit-data__cell:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }
    .recruit-data__cell:nth-child(3) {
      grid-column: 1;
      grid-row: 2;
    }
    .recruit-data__cell:nth-child(4) {
      grid-column: 2;
      grid-row: 2;
    }
    .recruit-data__cell:nth-child(5) {
      grid-column: 1;
      grid-row: 3;
    }
    .recruit-data__cell:nth-child(6) {
      grid-column: 2;
      grid-row: 3;
    }

    /* 仕切り線リセット → 2列用ボーダー */
    .recruit-data__cell:nth-child(1),
    .recruit-data__cell:nth-child(2),
    .recruit-data__cell:nth-child(3),
    .recruit-data__cell:nth-child(4),
    .recruit-data__cell:nth-child(5),
    .recruit-data__cell:nth-child(6) {
      background-image: none;
    }

    .recruit-data__cell:nth-child(odd) {
      border-right: 3px solid var(--color-white);
    }

    .recruit-data__cell:nth-child(1),
    .recruit-data__cell:nth-child(2),
    .recruit-data__cell:nth-child(3),
    .recruit-data__cell:nth-child(4) {
      border-bottom: 3px solid var(--color-white);
    }

    /* スタッフ人数: 横並び解除 */
    .recruit-data__cell-value--row {
      flex-direction: column;
      align-items: center;
      gap: 0.25em;
    }

    .recruit-data__cell-label {
      font-size: 1.5rem;
    }

    .recruit-data__cell-text {
      font-size: 1.5rem;
    }

    .recruit-data__title {
      font-size: 1.75rem;
    }

    .recruit-data__note {
      font-size: 1rem;
    }
  }

  /* --- MQ: ≤425px --- */
  @media (max-width: 425px) {
    .recruit-data__container {
      padding-inline: var(--space-5);
    }

    .recruit-data__grid {
      grid-template-columns: 1fr;
    }

    .recruit-data__cell:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    .recruit-data__cell:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    .recruit-data__cell:nth-child(3) {
      grid-column: 1;
      grid-row: 3;
    }
    .recruit-data__cell:nth-child(4) {
      grid-column: 1;
      grid-row: 4;
    }
    .recruit-data__cell:nth-child(5) {
      grid-column: 1;
      grid-row: 5;
    }
    .recruit-data__cell:nth-child(6) {
      grid-column: 1;
      grid-row: 6;
    }

    .recruit-data__cell:nth-child(odd) {
      border-right: none;
    }

    .recruit-data__cell:nth-child(1),
    .recruit-data__cell:nth-child(2),
    .recruit-data__cell:nth-child(3),
    .recruit-data__cell:nth-child(4),
    .recruit-data__cell:nth-child(5) {
      border-bottom: 3px solid var(--color-white);
    }

    .recruit-data__cell-label {
      font-size: 1.25rem;
    }

    .recruit-data__cell-text {
      font-size: 1.25rem;
    }

    .recruit-data__title {
      font-size: 1.5rem;
    }
  }

  /* --- MQ: ≤320px --- */
  @media (max-width: 320px) {
    .recruit-data__container {
      padding-inline: var(--space-3);
    }
  }

  /* ===== 5. 募集要項（recruit-requirements） ===== */
  /* Figma: 1920×1400, node 58:24101
     左サイドバー350px + テーブル幅900px中央寄せ。
     罫線: 白3px。2列不等分（ラベル約425px / 値約475px）。 */

  .recruit-requirements {
    display: grid;
  }

  .recruit-requirements__decorative,
  .recruit-requirements__container {
    grid-area: 1 / 1;
  }

  /* Figma sideBox: 350px at 1920px */
  .recruit-requirements__decorative {
    background-color: var(--color-dark);
    width: 350px;
    justify-self: start;
  }

  .recruit-requirements__container {
    padding-block: 5rem 5.4375rem;
    padding-inline: var(--space-10);
  }

  /* Figma: 48px W6, #1F1F1F, center */
  .recruit-requirements__title {
    font-family: var(--font-serif);
    font-size: var(--fs-750);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-align: center;
    margin: 0 0 var(--space-8);
    line-height: normal;
  }

  .recruit-requirements__table {
    max-width: 56.25rem;
    margin-inline: auto;
    width: 100%;
    border-collapse: collapse;
  }

  /* Figma: 白3px罫線で区切り */
  .recruit-requirements__row {
    border-top: 3px solid var(--color-white);
  }

  .recruit-requirements__row:last-child {
    border-bottom: 3px solid var(--color-white);
  }

  /* Figma: 20px W6, #000 — 共通 */
  .recruit-requirements__label,
  .recruit-requirements__value {
    font-family: var(--font-serif);
    font-size: var(--fs-300);
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    line-height: var(--leading-normal);
    padding-block: var(--space-5);
    vertical-align: middle;
    text-align: left;
  }

  /* Figma: ラベル列 約425/900 ≒ 47% */
  .recruit-requirements__label {
    width: 47%;
    padding-inline-start: 4.875rem;
  }

  /* --- MQ: ≤1024px --- */
  @media (max-width: 1024px) {
    .recruit-requirements__decorative {
      display: none;
    }

    .recruit-requirements__container {
      padding-block: var(--space-12) var(--space-16);
    }

    .recruit-requirements__label {
      padding-inline-start: var(--space-4);
    }
  }

  /* --- MQ: ≤768px --- */
  @media (max-width: 768px) {
    .recruit-requirements__title {
      font-size: 1.75rem;
    }

    .recruit-requirements__table,
    .recruit-requirements__table tbody,
    .recruit-requirements__row,
    .recruit-requirements__label,
    .recruit-requirements__value {
      display: block;
    }

    .recruit-requirements__label {
      width: auto;
      padding-inline-start: 0;
      padding-block: var(--space-4) var(--space-1);
      font-weight: var(--weight-bold);
    }

    .recruit-requirements__value {
      padding-block: 0 var(--space-4);
    }

    .recruit-requirements__container {
      padding-inline: var(--space-6);
      padding-block: var(--space-10) var(--space-12);
    }
  }

  /* --- MQ: ≤425px --- */
  @media (max-width: 425px) {
    .recruit-requirements__container {
      padding-inline: var(--space-5);
    }
  }

  /* --- MQ: ≤320px --- */
  @media (max-width: 320px) {
    .recruit-requirements__container {
      padding-inline: var(--space-3);
    }
  }

  /* ===== 6. よくある質問（recruit-faq） ===== */
  /* Figma: 1920×1450, node 58:26940
     左サイドバー350px。Q&A中央寄せ。
     質問: 20px W6。回答: 18px W6, 白背景 下角丸50px。
     +アイコン: Inter 40px, primary色。 */

  .recruit-faq {
    background-image: url("/images/recruit/recruit_bg_pattern.svg");
    background-repeat: repeat-y;
    background-position: center top;
    background-size: 100% auto;
    display: grid;
  }

  .recruit-faq__decorative,
  .recruit-faq__container {
    grid-area: 1 / 1;
  }

  .recruit-faq__decorative {
    background-color: var(--color-dark);
    width: 350px;
    justify-self: start;
  }

  .recruit-faq__container {
    position: relative;
    padding-block: 3rem 5rem;
    padding-inline: var(--space-10);
  }

  /* Figma: 見出し左寄せ + 装飾ラベル右端 rotate90° */
  .recruit-faq__header {
    max-width: 55.25rem;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  /* Figma: 48px W6, #1F1F1F */
  .recruit-faq__title {
    font-family: var(--font-serif);
    font-size: var(--fs-750);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    line-height: normal;
    margin: 0;
  }

  /* Figma: 96px W6, #5C5C5C, 右上配置, 縦書き */
  .recruit-faq__deco-label-wrap {
    position: absolute;
    top: var(--space-10);
    right: var(--space-10);
    z-index: 1;
  }

  .recruit-faq__deco-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: var(--font-serif);
    font-size: var(--fs-1000);
    font-weight: var(--weight-semibold);
    line-height: 1;
    color: var(--color-primary-light);
  }

  @media (max-width: 1440px) {
    .recruit-faq__deco-label {
      writing-mode: horizontal-tb;
    }
  }

  @media (max-width: 768px) {
    .recruit-faq__deco-label-wrap {
      display: none;
    }
  }

  .recruit-faq__body {
    position: relative;
    z-index: 2;
    max-width: 55.25rem;
    margin-inline: auto;
  }

  /* --- Accordion上書き（:global） --- */

  .recruit-faq__body :global(.accordion) {
    border-top: none;
    display: grid;
    gap: var(--space-6);
  }

  .recruit-faq__body :global(.accordion-item) {
    list-style: none;
  }

  /* Figma: 質問行 — 20px W6, #000, +アイコン付き */
  .recruit-faq__body :global(.accordion-summary) {
    font-family: var(--font-serif);
    font-size: var(--fs-300);
    font-weight: var(--weight-semibold);
    color: var(--color-black);
    line-height: var(--leading-normal);
    padding: var(--space-3) 0 var(--space-3) 48px;
    display: flex;
    align-items: center;
    gap: 3.875rem;
    cursor: pointer;
    list-style: none;
    border-bottom: 4px solid var(--color-primary);
  }

  .recruit-faq__body :global(.accordion-summary::-webkit-details-marker) {
    display: none;
  }

  .recruit-faq__body :global(.accordion-summary::marker) {
    display: none;
    content: "";
  }

  /* Figma: +アイコン Inter 40px, #448AAC */
  .recruit-faq__body :global(.accordion-summary::before) {
    content: "+";
    flex: 0 0 auto;
    font-family: "Inter", sans-serif;
