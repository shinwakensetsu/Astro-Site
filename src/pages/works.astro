---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
---

<Layout
  title="施工事例"
  description="施工事例ギャラリー — 塔・伽藍・神社・門・鐘楼・収蔵庫・教会"
>
  <main>
    <section class="works-hero u-full-bleed">
      <div class="works-hero__bg" aria-hidden="true"></div>
      <div class="works-hero__tint" aria-hidden="true"></div>
      <div class="l-container works-hero__inner">
        <h1 class="works-hero__title">施工事例</h1>
      </div>
    </section>

    <div class="works-gallery">
      <Gallery />
    </div>
  </main>
</Layout>

<style>
  .works-hero {
    display: grid;
    min-height: clamp(12rem, 25vw, 20rem);
  }

  .works-hero > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .works-hero__bg {
    background: url("/images/works/003_jinja_001heiannaihai-l.jpg") center /
      cover no-repeat;
  }

  .works-hero__tint {
    background: rgba(0, 0, 0, 0.4);
  }

  .works-hero__inner {
    display: flex;
    align-items: center;
    position: relative;
  }

  .works-hero__title {
    font-size: var(--fs-700);
    color: var(--color-white);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .works-gallery {
    padding-block: var(--space-8);
  }
</style>
