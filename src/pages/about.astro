import AboutHistory from "../components/sections/about/AboutHistory.astro";
import AboutCompany from "../components/sections/about/AboutCompany.astro";
import AboutAccess from "../components/sections/about/AboutAccess.astro";

const philosophyLines = [
  "祈りの場をつくり、文化を未来へつなぐ。",
  "私たち伸和建設は、社寺建築を通じて",
  "地域の信仰、歴史、そして日本の木の文化を守り続けてきました。",
  "建物を建てるのではなく、人々の心の拠り所をかたちにすること。",
  "受け継がれてきた技と想いに敬意を払い、",
  "次の時代へと誠実につなぐことが、私たちの使命です。",
];

const guidelines = [
  {
    title: "一、伝統に学び、未来をつくる",
    lines: [
      "先人が残した技法や知恵を深く理解し、",
      "現代の技術や発想と融合させながら、次代に誇れる仕事を行う。",
    ],
  },
  {
    title: "一、祈りと文化への敬意を忘れない",
    lines: [
      "社寺建築は、信仰と歴史の結晶である。",
      "常にその背景にある想いを尊重し、誠実な姿勢で向き合う。",
    ],
  },
  {
    title: "一、素材と技に妥協しない",
    lines: [
      "木を知り、木と向き合い、木を活かす。",
      "見えない部分にこそ手を抜かず、確かな品質を積み重ねる。",
    ],
  },
  {
    title: "一、技を分かち、仲間と高め合う",
    lines: [
      "職人の技は、独占するものではなく、受け継ぐもの。",
      "互いに学び合い、チームとして最高の仕事を目指す。",
    ],
  },
  {
    title: "一、地域に根ざし、信頼に応える",
    lines: [
      "地域とともに歩み、長く愛される建築を残すことで、",
      "社会からの信頼に応え続ける。",
    ],
  },
];

const managementPolicies = [
  {
    title: "社寺建築を核とした専門性の深化",
    lines: [
      "150年にわたり培ってきた社寺建築の技術と実績を基盤に、",
      "他には代えがたい専門性を磨き続ける。",
    ],
  },
  {
    title: "伝統技術の継承と人材育成への投資",
    lines: [
      "次代を担う職人・技術者の育成を最重要課題とし、",
      "技術・知識・心構えを体系的に継承する環境を整える。",
    ],
  },
  {
    title: "品質第一のものづくり",
    lines: [
      "設計・施工・木材加工を一貫して管理し、",
      "細部まで妥協しない高品質な建築を提供する。",
    ],
  },
];

const greetingTitleLines = [
  "残すと決めた人の、次の一手を担う。",
  "その責任と誇りを胸に、私たちはこれからも",
  "真摯にものづくりに向き合ってまいります。",
];

const greetingParagraphs = [
  [
    "社寺建築は、何百年と残っているから価値があるのではなく、「残そう」と思い続けてきた人がいたからこそ、今ここに在り続けています。その想いは時代を越えて受け継がれ、現在は私たちがその一端を担っています。建物は自然や災害、時代の変化の中で常に影響を受けながらも、誰かが守り、手を入れ続けてきたからこそ残ってきました。その積み重ねの延長線上に、自分たちの仕事があります。",
  ],
  [
    "　技術や道具は時代とともに少しずつ進化していきますが、建物に向き合う姿勢や本質的な考え方は変わるものではありません。大切なのは、その時代において最も理にかなった方法を選び、丁寧に形にしていくことです。強さだけを求めれば無骨になり、美しさだけを追えば脆くなる。その両方を成立させるための“ちょうどよい一点”を見極めることが、この仕事の本質だと考えています。",
  ],
  [
    "　また、建物はつくって終わりではありません。その先の何十年、何百年という時間の中で、次の世代がどのように受け取るかまでを想像しながら仕事をする必要があります。",
  ],
  [
    "　だからこそ、目の前の作業一つひとつに妥協はできません。自分たちの手が加わった建物が、未来においても「残す価値がある」と思ってもらえる存在であるように。そうした想いを胸に、日々誠実に向き合い、次の時代へとつないでいく仕事を続けていきます。",
  ],
];

const voiceCards = [
  {
    titleLines: ["人と人をつなぎ、現場を動かす。"],
    bodyLines: [
      "現場監督の仕事は、図面通りに進めるだけではありません。",
      "職人さん同士や関係者の間に立ち、円滑に現場を進めることが役割です。まだ経験は浅いですが、日々新しい発見の連続で、自分の成長を実感しています。",
      "特に大切にしているのは、人との関係性。",
      "挨拶や気遣いを欠かさず、信頼を積み重ねることが現場の質につながると感じています。すべての工程に関われるこの仕事の面白さを感じながら、一人前の監督を目指しています。",
    ],
  },
  {
    titleLines: ["伝統の技を、確かな手で未来へ。"],
    bodyLines: [
      "社寺建築に携わる大工は、長い年月をかけて培われてきた技術を受け継ぎ、次の時代へとつないでいく役割を担います。",
      "原寸図をもとに木材へ墨付けを行い、一本一本丁寧に加工していく作業は、すべてが精度の積み重ねです。やり直しの効かない仕事だからこそ、確認を重ねながら着実に進めることを大切にしています。",
      "自らの手で未来に残る建物をつくるという責任と誇りを胸に、日々仕事に向き合っています。",
    ],
  },
];

