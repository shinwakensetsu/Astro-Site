---

<Layout
  title="私たちについて"
  description="伸和建設の理念、代表メッセージ、沿革、会社概要、アクセスをご紹介します。"
>
  <main class="about">
    <h1 class="sr-only">私たちについて</h1>

    <section id="philosophy" class="about-philosophy u-full-bleed">
      <div class="l-container about-principles__inner about-philosophy__inner">
        <header class="about-principles__header about-philosophy__header">
          <div class="about-principles__header-copy">
            <p class="about-principles__eyebrow about-philosophy__eyebrow">
              Philosophy
            </p>
            <h2 class="about-principles__title about-philosophy__title">
              企業理念
            </h2>
          </div>
        </header>
        <div
          class="about-principles__panel about-philosophy__panel u-bg-noise-dark"
        >
          <p class="about-principles__text about-philosophy__text">
            {
              philosophyLines.map((line) => (
                <span class="about-principles__line about-philosophy__line">
                  {line}
                </span>
              ))
            }
          </p>
        </div>
      </div>
    </section>

    <section id="guidelines" class="about-guidelines u-full-bleed">
      <div class="l-container about-principles__inner about-guidelines__inner">
        <header class="about-principles__header about-guidelines__header">
          <div class="about-principles__header-copy">
            <p class="about-principles__eyebrow about-guidelines__eyebrow">
              Guidelines
            </p>
            <h2 class="about-principles__title about-guidelines__title">
              行動指針
            </h2>
          </div>
        </header>
        <div
          class="about-principles__panel about-guidelines__panel u-bg-noise-dark"
        >
          <ul class="about-principles__list about-guidelines__list">
            {
              guidelines.map((item) => (
                <li class="about-principles__item about-guidelines__item">
                  <span class="about-principles__item-title about-guidelines__item-title">
                    {item.title}
                  </span>
                  <p class="about-principles__item-body about-guidelines__item-body">
                    {item.lines.join("")}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section
      id="management-policy"
      class="about-management-policy u-full-bleed"
    >
      <div
        class="l-container about-principles__inner about-management-policy__inner"
      >
        <header
          class="about-principles__header about-management-policy__header"
        >
          <div class="about-principles__header-copy">
            <p
              class="about-principles__eyebrow about-management-policy__eyebrow"
            >
              Management Policy
            </p>
            <h2 class="about-principles__title about-management-policy__title">
              経営方針
            </h2>
          </div>
        </header>
        <div
          class="about-principles__panel about-management-policy__panel u-bg-noise-dark"
        >
          <ul class="about-principles__list about-management-policy__list">
            {
              managementPolicies.map((item) => (
                <li class="about-principles__item about-management-policy__item">
                  <span class="about-principles__item-title about-management-policy__item-title">
                    {item.title}
                  </span>
                  <p class="about-principles__item-body about-management-policy__item-body">
                    {item.lines.join("")}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="greeting" class="about-greeting u-full-bleed u-bg-dark">
      <div class="l-container about-greeting__inner">
        <div class="about-greeting__hero">
          <div class="about-greeting__hero-image" aria-hidden="true"></div>
          <div class="about-greeting__hero-copy">
            <h2 class="about-greeting__title">
              {
                greetingTitleLines.map((line) => (
                  <span class="about-greeting__title-line">{line}</span>
                ))
              }
            </h2>
            <div class="about-greeting__signature">
              <p class="about-greeting__role">代表取締役社長</p>
              <img
                class="about-greeting__signature-image"
                src="/images/about/konishi-takao.png"
                alt="小西 隆夫"
                width="338"
                height="66"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="about-greeting__message">
          {
            greetingParagraphs.map((paragraph) => (
              <p class="about-greeting__paragraph">
                {paragraph.map((line) => (
                  <span class="about-greeting__paragraph-line">{line}</span>
                ))}
              </p>
            ))
          }
        </div>

        <div class="about-greeting__voices">
          {
            voiceCards.map((card) => (
              <div class="about-greeting__voice">
                <div class="about-greeting__voice-image" aria-hidden="true" />
                <div class="about-greeting__voice-body">
                  <p
                    class="about-greeting__voice-title"
                    data-source-line-count={card.titleLines.length}
                  >
                    {card.titleLines.map((line) => (
                      <span class="about-greeting__voice-title-line">
                        {line}
                      </span>
                    ))}
                  </p>
                  <p class="about-greeting__voice-text">
                    {card.bodyLines.map((line) => (
                      <span class="about-greeting__voice-text-line">
                        {line}
                      </span>
                    ))}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="about-greeting__actions">
          <a
            class="about-greeting__action about-greeting__action--work"
            href="/services">仕事内容へ</a
          >
          <a
            class="about-greeting__action about-greeting__action--recruit"
            href="/recruit">RECRUITサイトへ</a
          >
        </div>
      </div>
    </section>

    <section id="history" class="about-history u-full-bleed u-bg-dark">
      <span class="deco-label about-history__deco-label" aria-hidden="true"
        >HISTORY</span
      >
      <div class="about-history__surface u-bg-primary-light u-bg-noise-light">
        <div class="l-container about-history__inner">
          <div class="about-history__intro">
            <header class="about-history__header">
              <h2 class="about-history__title">沿革</h2>
              <p class="about-history__subtitle">伸和建設の歩み</p>
            </header>
            <p class="about-history__lead">
              1948年に「伸和建設株式会社」として設立した伸和建設。創業から現在まで築いてきた伸和建設の歩みをご紹介します。
            </p>
          </div>

          <div class="about-history__slider-wrap" tabindex="0">
            <ul class="about-history__list">
              {
                historyItems.map((item) => (
                  <li class="about-history__item u-bg-dark u-bg-noise-dark">
                    <div class="about-history__item-body">
                      <div class="about-history__item-heading">
                        <span class="about-history__year">{item.year}</span>
                        <span class="about-history__era">{item.era}</span>
                      </div>
                      <p class="about-history__item-text">
                        {item.lines.join("")}
                      </p>
                    </div>
                    <div class="about-history__item-media" aria-hidden="true" />
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="about-history__scrollbar" aria-hidden="true">
            <div class="about-history__scrollbar-track">
              <div class="about-history__scrollbar-thumb">
                <span class="about-history__scrollbar-thumb-core"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="company" class="about-company u-full-bleed u-bg-dark">
      <div class="l-container about-company__inner">
        <h2 class="about-company__title">会社概要</h2>
        <div class="about-company__table-scroll">
          <table class="about-company__table">
            <tbody>
              {
                companyRows.map((row) => (
                  <tr class="about-company__row">
                    <th class="about-company__label" scope="row">
                      {row.label}
                    </th>
                    <td class="about-company__value">
                      {row.valueLines.map((line) => (
                        <span class="about-company__value-line">{line}</span>
                      ))}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="access" class="about-access u-full-bleed">
      <span class="deco-label about-access__deco-label" aria-hidden="true"
        >ACCESS</span
      >
      <div class="l-container about-access__inner">
        <h2 class="about-access__title">アクセス</h2>
        <div class="about-access__locations">
          {
            locations.map((location, index) => (
              <div class="about-access__location">
                <div class="about-access__location-body">
                  <h3 class="about-access__location-title">{location.name}</h3>
                  <p class="about-access__address">
                    {location.addressLines.map((line) => (
                      <span class="about-access__address-line">{line}</span>
                    ))}
                  </p>
                </div>
                <figure class="about-access__map">
                  <iframe
                    src={
                      index === 0
                        ? "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3000!2d135.7295854!3d35.00814829999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x600107b6ea0c74df%3A0x3f507db37a0b2d0a!2z44CSNjE1LTAwMDcg5Lqs6YO95bqc5Lqs6YO95biC5Y-z5Lqs5Yy66KW_6Zmi5LiK6Iqx55Sw55S677yS77yR!5e0!3m2!1sja!2sjp!4v1773822616709!5m2!1sja!2sjp"
                        : "https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3000!2d135.74291561694665!3d34.87609299394302!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMzTCsDUyJzMzLjkiTiAxMzXCsDQ0JzM4LjkiRQ!5e0!3m2!1sja!2sjp!4v1773823957012!5m2!1sja!2sjp"
                    }
                    title={`${location.name}のGoogleマップ`}
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                </figure>
                <div class="l-container about-access__map-link-container">
                  <a
                    class="arrow-link arrow-link--on-light about-access__map-link"
                    href={location.mapHref}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="arrow-link__text">
                      <span>Google Mapはこちら</span>
                    </span>
                    <IconArrow width="72" height="72" />
                  </a>
                </div>
                <div class="about-access__contacts">
                  <a class="about-access__contact-link" href={location.telHref}>
                    <span class="about-access__contact-label">TEL</span>
                    <span class="about-access__contact-value">
                      {location.telLabel}
                    </span>
                  </a>
                  <a class="about-access__contact-link" href={location.faxHref}>
                    <span class="about-access__contact-label">FAX</span>
                    <span class="about-access__contact-value">
                      {location.faxLabel}
                    </span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const singleSourceVoiceTitles = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.about-greeting__voice-title[data-source-line-count="1"]',
    ),
  );

  if (singleSourceVoiceTitles.length > 0) {
    let rafId = 0;

    const updateVoiceTitleAlignment = () => {
      rafId = 0;

      singleSourceVoiceTitles.forEach((title) => {
        const line = title.querySelector<HTMLElement>(
          ".about-greeting__voice-title-line",
        );

        if (!line) return;

        const lineHeight = Number.parseFloat(
          getComputedStyle(title).lineHeight,
        );
        const renderedHeight = line.getBoundingClientRect().height;
        const isRenderedSingleLine = renderedHeight <= lineHeight * 1.25;

        title.classList.toggle(
          "about-greeting__voice-title--rendered-single",
          isRenderedSingleLine,
        );
      });
    };

    const requestVoiceTitleUpdate = () => {
      if (rafId !== 0) return;
      rafId = window.requestAnimationFrame(updateVoiceTitleAlignment);
    };

    requestVoiceTitleUpdate();
    window.addEventListener("resize", requestVoiceTitleUpdate, {
      passive: true,
    });

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(requestVoiceTitleUpdate);
      singleSourceVoiceTitles.forEach((title) => resizeObserver.observe(title));
    }

    if (document.fonts?.ready) {
      document.fonts.ready.then(requestVoiceTitleUpdate).catch(() => {});
    }
  }

  const historySliderWrap = document.querySelector<HTMLElement>(
    ".about-history__slider-wrap",
  );
  const historyScrollbar = document.querySelector<HTMLElement>(
    ".about-history__scrollbar",
  );
  const historyScrollbarTrack = document.querySelector<HTMLElement>(
    ".about-history__scrollbar-track",
  );
  const historyScrollbarThumb = document.querySelector<HTMLElement>(
    ".about-history__scrollbar-thumb",
  );
  const historyList = historySliderWrap?.querySelector<HTMLElement>(
    ".about-history__list",
  );

  if (
    historySliderWrap &&
    historyScrollbar &&
    historyScrollbarTrack &&
    historyScrollbarThumb
  ) {
    let measureRafId = 0;
    let positionRafId = 0;
    let maxScrollLeft = 0;
    let maxThumbOffset = 0;
    let thumbBaseOffset = 0;
    let thumbOffset = 0;
    let activePointerId: number | null = null;
    let dragStartClientX = 0;
    let dragStartThumbOffset = 0;

    const readCssLengthAsPixels = (
      element: HTMLElement,
      propertyName: string,
    ) => {
      const value = getComputedStyle(element)
        .getPropertyValue(propertyName)
        .trim();

      if (value === "") return 0;

      const probe = document.createElement("div");

      probe.style.position = "absolute";
      probe.style.visibility = "hidden";
      probe.style.pointerEvents = "none";
      probe.style.width = value;

      element.append(probe);

      const pixels = probe.getBoundingClientRect().width;

      probe.remove();

      return Number.isFinite(pixels) ? pixels : 0;
    };

    const getTrackCapWidth = () => {
      return readCssLengthAsPixels(
        historyScrollbarTrack,
        "--about-history-scrollbar-cap-width",
      );
    };

    const getThumbGap = () => {
      return readCssLengthAsPixels(
        historyScrollbarTrack,
        "--about-history-scrollbar-thumb-gap",
      );
    };

    const getTrackCapInset = () => {
      return readCssLengthAsPixels(
        historyScrollbarTrack,
        "--about-history-scrollbar-cap-inset",
      );
    };

    const getPreferredScrollbarWidth = () => {
      return readCssLengthAsPixels(
        historyScrollbar,
        "--about-history-scrollbar-width",
      );
    };

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), max);

    const updateHistoryScrollbarPosition = () => {
      positionRafId = 0;

      const progress =
        maxScrollLeft > 0 ? historySliderWrap.scrollLeft / maxScrollLeft : 0;

      thumbOffset = progress * maxThumbOffset;
      historyScrollbarThumb.style.transform = `translate3d(${thumbBaseOffset + thumbOffset}px, -50%, 0)`;
      historyScrollbar.classList.toggle(
        "about-history__scrollbar--inactive",
        maxScrollLeft <= 0,
      );
    };

    const requestHistoryScrollbarPositionUpdate = () => {
      if (positionRafId !== 0) return;
      positionRafId = window.requestAnimationFrame(
        updateHistoryScrollbarPosition,
      );
    };

    const measureHistoryScrollbar = () => {
      measureRafId = 0;

      const sliderWrapRect = historySliderWrap.getBoundingClientRect();
      const visibleLeft = clamp(sliderWrapRect.left, 0, window.innerWidth);
      const visibleRight = clamp(sliderWrapRect.right, 0, window.innerWidth);
      const visibleWidth = Math.max(visibleRight - visibleLeft, 0);
      const preferredScrollbarWidth = getPreferredScrollbarWidth();
      const resolvedScrollbarWidth = Math.min(
        preferredScrollbarWidth,
        visibleWidth,
      );
      const scrollbarOffset =
        visibleLeft -
        sliderWrapRect.left +
        (visibleWidth - resolvedScrollbarWidth) / 2;

      historyScrollbar.style.width = `${resolvedScrollbarWidth}px`;
      historyScrollbar.style.marginInlineStart = `${Math.max(scrollbarOffset, 0)}px`;

      const trackWidth = historyScrollbarTrack.clientWidth;
      const capWidth = getTrackCapWidth();
      const capInset = getTrackCapInset();
      const thumbGap = getThumbGap();
      const sliderViewportWidth = historySliderWrap.clientWidth;
      const scrollWidth = historySliderWrap.scrollWidth;
      const nextMaxScrollLeft = Math.max(scrollWidth - sliderViewportWidth, 0);
      const thumbWidth = historyScrollbarThumb.offsetWidth;
      const usableTrackWidth = Math.max(
        trackWidth - (capWidth + capInset + thumbGap) * 2 - thumbWidth,
        0,
      );

      maxScrollLeft = nextMaxScrollLeft;
      thumbBaseOffset = capWidth + capInset + thumbGap;
      maxThumbOffset = usableTrackWidth;
      requestHistoryScrollbarPositionUpdate();
    };

    const requestHistoryScrollbarMeasure = () => {
      if (measureRafId !== 0) return;
      measureRafId = window.requestAnimationFrame(measureHistoryScrollbar);
    };

    const endHistoryScrollbarDrag = () => {
      activePointerId = null;
      historyScrollbarThumb.classList.remove("is-dragging");
    };

    const syncHistoryScrollFromThumbOffset = (nextThumbOffset: number) => {
      const clampedThumbOffset = clamp(nextThumbOffset, 0, maxThumbOffset);
      const progress =
        maxThumbOffset > 0 ? clampedThumbOffset / maxThumbOffset : 0;

      historySliderWrap.scrollLeft = progress * maxScrollLeft;
    };

    requestHistoryScrollbarMeasure();

    historySliderWrap.addEventListener(
      "scroll",
      requestHistoryScrollbarPositionUpdate,
      {
        passive: true,
      },
    );
    window.addEventListener("resize", requestHistoryScrollbarMeasure, {
      passive: true,
    });

    historyScrollbarThumb.addEventListener("pointerdown", (event) => {
      if (maxScrollLeft <= 0) return;

      activePointerId = event.pointerId;
      dragStartClientX = event.clientX;
      dragStartThumbOffset = thumbOffset;

      historyScrollbarThumb.setPointerCapture(event.pointerId);
      historyScrollbarThumb.classList.add("is-dragging");
      event.preventDefault();
    });

    historyScrollbarThumb.addEventListener("pointermove", (event) => {
      if (activePointerId !== event.pointerId) return;

      const deltaX = event.clientX - dragStartClientX;

      syncHistoryScrollFromThumbOffset(dragStartThumbOffset + deltaX);
      event.preventDefault();
    });

    historyScrollbarThumb.addEventListener("pointerup", (event) => {
      if (activePointerId !== event.pointerId) return;

      historyScrollbarThumb.releasePointerCapture(event.pointerId);
    });

    historyScrollbarThumb.addEventListener("pointercancel", (event) => {
      if (activePointerId !== event.pointerId) return;

      historyScrollbarThumb.releasePointerCapture(event.pointerId);
    });

    historyScrollbarThumb.addEventListener(
      "lostpointercapture",
      endHistoryScrollbarDrag,
    );

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(requestHistoryScrollbarMeasure);

      resizeObserver.observe(historySliderWrap);
      resizeObserver.observe(historyScrollbarTrack);

      if (historyList) {
        resizeObserver.observe(historyList);
      }
    }

    if (document.fonts?.ready) {
      document.fonts.ready.then(requestHistoryScrollbarMeasure).catch(() => {});
    }
  }
</script>

