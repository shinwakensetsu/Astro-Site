  "私たち伸和建設は、社寺建築を通じて",
  "地域の信仰、歴史、そして日本の木の文化を守り続けてきました。",
  "建物を建てるのではなく、人々の心の拠り所をかたちにすること。",
  "受け継がれてきた技と想いに敬意を払い、",
  "次の時代へと誠実につなぐことが、私たちの使命です。",
];

const guidelines = [
  {
    title: "一、伝統に学び、未来をつくる",
    lines: [
      "先人が残した技法や知恵を深く理解し、",
      "現代の技術や発想と融合させながら、次代に誇れる仕事を行う。",
    ],
  },
  {
    title: "一、祈りと文化への敬意を忘れない",
    lines: [
      "社寺建築は、信仰と歴史の結晶である。",
      "常にその背景にある想いを尊重し、誠実な姿勢で向き合う。",
    ],
  },
  {
    title: "一、素材と技に妥協しない",
    lines: [
      "木を知り、木と向き合い、木を活かす。",
      "見えない部分にこそ手を抜かず、確かな品質を積み重ねる。",
    ],
  },
  {
    title: "一、技を分かち、仲間と高め合う",
    lines: [
      "職人の技は、独占するものではなく、受け継ぐもの。",
      "互いに学び合い、チームとして最高の仕事を目指す。",
    ],
  },
  {
    title: "一、地域に根ざし、信頼に応える",
    lines: [
      "地域とともに歩み、長く愛される建築を残すことで、",
      "社会からの信頼に応え続ける。",
