---

<Layout
  title="私たちについて"
  description="伸和建設の理念、代表メッセージ、沿革、会社概要、アクセスをご紹介します。"
>
  <main class="about">
    <h1 class="sr-only">私たちについて</h1>

    <AboutPrinciples
      philosophyLines={philosophyLines}
      guidelines={guidelines}
      managementPolicies={managementPolicies}
    />

    <AboutGreeting
      titleLines={greetingTitleLines}
      paragraphs={greetingParagraphs}
      voiceCards={voiceCards}
    />

    <AboutHistory items={historyItems} />

    <AboutCompany rows={companyRows} />

    <AboutAccess locations={locations} />
  </main>
</Layout>

<style>
  .about {
    --about-section-gap-half: 45px;
    --section-spacing-block: var(--about-section-gap-half);
    --about-deco-label-lock-width: 1920px;
    --about-deco-label-inline-start-base: clamp(
      0rem,
      calc(-47.9091rem + 45.0909vw),
      6.2rem
    );
    --about-deco-label-inline-start: max(
      var(--about-deco-label-inline-start-base),
      calc((100vw - var(--about-deco-label-lock-width)) / 2 + 6.2rem)
    );
    --about-principles-eyebrow-size: var(--fs-900);
    --about-principles-title-size: var(--fs-400);
    --about-principles-body-size: var(--fs-400);
    --about-principles-header-max-inline-size: 90%;
    --about-principles-header-line-max-width: 200px;
    --about-principles-header-line-gap: clamp(
      var(--space-4),
      4vw,
      var(--space-10)
    );
    --about-principles-section-inline-padding: clamp(
      var(--space-6),
      5.56vw,
      5rem
    );
    --about-principles-panel-inline-padding: clamp(
      var(--space-6),
      10.42vw,
      8.975rem
    );
    --about-greeting-section-inline-padding: clamp(
      var(--space-6),
      5.56vw,
      5rem
    );
    --about-greeting-section-block-padding: clamp(4rem, 8vw, 7rem);
    --about-greeting-section-gap: clamp(3rem, 7vw, 5.5rem);
    --about-greeting-actions-spacing: 4.6875rem;
    --about-greeting-title-size: var(--fs-600);
    --about-greeting-title-accent-size: var(--fs-600);
    --about-greeting-role-size: var(--fs-500);
    --about-greeting-body-size: clamp(1rem, 1.4vw, 1.125rem);
    --about-greeting-card-title-size: var(--fs-400);
    --about-greeting-action-size: clamp(1rem, 1.8vw, 1.25rem);
    --about-greeting-border: rgba(255, 255, 255, 0.16);
    --about-greeting-surface: rgba(255, 255, 255, 0.06);
    --about-company-title-size: 3rem;
    --about-history-section-inline-padding: clamp(var(--space-6), 5.56vw, 5rem);
    --about-history-section-inline-padding-left: 6.875rem;
    --about-history-title-size: 3rem;
    --about-history-subtitle-size: var(--fs-500);
    --about-history-lead-size: var(--fs-300);
    --about-history-year-size: 2.1875rem;
    --about-history-era-size: var(--fs-300);
    --about-history-body-size: var(--fs-300);
    --about-history-item-text-size: 1rem;
    --about-history-card-width: 18.75rem;
    --about-history-card-height: 28.125rem;
    --about-history-media-width: 15.625rem;
    --about-history-media-height: 12.1875rem;
    --about-history-media-gap: 0.625rem;
    --about-history-scrollbar-gap: clamp(1rem, 2vw, 1.5rem);
    --about-history-scrollbar-width: 74.4791667vw;
    --about-history-scrollbar-height: 1.125rem;
    --about-history-scrollbar-thumb-min-width: 1.5rem;
    --about-history-scrollbar-cap-width: 0.9375rem;
    --about-history-scrollbar-cap-inset: 4px;
    --about-history-scrollbar-line-thickness: 2px;
    --about-history-scrollbar-thumb-gap: 2px;
    --about-access-title-size: 3rem;
    --about-access-location-size: 1.125rem;
    --about-access-contact-size: 1.25rem;
    --about-access-card-width: 56.25rem;
    --about-access-content-width: 48.75rem;
    --about-access-contact-height: 5.75rem;
    --about-access-section-inline-padding: clamp(var(--space-6), 5.56vw, 5rem);
  }

  @media (max-width: 1024px) {
    .about {
      --about-history-section-inline-padding-left: var(
        --about-history-section-inline-padding
      );
    }
  }
</style>
