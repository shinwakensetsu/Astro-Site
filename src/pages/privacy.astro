---
// src/pages/privacy.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="個人情報保護方針"
  description="個人情報保護方針についてのページです。"
>
  <!-- ===== 1. ページヘッダー ===== -->
  <section class="privacy-header">
    <div class="container--layout privacy-header__inner"></div>
  </section>

  <!-- ===== 2. 方針内容 ===== -->
  <section class="privacy-content">
    <div class="container--layout privacy-content__inner"></div>
  </section>

  <!-- ===== 3. お問い合わせ先 ===== -->
  <section class="privacy-contact">
    <div class="container--layout privacy-contact__inner"></div>
  </section>
</Layout>

<style>
  .privacy-header__inner,
  .privacy-content__inner,
  .privacy-contact__inner {
    padding-block: var(--space-16);
  }
</style>
