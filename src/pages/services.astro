import ServicesKodawari from "../components/sections/services/ServicesKodawari.astro";
import ServicesGallery from "../components/sections/services/ServicesGallery.astro";
import ServicesFlow from "../components/sections/services/ServicesFlow.astro";
import ServicesDiary from "../components/sections/services/ServicesDiary.astro";

const serviceItems = [
  {
    label: "社寺建築の設計・施工",
