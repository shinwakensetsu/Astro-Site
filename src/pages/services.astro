    --services-kodawari-card-radius: 50px;
    --services-kodawari-display-left: 1.4375rem;
    --services-kodawari-display-top: 2.5625rem;
    --services-kodawari-display-width: 12.0625rem;
    --services-kodawari-display-height: 14.5rem;
    --services-kodawari-display-size: 6rem;
    --services-kodawari-content-top: 7.8125rem;
    --services-kodawari-display-safe-space: 0px;
    --services-kodawari-title-column-width: 1.875rem;
    --services-kodawari-title-card-gap: 1.5625rem;
    --services-kodawari-card-width: 62.5rem;
    --services-kodawari-card-height: 31.25rem;
    --services-kodawari-card-image-left: 53%;
    --services-kodawari-sub-top: 2rem;
    --services-kodawari-sub-left: 0.75rem;
    --services-kodawari-sub-width: 60%;
    --services-kodawari-text-bottom: 0.375rem;
    --services-kodawari-text-right: 0.375rem;
    --services-kodawari-text-left: 52%;
    --services-kodawari-text-width: auto;
    --services-flow-content-inline: var(--services-section-inline-padding);
    --services-flow-display-safe-space: var(
