    accent: "継承",
    sub: "伝統的な宮大工技術や社寺建築様式を重視",
    text: "後世に伝えるべき技を守ることを社是としている点が大きな特徴です。これには木組みや継手／仕口など、古来の工法を尊重する姿勢が含まれます。",
    mediaLabel: "作業風景１",
    imageAlt: "伝統技術の継承 — 作業風景",
    cardSide: "right" as const,
  },
  {
    title: "歴史と文化への",
    accent: "敬意",
    sub: "単なる建築施工ではなく、地域の信仰・文化・歴史そのものを支えるという視点での仕事が基本です。",
    text: "建物ではなく「祈りの場」をつくるという意識が従業員・職人に共有されています。",
    mediaLabel: "作業風景2",
    imageAlt: "歴史と文化への敬意 — 作業風景",
    cardSide: "left" as const,
  },
  {
    title: "施工の",
    accent: "精度",
    sub: "造作や型板作成など精密な作業により、細部の納まりや木組みの強度や見栄えにこだわりがあります。",
    text: "耐久力・美しさともに誇れる精度で施工",
    mediaLabel: "作業風景3",
    imageAlt: "施工の精度 — 作業風景",
    cardSide: "left" as const,
  },
];

const galleryItems = [
  {
    alt: "成願寺 多宝塔",
    caption: "成願寺　多宝塔",
    detailLines: ["新築　京都市　平成14年"],
    imageSrc: "/images/works/001_tou_005zentsuuji-l.jpg",
    captionWidth: "14rem",
  },
  {
    alt: "護国寺 本堂",
    caption: "護国寺　本堂",
    detailLines: ["新築　室蘭市　昭和40年"],
    imageSrc: "/images/works/002_garan_012gokokuji-l.jpg",
    captionWidth: "14rem",
  },
  {
    alt: "屋島神社 社殿",
    caption: "屋島神社　社殿",
    detailLines: ["新築　高松市　昭和49年"],
    imageSrc: "/images/works/003_jinja_013hirano-l.jpg",
    captionWidth: "14rem",
  },
  {
    alt: "大本山広隆寺 仁王門",
    caption: "大本山広隆寺　仁王門",
    detailLines: ["屋根葺替修理　京都市　昭和55年"],
    imageSrc: "/images/works/004_mon_003kouryuji-l.jpg",
    captionWidth: "19rem",
  },
  {
