const serviceItems = [
  {
    label: "社寺建築の設計・施工",
    desc: "　伸和建設は、神社・寺院などの社寺建築を専門とする建設会社であり、150年以上の歴史を持つ伝統建築の施工実績があります。伝統的な技術と生産体制を重視し、現代のニーズに合わせながらも古来からの技法を守っています。",
    labelWidth: "22.8125rem",
