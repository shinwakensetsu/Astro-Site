---
// src/pages/services.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="仕事内容" description="仕事内容のご紹介ページです。">
  <!-- ===== 1. ページヘッダー ===== -->
  <section class="services-header">
    <div class="container--layout services-header__inner"></div>
  </section>

  <!-- ===== 2. 仕事内容 ===== -->
  <section class="services-content">
    <div class="container--layout services-content__inner"></div>
  </section>

  <!-- ===== 3. お問い合わせ ===== -->
  <section class="services-cta">
    <div class="container--layout services-cta__inner"></div>
  </section>
</Layout>

<style>
  .services-header__inner,
  .services-content__inner,
  .services-cta__inner {
    padding-block: var(--space-16);
  }
</style>
