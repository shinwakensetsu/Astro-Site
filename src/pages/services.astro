---
import { getDiary } from "../lib/microcms";
import Layout from "../layouts/Layout.astro";
import { formatDateSlash } from "../utils/formatters";

const serviceItems = [
  {
    label: "社寺建築の設計・施工",
    desc: "　伸和建設は、神社・寺院などの社寺建築を専門とする建設会社であり、150年以上の歴史を持つ伝統建築の施工実績があります。伝統的な技術と生産体制を重視し、現代のニーズに合わせながらも古来からの技法を守っています。",
    labelWidth: "22.8125rem",
  },
  {
    label: "一般建築・設計施工",
    desc: "社寺建築だけでなく、一般建築の設計施工も手掛け、建築士事務所登録を持つ総合建設業としての対応力を有しています。",
    labelWidth: "22.8125rem",
  },
  {
    label: "木材加工・専門工",
    desc: "自社工作所を有し、木材加工・造作など伝統技術を活かした作業を内製することで精度の高い仕上りが可能です。",
    labelWidth: "22.8125rem",
  },
  {
    label: "文化財・歴史的価値の建築物",
    desc: "多くの歴史的社寺建築の実績があり、伝統技術の継承と後世への伝播に責任を持つ仕事です。",
    labelWidth: "28.0625rem",
