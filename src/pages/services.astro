    --services-flow-content-top: 7.8125rem;
    --services-flow-intro-gap: var(--space-10);
    --services-flow-card-gap: 5rem;
    --services-flow-intro-width: 44.125rem;
    --services-flow-diagram-width: 33.125rem;
    --services-flow-row-gap: var(--space-10);
    --services-flow-mobile-row-gap: var(--space-6);
    --services-flow-card-width: 40.625rem;
    --services-flow-card-radius: 50px;
    --services-diary-content-inline: var(--services-section-inline-padding);
    --services-diary-display-safe-space: var(
      --services-section-display-title-safe-space
    );
    --services-diary-content-top: 7.8125rem;
    --services-section-display-title-margin-stacked: 0 0 0
      var(--services-section-inline-padding);
