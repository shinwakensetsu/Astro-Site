---
import "../styles/global.css";
import "../styles/base.css";
import konkaikoumyoujiImage from "../assets/img/konkaikoumyouji.webp";
import shinwaConstructionLogo from "../assets/SVG/shinwa-construction-logo.svg";
import Sitemap from "../components/Sitemap.astro";

// Site configuration constants
const SITE_NAME = "サイト名";
const SITE_URL = import.meta.env.SITE_URL || "https://example.com";
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.png`;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  url?: string;
}

const {
  title = SITE_NAME,
  description = "microCMSと連携したAstroベースのウェブサイト",
  image = DEFAULT_OG_IMAGE,
  type = "website",
  url = Astro.url.href,
} = Astro.props;

// Construct full title with site name
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// Ensure canonical URL uses the site URL
const canonicalUrl = url.startsWith("http") ? url : `${SITE_URL}${url}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo" aria-label="トップページへ戻る"
          >ロゴ</a
        >

        <div class="site-header__controls">
          <nav class="site-header__nav" aria-label="グローバルナビゲーション">
            <ul class="site-header__nav-list">
              <li><a href="/news">お知らせ</a></li>
              <li><a href="/about">私たちについて</a></li>
              <li><a href="/services">仕事内容</a></li>
              <li><a href="/works">施工事例</a></li>
              <li><a href="/recruit">RECRUIT</a></li>
              <li><a href="/contact">お問い合わせ</a></li>
            </ul>
          </nav>

          <button
            type="button"
            class="site-header__menu-button js-menu-toggle"
            aria-label="メニューを開閉"
            aria-expanded="false"
            aria-controls="global-drawer"
          >
            <span class="site-header__menu-line"></span>
            <span class="site-header__menu-line"></span>
          </button>
        </div>
      </div>

      <div id="global-drawer" class="site-drawer" hidden aria-hidden="true">
        <button
          type="button"
          class="site-drawer__backdrop js-drawer-close"
          aria-label="メニューを閉じる"></button>

        <div
          class="site-drawer__panel"
          role="dialog"
          aria-modal="true"
          tabindex="-1"
        >
          <div class="site-drawer__inner">
            <div
              class="site-drawer__image u-radius-20"
              style={`background-image: url(${konkaikoumyoujiImage.src});`}
              aria-hidden="true"
            >
            </div>

            <Sitemap variant="drawer" ariaLabel="ドロワーメニュー" />
          </div>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__container site-footer__container--1">
          <div class="site-footer__heading-row">
            <h2 class="site-footer__title">伸和建設株式会社</h2>
            <a href="" class="site-footer__instagram" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1.25"></circle>
              </svg>
            </a>
          </div>

          <hr class="site-footer__separator" />

          <Sitemap variant="footer" ariaLabel="フッターサイトマップ" />
        </div>

        <div class="site-footer__container site-footer__container--2">
          <div
            class="site-footer__image"
            style={`background-image: url(${konkaikoumyoujiImage.src});`}
            aria-hidden="true"
          >
          </div>
        </div>

        <div class="site-footer__container site-footer__container--3">
          <table class="site-footer__contact-table" aria-label="連絡先">
            <tbody>
              <tr>
                <th scope="row">Mail</th>
                <td
                  ><a href="mailto:soumu@sinwakensetu.co.jp"
                    >soumu@sinwakensetu.co.jp</a
                  ></td
                >
              </tr>
              <tr>
                <th scope="row">TEL</th>
                <td><a href="tel:0753110054">075-311-0054</a></td>
              </tr>
              <tr>
                <th scope="row">FAX</th>
                <td><a href="tel:0753220152">075-322-0152</a></td>
              </tr>
            </tbody>
          </table>
          <p class="site-footer__address">
            〒615-0007　京都市右京区西院上花田町21
          </p>
        </div>

        <div class="site-footer__container site-footer__container--4">
          <img
            src={shinwaConstructionLogo.src}
            alt="伸和建設株式会社"
            class="site-footer__brand-logo"
          />
        </div>
      </div>

      <div class="site-footer__copyright">
        Copyright(C) SHINWA CONSTRUCTION CO.
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    z-index: 200;
    width: 100%;
    min-height: var(--header-height);
    background-color: var(--color-header-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: var(--header-height);
    padding-inline-start: clamp(1rem, 3vw, 1.875rem);
    padding-inline-end: clamp(1rem, 8vw, 7.5rem);
  }

  .site-header__logo {
    width: 18.875rem;
    height: 3.625rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
    border: 1px solid var(--color-white);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1em;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: 1em;
    list-style: none;
  }

  .site-header__nav-list a {
    font-family:
      "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Shippori Mincho", serif;
    color: var(--color-white);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .site-header__menu-button {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-white);
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-white);
  }

  .site-header__menu-line {
    display: block;
    width: 1.75rem;
    height: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-normal) var(--easing-default),
      opacity var(--duration-normal) var(--easing-default);
    transform-origin: center;
  }

  .site-header__menu-button.is-open .site-header__menu-line:nth-child(1) {
    transform: translateY(0.375rem) rotate(45deg);
  }

  .site-header__menu-button.is-open .site-header__menu-line:nth-child(2) {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  .site-drawer {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--easing-default);
  }

  .site-drawer.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .site-drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(31 31 31 / 0.55);
  }

  .site-drawer__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-gray-300);
  }

  .site-drawer__inner {
    width: 100%;
    padding: 2.5rem clamp(1rem, 3vw, 1.875rem) 3rem clamp(1rem, 8vw, 7.5rem);
    display: grid;
    grid-template-columns: 39.9375rem minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .site-drawer__image {
    width: 39.9375rem;
    max-width: 100%;
    height: 41.625rem;
    border: 1px solid var(--color-gray-400);
    background-color: var(--color-gray-300);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  .site-footer {
    background-color: var(--color-header-bg);
    padding: 3rem 0 0;
  }

  .site-footer__inner {
    width: auto;
    margin-inline: 120px;
    display: grid;
    grid-template-columns: minmax(700px, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "container1 container2"
      "container3 container4";
    gap: 2.5rem;
    align-items: start;
    padding-bottom: 20px;
  }

  .site-footer__container--1 {
    grid-area: container1;
    display: flex;
    flex-direction: column;
    min-height: 43.75rem;
  }

  .site-footer__heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer__title {
    color: var(--color-white);
    font-size: 1.5rem;
    font-weight: var(--weight-bold);
    line-height: 1.2;
  }

  .site-footer__instagram {
    width: 2.8125rem;
    height: 2.8125rem;
    color: var(--color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .site-footer__instagram svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .site-footer__separator {
    border: none;
    border-top: 1px solid var(--color-gray-400);
    margin-top: 10px;
    margin-bottom: 20px;
  }

  .site-footer__contact-table {
    margin-top: 0;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    color: var(--color-white);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .site-footer__contact-table th,
  .site-footer__contact-table td {
    border: none;
    padding: 0.2rem 0;
    text-align: left;
    vertical-align: top;
    font-weight: var(--weight-normal);
  }

  .site-footer__contact-table td {
    font-size: 1.625rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .site-footer__contact-table a {
    display: block;
    color: inherit;
    text-decoration: none;
    line-height: 1.2;
    text-align: left;
    vertical-align: top;
  }

  .site-footer__contact-table th {
    width: 4rem;
  }

  .site-footer__container--2 {
    grid-area: container2;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .site-footer__image {
    width: min(100%, 500px);
    max-width: 500px;
    min-width: 0;
    aspect-ratio: 5 / 7;
    height: auto;
    background-repeat: no-repeat;
    background-position: top right;
    background-size: cover;
    border-bottom-left-radius: 50%;
    overflow: hidden;
  }

  .site-footer__container--3 {
    grid-area: container3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    align-self: start;
    min-height: 220px;
  }

  .site-footer__address {
    margin-top: auto;
    color: var(--color-white);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .site-footer__container--4 {
    grid-area: container4;
    justify-self: end;
    align-self: end;
    width: 136px;
  }

  .site-footer__brand-logo {
    width: 136px;
    aspect-ratio: 1;
    height: auto;
    object-fit: contain;
  }

  @supports not (aspect-ratio: 1) {
    .site-footer__brand-logo {
      height: 134px;
    }
  }

  :global(body.is-drawer-open) {
    overflow: hidden;
  }

  .site-footer__copyright {
    height: 20px;
    background-color: #fff;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
  }

  @media (max-width: 1440px) {
    .site-header__inner {
      padding-inline-start: 1rem;
      padding-inline-end: 1rem;
    }

    .site-header__logo {
      width: min(18.875rem, 52vw);
    }

    .site-header__nav-list {
      gap: 0.75em;
    }

    .site-header__nav-list a {
      font-size: 1.25rem;
    }

    .site-drawer__inner {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem 2rem;
    }

    .site-drawer__image {
      width: 100%;
      height: min(41.625rem, 60vh);
    }

    .site-footer {
      padding: 2rem 0 0;
    }

    .site-footer__inner {
      margin-inline: 1rem;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "container1 container1"
        "container3 container2"
        "container4 container4";
      gap: 1.5rem;
      align-items: start;
    }

    .site-footer__container--1 {
      min-height: auto;
    }

    .site-footer__image {
      width: min(100%, 26rem);
      height: 220px;
    }

    .site-footer__container--4 {
      justify-self: end;
    }

    .site-footer__container--3 {
      min-height: 220px;
      gap: 1rem;
    }
  }

  @media (max-width: 425px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "container1"
        "container2"
        "container3"
        "container4";
    }

    .site-footer__container--4 {
      justify-self: start;
    }

    .site-footer__container--3 {
      align-self: start;
    }

    .site-footer__contact-table {
      font-size: 1.125rem;
    }

    .site-footer__address {
      font-size: 1.125rem;
    }

    .site-footer__image {
      height: auto;
      min-height: 0;
      aspect-ratio: 5 / 7;
    }
  }

  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }

    .site-footer__inner {
      margin-inline: 1rem;
    }

    .site-footer__contact-table th {
      width: 3.25rem;
    }

    .site-footer__contact-table td {
      font-size: 1.125rem;
    }
  }
</style>

<script>
  const menuButton = document.querySelector(".js-menu-toggle");
  const drawer = document.getElementById("global-drawer");
  const closeTriggers =
    document.querySelectorAll<HTMLElement>(".js-drawer-close");
  const DRAWER_FADE_MS = 250;

  const getFocusableElements = (container: ParentNode): HTMLElement[] => {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((element) => !element.hasAttribute("hidden"));
  };

  const openDrawer = () => {
    if (
      !(menuButton instanceof HTMLButtonElement) ||
      !(drawer instanceof HTMLDivElement)
    )
      return;

    menuButton.classList.add("is-open");
    menuButton.setAttribute("aria-expanded", "true");
    drawer.hidden = false;
    drawer.setAttribute("aria-hidden", "false");
    document.body.classList.add("is-drawer-open");
    requestAnimationFrame(() => {
      drawer.classList.add("is-visible");
    });

    const focusable = getFocusableElements(drawer);
    if (focusable.length > 0) {
      focusable[0].focus();
    }
  };

  const closeDrawer = () => {
    if (
      !(menuButton instanceof HTMLButtonElement) ||
      !(drawer instanceof HTMLDivElement)
    )
      return;
    if (drawer.hidden) return;

    menuButton.classList.remove("is-open");
    menuButton.setAttribute("aria-expanded", "false");
    drawer.classList.remove("is-visible");
    drawer.setAttribute("aria-hidden", "true");
    document.body.classList.remove("is-drawer-open");

    window.setTimeout(() => {
      drawer.hidden = true;
      menuButton.focus();
    }, DRAWER_FADE_MS);
  };

  const handleKeydown = (event: KeyboardEvent) => {
    if (!(drawer instanceof HTMLDivElement) || drawer.hidden) return;

    if (event.key === "Escape") {
      event.preventDefault();
      closeDrawer();
      return;
    }

    if (event.key !== "Tab") return;

    const focusable = getFocusableElements(drawer);
    if (focusable.length === 0) {
      event.preventDefault();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  };

  if (
    menuButton instanceof HTMLButtonElement &&
    drawer instanceof HTMLDivElement
  ) {
    menuButton.addEventListener("click", () => {
      if (drawer.hidden) {
        openDrawer();
      } else {
        closeDrawer();
      }
    });

    closeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", closeDrawer);
    });

    document.addEventListener("keydown", handleKeydown);
  }
</script>
