---
import "../styles/global.css";
import "../styles/base.css";
import Sitemap from "../components/Sitemap.astro";
import ShinwaLogo from "../components/ShinwaLogo.astro";

// Site configuration constants
const SITE_NAME = "サイト名";
const SITE_URL = import.meta.env.SITE_URL || "https://example.com";
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.png`;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  url?: string;
}

const {
  title = SITE_NAME,
  description = "microCMSと連携したAstroベースのウェブサイト",
  image = DEFAULT_OG_IMAGE,
  type = "website",
  url = Astro.url.href,
} = Astro.props;

// Construct full title with site name
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// Ensure canonical URL uses the site URL
const canonicalUrl = url.startsWith("http") ? url : `${SITE_URL}${url}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, user-scalable=no"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo" aria-label="トップページへ戻る"
          >ロゴ</a
        >

        <div class="site-header__controls">
          <nav class="site-header__nav" aria-label="グローバルナビゲーション">
            <ul class="site-header__nav-list">
              <li><a href="/news">お知らせ</a></li>
              <li><a href="/about">私たちについて</a></li>
              <li><a href="/services">仕事内容</a></li>
              <li><a href="/works">施工事例</a></li>
              <li><a href="/recruit">RECRUIT</a></li>
              <li><a href="/contact">お問い合わせ</a></li>
            </ul>
          </nav>

          <button
            type="button"
            class="site-header__menu-button js-menu-toggle"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="global-drawer"
          >
            <span class="site-header__menu-line"></span>
            <span class="site-header__menu-line"></span>
          </button>
        </div>
      </div>
    </header>
    <div id="global-drawer" class="site-drawer" hidden aria-hidden="true">
      <button
        type="button"
        class="site-drawer__backdrop js-drawer-close"
        tabindex="-1"
        aria-hidden="true"></button>

      <div
        class="site-drawer__panel"
        role="dialog"
        aria-modal="true"
        tabindex="-1"
      >
        <div class="site-drawer__inner">
          <div
            class="site-drawer__image u-radius-20 js-bg-image"
            data-bg-url="/images/konkaikoumyouji.webp"
            aria-hidden="true"
          >
          </div>

          <Sitemap variant="drawer" ariaLabel="ドロワーメニュー" />
        </div>
      </div>
    </div>
    <slot />
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__container--1">
          <div class="site-footer__heading-row">
            <h2 class="site-footer__title">伸和建設株式会社</h2>
            <a href="#" class="site-footer__instagram" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1.25"></circle>
              </svg>
            </a>
          </div>

          <hr class="site-footer__separator" />

          <Sitemap variant="footer" ariaLabel="フッターサイトマップ" />
        </div>

        <div class="site-footer__container--2">
          <div
            class="site-footer__image js-bg-image"
            data-bg-url="/images/konkaikoumyouji.webp"
            aria-hidden="true"
          >
          </div>
        </div>

        <div class="site-footer__meta">
          <div class="site-footer__container--3">
            <table class="site-footer__contact-table" aria-label="連絡先">
              <tbody>
                <tr>
                  <th scope="row">Mail</th>
                  <td
                    ><a href="mailto:soumu@sinwakensetu.co.jp"
                      >soumu@sinwakensetu.co.jp</a
                    ></td
                  >
                </tr>
                <tr>
                  <th scope="row">TEL</th>
                  <td><a href="tel:0753110054">075-311-0054</a></td>
                </tr>
                <tr>
                  <th scope="row">FAX</th>
                  <td><a href="tel:0753220152">075-322-0152</a></td>
                </tr>
              </tbody>
            </table>
            <p class="site-footer__address">
              〒615-0007　京都市右京区西院上花田町21
            </p>
          </div>

          <div class="site-footer__container--4">
            <div class="site-footer__brand-logo">
              <ShinwaLogo aria-label="伸和建設株式会社" />
            </div>
          </div>
        </div>
      </div>

      <div class="site-footer__copyright u-full-bleed">
        Copyright(C) SHINWA CONSTRUCTION CO.
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    z-index: 200;
    width: 100%;
    background-color: var(--color-header-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    width: 100%;
    min-height: var(--header-height);
    padding-inline-start: clamp(1rem, 3vw, 1.875rem);
    padding-inline-end: clamp(1rem, 8vw, 7.5rem);
  }

  .site-header__logo {
    width: 18.875rem;
    max-width: 100%;
    height: 3.625rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
    border: 1px solid var(--color-white);
    min-width: 0;
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1em;
    min-width: 0;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1em;
    list-style: none;
    margin-right: 1.5rem;
    min-width: 0;
  }

  .site-header__nav-list a {
    font-family: var(--font-serif);
    color: var(--color-white);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.02em;
    overflow-wrap: break-word;
  }

  .site-header__menu-button {
    width: 2.8125rem;
    height: 2.8125rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--color-white);
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-white);
  }

  .site-header__menu-line {
    display: block;
    width: 1.3rem;
    height: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-normal) var(--easing-default),
      opacity var(--duration-normal) var(--easing-default);
    transform-origin: center;
  }

  .site-header__menu-button.is-open .site-header__menu-line:nth-child(1) {
    transform: translateY(0.3125rem) rotate(45deg);
  }

  .site-header__menu-button.is-open .site-header__menu-line:nth-child(2) {
    transform: translateY(-0.3125rem) rotate(-45deg);
  }

  .site-drawer {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--easing-default);
  }

  .site-drawer.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .site-drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(31 31 31 / 0.55);
  }

  .site-drawer__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-gray-300);
  }

  .site-drawer__inner {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
    padding: 2.5rem clamp(1rem, 3vw, 1.875rem) 3rem clamp(1rem, 8vw, 7.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 700px);
    gap: 2.5rem;
    align-items: stretch;
  }

  .site-drawer__image {
    width: 100%;
    height: 100%;
    min-height: clamp(0, 20vw, 300px);
    border: 1px solid var(--color-gray-400);
    background-color: var(--color-gray-300);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  .site-footer {
    background-color: var(--color-primary-light);
    padding: 3rem 0 0;
  }

  .site-footer__meta {
    display: contents;
  }

  .site-footer__inner {
    width: auto;
    margin-inline: clamp(var(--space-4), 10vw, 9.375rem);
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-areas:
      "container1 container2"
      "container3 container4";
    column-gap: 2.5rem;
    row-gap: 5rem;
    align-items: start;
    padding-bottom: 1.875rem;
  }

  .site-footer__container--1 {
    grid-area: container1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .site-footer__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer__title {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: var(--weight-bold);
    line-height: 1.2;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .site-footer__instagram {
    width: 2.8125rem;
    height: 2.8125rem;
    flex-shrink: 0;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .site-footer__instagram svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .site-footer__separator {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .site-footer__contact-table {
    margin-top: 0;
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    border-collapse: collapse;
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .site-footer__contact-table th,
  .site-footer__contact-table td {
    border: none;
    padding: 0.2rem 0;
    text-align: left;
    vertical-align: top;
    font-weight: var(--weight-normal);
  }

  .site-footer__contact-table td {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .site-footer__contact-table a {
    display: block;
    color: inherit;
    text-decoration: none;
    line-height: 1.2;
    text-align: left;
    overflow-wrap: break-word;
  }

  .site-footer__contact-table th {
    width: 4rem;
  }

  .site-footer__container--2 {
    grid-area: container2;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    min-width: 0;
  }

  .site-footer__image {
    --footer-image-focal-x: 50%;
    --footer-image-focal-y: 50%;
    width: min(100%, 500px);
    max-width: 500px;
    min-width: 0;
    aspect-ratio: 5 / 7;
    height: auto;
    background-repeat: no-repeat;
    background-position: var(--footer-image-focal-x) var(--footer-image-focal-y);
    background-size: cover;
    border-bottom-left-radius: 50%;
    overflow: hidden;
  }

  .site-footer__container--3 {
    grid-area: container3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    align-self: start;
    min-width: 0;
  }

  .site-footer__address {
    margin-top: auto;
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1.5;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  .site-footer__container--4 {
    grid-area: container4;
    justify-self: end;
    align-self: end;
    min-width: 0;
  }

  .site-footer__brand-logo :global(svg) {
    width: 136px;
    height: auto;
  }

  @supports not (aspect-ratio: 1) {
    .site-footer__brand-logo {
      height: 134px;
    }
  }

  :global(body.is-drawer-open) {
    overflow: hidden;
  }

  .site-footer__copyright {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    text-align: center;
    overflow-wrap: break-word;
  }

  @media (min-width: 1441px) {
    .site-footer {
      max-width: 1440px;
      margin-inline: auto;
    }
  }

  @media (max-width: 1440px) {
    .site-header__inner {
      padding-inline-start: 1rem;
      padding-inline-end: 1rem;
    }

    .site-header__logo {
      width: clamp(10rem, 20vw, 18.875rem);
    }

    .site-header__nav-list {
      gap: 0.75em;
    }

    .site-footer {
      padding: 2rem 0 0;
    }

    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "container1 container1"
        "meta container2";
      gap: 1.5rem;
      align-items: start;
    }

    .site-footer__meta {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      grid-area: meta;
      align-self: start;
      min-width: 0;
    }

    .site-footer__image {
      width: min(100%, 26rem);
      aspect-ratio: 1 / 1;
      height: auto;
    }

    .site-footer__container--3 {
      gap: 1rem;
      align-self: start;
    }

    .site-footer__container--4 {
      justify-self: auto;
      align-self: flex-start;
    }
  }

  @media (max-width: 1024px) {
    .site-header__nav {
      display: none;
    }

    .site-drawer__inner {
      grid-template-columns: 1fr;
      padding: 1.5rem 1.5rem 2rem;
      align-items: start;
    }

    .site-drawer__image {
      width: 100%;
      height: min(41.625rem, 30vh);
    }

    .site-footer__contact-table th {
      width: 3.25rem;
    }
  }

  @media (max-width: 320px) {
    .site-drawer__inner {
      padding: 1.5rem 0 0;
    }
  }

  @media (max-width: 768px) {
    .site-footer__container--3 {
      align-self: start;
    }

    .site-footer__brand-logo :global(svg) {
      width: clamp(88px, 24vw, 104px);
    }
  }

  @media (max-width: 425px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "container1"
        "container2"
        "meta";
    }

    .site-footer__container--3 {
      align-self: start;
    }

    .site-footer__contact-table {
      font-size: 1.125rem;
    }

    .site-footer__address {
      font-size: 1.125rem;
    }

    .site-footer__image {
      height: auto;
      min-height: 0;
      aspect-ratio: 5 / 7;
    }
  }
</style>

<script>
  // data-bg-url 属性で指定された背景画像を JS 経由でセット。
  // style 属性に直接展開すると CSP の style-src に抵触するため、
  // JS の DOM プロパティ経由で設定することで unsafe-inline を不要にする。
  document.querySelectorAll<HTMLElement>(".js-bg-image").forEach((el) => {
    const url = el.dataset.bgUrl;
    if (url) el.style.backgroundImage = `url(${url})`;
  });

  const menuButton = document.querySelector(".js-menu-toggle");
  const drawer = document.getElementById("global-drawer");
  const closeTriggers =
    document.querySelectorAll<HTMLElement>(".js-drawer-close");
  const DRAWER_FADE_MS = 250;

  const getFocusableElements = (container: ParentNode): HTMLElement[] => {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((element) => !element.hasAttribute("hidden"));
  };

  const openDrawer = () => {
    if (
      !(menuButton instanceof HTMLButtonElement) ||
      !(drawer instanceof HTMLDivElement)
    )
      return;

    menuButton.classList.add("is-open");
    menuButton.setAttribute("aria-expanded", "true");
    menuButton.setAttribute("aria-label", "メニューを閉じる");
    drawer.hidden = false;
    drawer.setAttribute("aria-hidden", "false");
    document.body.classList.add("is-drawer-open");
    requestAnimationFrame(() => {
      drawer.classList.add("is-visible");
    });

    const focusable = getFocusableElements(drawer);
    if (focusable.length > 0) {
      focusable[0].focus();
    }
  };

  const closeDrawer = () => {
    if (
      !(menuButton instanceof HTMLButtonElement) ||
      !(drawer instanceof HTMLDivElement)
    )
      return;
    if (drawer.hidden) return;

    menuButton.classList.remove("is-open");
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "メニューを開く");
    drawer.classList.remove("is-visible");
    drawer.setAttribute("aria-hidden", "true");
    document.body.classList.remove("is-drawer-open");

    window.setTimeout(() => {
      drawer.hidden = true;
      menuButton.focus();
    }, DRAWER_FADE_MS);
  };

  const handleKeydown = (event: KeyboardEvent) => {
    if (!(drawer instanceof HTMLDivElement) || drawer.hidden) return;
    if (!(menuButton instanceof HTMLButtonElement)) return;

    if (event.key === "Escape") {
      event.preventDefault();
      closeDrawer();
      return;
    }

    if (event.key !== "Tab") return;

    // ハンバーガーボタンをトラップ先頭に加え、ドロワー内要素と一続きのサイクルにする。
    // 中間遷移はブラウザのデフォルト Tab 順（DOM 順）で処理されるため、
    // 折り返しの2ケースだけを明示的に制御すれば十分。
    const focusable = [menuButton, ...getFocusableElements(drawer)];
    if (focusable.length === 0) {
      event.preventDefault();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      // Shift+Tab on ハンバーガー → ドロワー末尾へ折り返し
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      // Tab on ドロワー末尾 → ハンバーガーへ折り返し
      event.preventDefault();
      first.focus();
    }
  };

  if (
    menuButton instanceof HTMLButtonElement &&
    drawer instanceof HTMLDivElement
  ) {
    menuButton.addEventListener("click", () => {
      if (drawer.hidden) {
        openDrawer();
      } else {
        closeDrawer();
      }
    });

    closeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", closeDrawer);
    });

    document.addEventListener("keydown", handleKeydown);
  }
</script>
